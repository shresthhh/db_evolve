+//! Get the string buffer to decompress into. When the result vector starts out without a string heap, reuse the
+//! heap cached in the column scan state if nothing else references it anymore: this avoids re-growing a fresh
+//! arena (several mallocs of cold memory) for every vector.
+static VectorStringBuffer &GetDecompressStringBuffer(ColumnScanState &state, Vector &result, idx_t result_offset) {
+	if (result_offset == 0 && !result.GetAuxiliary() && result.GetVectorType() == VectorType::FLAT_VECTOR) {
+		auto &cached = state.cached_string_buffer;
+		if (cached && cached.use_count() == 1) {
+			cached->Cast<VectorStringBuffer>().ResetForReuse();
+		} else {
+			auto vector_buffer = result.GetBuffer();
+			auto stored_allocator = vector_buffer ? vector_buffer->GetAllocator() : nullptr;
+			if (stored_allocator) {
+				cached = make_buffer<VectorStringBuffer>(*stored_allocator);
+			} else {
+				cached = make_buffer<VectorStringBuffer>();
+			}
+		}
+		result.SetAuxiliary(cached);
+	}
+	return StringVector::GetStringBuffer(result);
+}
