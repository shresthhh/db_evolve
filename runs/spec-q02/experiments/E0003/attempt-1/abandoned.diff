+	//! Scans the next chunk of the current morsel into output. Sparse chunks (e.g., produced by selective filters)
+	//! are compacted into fuller chunks, without ever crossing the morsel boundary (to preserve batch indexes).
+	//! Returns false if the morsel is exhausted and no rows were produced.
+	bool ScanCompacted(ClientContext &context, TableScanLocalState &l_state, DataChunk &output) {
+		static constexpr idx_t SPARSE_CHUNK_THRESHOLD = STANDARD_VECTOR_SIZE / 8;
+		static constexpr idx_t COMPACT_TARGET = STANDARD_VECTOR_SIZE / 2;
+		auto &buffer = l_state.compact_buffer;
+		idx_t buffered = 0;
+		while (true) {
+			ScanChunk(l_state, output);
+			const idx_t count = output.size();
+			if (count == 0) {
+				if (buffered == 0) {
+					return false;
+				}
+				// the morsel is exhausted: emit what we have buffered
+				l_state.morsel_exhausted = true;
+				break;
+			}
+			if (buffered == 0) {
+				if (count >= SPARSE_CHUNK_THRESHOLD) {
+					// fast path: the chunk is full enough
+					return true;
+				}
+				// start compacting
+				if (buffer.ColumnCount() == 0) {
+					buffer.Initialize(context, output.GetTypes());
+				} else {
+					buffer.Reset();
+				}
+				l_state.partition_override = GetPartitionIndex(l_state);
+			}
+			if (buffered + count > STANDARD_VECTOR_SIZE) {
+				// does not fit: stash the chunk and emit it during the next call
+				auto &pending = l_state.compact_pending;
+				if (pending.ColumnCount() == 0) {
+					pending.Initialize(context, output.GetTypes());
+				} else {
+					pending.Reset();
+				}
+				pending.Append(output);
+				l_state.emit_pending = true;
+				break;
+			}
+			buffer.Append(output);
+			buffered = buffer.size();
+			output.Reset();
+			if (buffered >= COMPACT_TARGET) {
+				break;
+			}
+		}
+		D_ASSERT(buffered > 0);
+		output.Reference(buffer);
+		l_state.has_partition_override = true;
+		return true;
+	}
