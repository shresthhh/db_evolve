+template <class T>
+static idx_t TemplatedInFilterSelection(UnifiedVectorFormat &vdata, const vector<Value> &values, SelectionVector &sel,
+                                        idx_t &approved_tuple_count) {
+	// materialize the (small) IN-list as typed constants once per call
+	vector<T> constants;
+	constants.reserve(values.size());
+	for (auto &value : values) {
+		constants.push_back(value.GetValueUnsafe<T>());
+	}
+	auto &mask = vdata.validity;
+	auto vec = UnifiedVectorFormat::GetData<T>(vdata);
+	const bool all_valid = mask.AllValid();
+	const idx_t constant_count = constants.size();
+	SelectionVector result_sel(approved_tuple_count);
+	idx_t result_count = 0;
+	for (idx_t i = 0; i < approved_tuple_count; i++) {
+		auto idx = sel.get_index(i);
+		auto vector_idx = vdata.sel->get_index(idx);
+		if (!all_valid && !mask.RowIsValid(vector_idx)) {
+			continue;
+		}
+		bool found = false;
+		for (idx_t k = 0; k < constant_count; k++) {
+			found = found || Equals::Operation(vec[vector_idx], constants[k]);
+		}
+		result_sel.set_index(result_count, idx);
+		result_count += found;
+	}
+	sel.Initialize(result_sel);
+	approved_tuple_count = result_count;
+	return result_count;
+}
+
+static idx_t InFilterSelection(SelectionVector &sel, const LogicalType &type, UnifiedVectorFormat &vdata,
+                               const InFilter &in_filter, idx_t &approved_tuple_count) {
+	// make sure all IN-list values have exactly the type of the vector
+	const vector<Value> *values = &in_filter.values;
+	vector<Value> cast_values;
+	for (auto &value : in_filter.values) {
+		if (value.type() != type) {
+			for (auto &v : in_filter.values) {
+				cast_values.push_back(v.DefaultCastAs(type));
+			}
+			values = &cast_values;
+			break;
+		}
+	}
+	switch (type.InternalType()) {
+	case PhysicalType::UINT8:
+		return TemplatedInFilterSelection<uint8_t>(vdata, *values, sel, approved_tuple_count);
+	case PhysicalType::UINT16:
+		return TemplatedInFilterSelection<uint16_t>(vdata, *values, sel, approved_tuple_count);
+	case PhysicalType::UINT32:
+		return TemplatedInFilterSelection<uint32_t>(vdata, *values, sel, approved_tuple_count);
+	case PhysicalType::UINT64:
+		return TemplatedInFilterSelection<uint64_t>(vdata, *values, sel, approved_tuple_count);
+	case PhysicalType::INT8:
+		return TemplatedInFilterSelection<int8_t>(vdata, *values, sel, approved_tuple_count);
+	case PhysicalType::INT16:
+		return TemplatedInFilterSelection<int16_t>(vdata, *values, sel, approved_tuple_count);
+	case PhysicalType::INT32:
+		return TemplatedInFilterSelection<int32_t>(vdata, *values, sel, approved_tuple_count);
+	case PhysicalType::INT64:
+		return TemplatedInFilterSelection<int64_t>(vdata, *values, sel, approved_tuple_count);
+	case PhysicalType::INT128:
+		return TemplatedInFilterSelection<hugeint_t>(vdata, *values, sel, approved_tuple_count);
+	case PhysicalType::UINT128:
+		return TemplatedInFilterSelection<uhugeint_t>(vdata, *values, sel, approved_tuple_count);
+	case PhysicalType::FLOAT:
+		return TemplatedInFilterSelection<float>(vdata, *values, sel, approved_tuple_count);
+	case PhysicalType::DOUBLE:
+		return TemplatedInFilterSelection<double>(vdata, *values, sel, approved_tuple_count);
+	case PhysicalType::VARCHAR:
+		return TemplatedInFilterSelection<string_t>(vdata, *values, sel, approved_tuple_count);
+	default:
+		throw InvalidTypeException(type, "Invalid type for IN filter pushed down to table");
+	}
+}
