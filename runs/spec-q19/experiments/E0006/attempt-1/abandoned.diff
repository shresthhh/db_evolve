+//! Returns true if the filter can never remove rows by itself, i.e. it is a plain (zonemap-only) optional filter or
+//! a conjunction AND made up exclusively of such filters. Selectivity optional filters do remove rows.
+static bool IsZonemapOnlyFilter(const TableFilter &filter) {
+	switch (filter.filter_type) {
+	case TableFilterType::OPTIONAL_FILTER:
+		return !dynamic_cast<const SelectivityOptionalFilter *>(&filter);
+	case TableFilterType::CONJUNCTION_AND: {
+		auto &conj = filter.Cast<ConjunctionAndFilter>();
+		if (conj.child_filters.empty()) {
+			return false;
+		}
+		for (auto &child : conj.child_filters) {
+			if (!IsZonemapOnlyFilter(*child)) {
+				return false;
+			}
+		}
+		return true;
+	}
+	default:
+		return false;
+	}
+}
