+template <class T>
+void BitpackingScanPartial(ColumnSegment &segment, ColumnScanState &state, idx_t scan_count, Vector &result,
+                           idx_t result_offset) {
+	auto &scan_state = state.scan_state->Cast<BitpackingScanState<T>>();
+	T *result_data = FlatVector::GetData<T>(result);
+	result.SetVectorType(VectorType::FLAT_VECTOR);
+	BitpackingScanToBuffer<T>(scan_state, scan_count, result_data, result_offset);
+}
+
+//! Select: decompress the full vector into a scratch buffer, then gather the selected rows into a flat result
+template <class T>
+void BitpackingSelect(ColumnSegment &segment, ColumnScanState &state, idx_t vector_count, Vector &result,
+                      const SelectionVector &sel, idx_t sel_count) {
+	auto &scan_state = state.scan_state->Cast<BitpackingScanState<T>>();
+	D_ASSERT(vector_count <= STANDARD_VECTOR_SIZE);
+	if (!scan_state.select_buffer) {
+		scan_state.select_buffer = make_unsafe_uniq_array_uninitialized<T>(STANDARD_VECTOR_SIZE);
+	}
+	T *scratch = scan_state.select_buffer.get();
+	BitpackingScanToBuffer<T>(scan_state, vector_count, scratch, 0);
+
+	T *result_data = FlatVector::GetData<T>(result);
+	result.SetVectorType(VectorType::FLAT_VECTOR);
+	for (idx_t i = 0; i < sel_count; i++) {
+		result_data[i] = scratch[sel.get_index(i)];
+	}
+}
+
 template <class T>
 void BitpackingScan(ColumnSegment &segment, ColumnScanState &state, idx_t scan_count, Vector &result) {
