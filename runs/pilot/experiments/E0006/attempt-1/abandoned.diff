+template <class T>
+static bool AdjacentValuesEqual(const T &a, const T &b) {
+	// Bitwise comparison: only claims equality when values are identical, which implies group equality
+	return memcmp(&a, &b, sizeof(T)) == 0;
+}
+
+template <>
+bool AdjacentValuesEqual(const string_t &a, const string_t &b) {
+	return a == b;
+}
+
+//! Keeps the candidate rows (row r, compared to row r - 1) for which the group column values are equal
+template <class T>
+static idx_t FilterAdjacentEqual(const UnifiedVectorFormat &format, SelectionVector &candidates,
+                                 const idx_t candidate_count) {
+	const auto data = UnifiedVectorFormat::GetData<T>(format);
+	const auto &sel = *format.sel;
+	const auto &validity = format.validity;
+	idx_t result_count = 0;
+	if (validity.AllValid()) {
+		for (idx_t i = 0; i < candidate_count; i++) {
+			const auto r = candidates.get_index_unsafe(i);
+			const auto idx_cur = sel.get_index(r);
+			const auto idx_prev = sel.get_index(r - 1);
+			candidates.set_index(result_count, r);
+			result_count += AdjacentValuesEqual<T>(data[idx_cur], data[idx_prev]);
+		}
+	} else {
+		for (idx_t i = 0; i < candidate_count; i++) {
+			const auto r = candidates.get_index_unsafe(i);
+			const auto idx_cur = sel.get_index(r);
+			const auto idx_prev = sel.get_index(r - 1);
+			const auto valid_cur = validity.RowIsValid(idx_cur);
+			const auto valid_prev = validity.RowIsValid(idx_prev);
+			bool equal;
+			if (valid_cur != valid_prev) {
+				equal = false;
+			} else if (!valid_cur) {
+				equal = true; // both NULL
+			} else {
+				equal = AdjacentValuesEqual<T>(data[idx_cur], data[idx_prev]);
+			}
+			candidates.set_index(result_count, r);
+			result_count += equal;
+		}
+	}
+	return result_count;
+}
+
+//! Finds rows whose group equals the group of the previous row ("duplicates"), stored in ascending order in
+//! "duplicates". Returns the number of duplicates, or DConstants::INVALID_INDEX if the group types are not supported
+static idx_t FindAdjacentDuplicateGroups(const vector<LogicalType> &group_types,
+                                         const vector<TupleDataVectorFormat> &vector_data, const hash_t *hashes,
+                                         const idx_t count, SelectionVector &duplicates) {
+	for (auto &type : group_types) {
+		switch (type.InternalType()) {
+		case PhysicalType::BOOL:
+		case PhysicalType::INT8:
+		case PhysicalType::INT16:
+		case PhysicalType::INT32:
+		case PhysicalType::INT64:
+		case PhysicalType::INT128:
+		case PhysicalType::UINT8:
+		case PhysicalType::UINT16:
+		case PhysicalType::UINT32:
+		case PhysicalType::UINT64:
+		case PhysicalType::UINT128:
+		case PhysicalType::FLOAT:
+		case PhysicalType::DOUBLE:
+		case PhysicalType::INTERVAL:
+		case PhysicalType::VARCHAR:
+			break;
+		default:
+			return DConstants::INVALID_INDEX;
+		}
+	}
+
+	// Candidates: rows with the same hash as the previous row
+	idx_t dup_count = 0;
+	for (idx_t r = 1; r < count; r++) {
+		duplicates.set_index(dup_count, r);
+		dup_count += hashes[r] == hashes[r - 1];
+	}
+
+	for (idx_t col_idx = 0; col_idx < group_types.size() && dup_count != 0; col_idx++) {
+		const auto &format = vector_data[col_idx].unified;
+		switch (group_types[col_idx].InternalType()) {
+		case PhysicalType::BOOL:
+		case PhysicalType::INT8:
+			dup_count = FilterAdjacentEqual<int8_t>(format, duplicates, dup_count);
+			break;
+		case PhysicalType::INT16:
+			dup_count = FilterAdjacentEqual<int16_t>(format, duplicates, dup_count);
+			break;
+		case PhysicalType::INT32:
+			dup_count = FilterAdjacentEqual<int32_t>(format, duplicates, dup_count);
+			break;
+		case PhysicalType::INT64:
+			dup_count = FilterAdjacentEqual<int64_t>(format, duplicates, dup_count);
+			break;
+		case PhysicalType::INT128:
+			dup_count = FilterAdjacentEqual<hugeint_t>(format, duplicates, dup_count);
+			break;
+		case PhysicalType::UINT8:
+			dup_count = FilterAdjacentEqual<uint8_t>(format, duplicates, dup_count);
+			break;
+		case PhysicalType::UINT16:
+			dup_count = FilterAdjacentEqual<uint16_t>(format, duplicates, dup_count);
+			break;
+		case PhysicalType::UINT32:
+			dup_count = FilterAdjacentEqual<uint32_t>(format, duplicates, dup_count);
+			break;
+		case PhysicalType::UINT64:
+			dup_count = FilterAdjacentEqual<uint64_t>(format, duplicates, dup_count);
+			break;
+		case PhysicalType::UINT128:
+			dup_count = FilterAdjacentEqual<uhugeint_t>(format, duplicates, dup_count);
+			break;
+		case PhysicalType::FLOAT:
+			dup_count = FilterAdjacentEqual<float>(format, duplicates, dup_count);
+			break;
+		case PhysicalType::DOUBLE:
+			dup_count = FilterAdjacentEqual<double>(format, duplicates, dup_count);
+			break;
+		case PhysicalType::INTERVAL:
+			dup_count = FilterAdjacentEqual<interval_t>(format, duplicates, dup_count);
+			break;
+		case PhysicalType::VARCHAR:
+			dup_count = FilterAdjacentEqual<string_t>(format, duplicates, dup_count);
+			break;
+		default:
+			throw InternalException("Unsupported type in FindAdjacentDuplicateGroups");
+		}
+	}
+	return dup_count;
+}
