+template <class T>
+static FilterPropagateResult TemplatedCheckStatisticsExact(const BloomFilter &bf, const BaseStatistics &stats,
+                                                           bool filters_nulls) {
+	{
+		if (!NumericStats::HasMinMax(stats) || (!filters_nulls && stats.CanHaveNull())) {
+			return FilterPropagateResult::NO_PRUNING_POSSIBLE;
+		}
+		const auto min = static_cast<int64_t>(NumericStats::GetMin<T>(stats));
+		const auto max = static_cast<int64_t>(NumericStats::GetMax<T>(stats));
+		if (min > max) {
+			return FilterPropagateResult::NO_PRUNING_POSSIBLE; // Invalid stats
+		}
+		// the exact bitmap covers [key_min, key_max]: no overlap with the stats range means no match
+		const auto key_min = bf.GetKeyMin();
+		const auto key_max = static_cast<int64_t>(static_cast<uint64_t>(key_min) + bf.GetKeyRange());
+		if (max < key_min || min > key_max) {
+			return FilterPropagateResult::FILTER_ALWAYS_FALSE;
+		}
+		const auto range = static_cast<uint64_t>(max) - static_cast<uint64_t>(min);
+		if (range > 2048) {
+			return FilterPropagateResult::NO_PRUNING_POSSIBLE;
+		}
+		idx_t hits = 0;
+		for (uint64_t i = 0; i <= range; i++) {
+			hits += bf.LookupKey(static_cast<int64_t>(static_cast<uint64_t>(min) + i));
+		}
+		if (hits == 0) {
+			return FilterPropagateResult::FILTER_ALWAYS_FALSE;
+		}
+		if (hits == range + 1) {
+			return FilterPropagateResult::FILTER_ALWAYS_TRUE;
+		}
+		return FilterPropagateResult::NO_PRUNING_POSSIBLE;
+	}
+}
