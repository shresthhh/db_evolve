+void BloomFilter::InsertKeys(Vector &keys_v, idx_t count) const {
+	D_ASSERT(initialized && exact);
+	UnifiedVectorFormat vdata;
+	keys_v.ToUnifiedFormat(count, vdata);
+	switch (keys_v.GetType().InternalType()) {
+	case PhysicalType::INT8:
+		return TemplatedInsertKeys<int8_t>(bf, vdata, count, key_min, key_range);
+	case PhysicalType::INT16:
+		return TemplatedInsertKeys<int16_t>(bf, vdata, count, key_min, key_range);
+	case PhysicalType::INT32:
+		return TemplatedInsertKeys<int32_t>(bf, vdata, count, key_min, key_range);
+	case PhysicalType::INT64:
+		return TemplatedInsertKeys<int64_t>(bf, vdata, count, key_min, key_range);
+	case PhysicalType::UINT8:
+		return TemplatedInsertKeys<uint8_t>(bf, vdata, count, key_min, key_range);
+	case PhysicalType::UINT16:
+		return TemplatedInsertKeys<uint16_t>(bf, vdata, count, key_min, key_range);
+	case PhysicalType::UINT32:
+		return TemplatedInsertKeys<uint32_t>(bf, vdata, count, key_min, key_range);
+	default:
+		throw InternalException("BloomFilter: unsupported type for exact key mode");
+	}
+}
