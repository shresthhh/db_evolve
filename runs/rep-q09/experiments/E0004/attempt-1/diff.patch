+template <class T>
+static idx_t TemplatedLookupKeys(const BloomFilter &filter, const UnifiedVectorFormat &vdata, const SelectionVector &sel,
+                                 idx_t count, bool filters_nulls, SelectionVector &result_sel) {
+	const auto data = UnifiedVectorFormat::GetData<T>(vdata);
+	idx_t found_count = 0;
+	if (vdata.validity.AllValid()) {
+		for (idx_t i = 0; i < count; i++) {
+			const auto idx = vdata.sel->get_index(sel.get_index(i));
+			result_sel.set_index(found_count, i);
+			found_count += filter.LookupKey(static_cast<int64_t>(data[idx]));
+		}
+	} else {
+		for (idx_t i = 0; i < count; i++) {
+			const auto idx = vdata.sel->get_index(sel.get_index(i));
+			result_sel.set_index(found_count, i);
+			if (vdata.validity.RowIsValid(idx)) {
+				found_count += filter.LookupKey(static_cast<int64_t>(data[idx]));
+			} else {
+				found_count += !filters_nulls;
+			}
+		}
+	}
+	return found_count;
+}
