+template <class T>
+static void TemplatedInsertKeys(uint64_t *bf, const UnifiedVectorFormat &vdata, idx_t count, int64_t key_min,
+                                uint64_t key_range) {
+	const auto data = UnifiedVectorFormat::GetData<T>(vdata);
+	for (idx_t i = 0; i < count; i++) {
+		const auto idx = vdata.sel->get_index(i);
+		if (!vdata.validity.RowIsValid(idx)) {
+			continue;
+		}
+		const auto offset = static_cast<uint64_t>(static_cast<int64_t>(data[idx])) - static_cast<uint64_t>(key_min);
+		if (offset > key_range) {
+			throw InternalException("BloomFilter: exact key out of range");
+		}
+		auto &slot = *reinterpret_cast<std::atomic<uint64_t> *>(&bf[offset >> LOG_SECTOR_SIZE]);
+		const uint64_t mask = 1ULL << (offset & 63);
+		if (!(slot.load(std::memory_order_relaxed) & mask)) {
+			slot.fetch_or(mask, std::memory_order_relaxed);
+		}
+	}
+}
