+//! If the build keys are integers in a dense range [min, max], the join BF can be an exact bitmap indexed by
+//! (key - min): no hashing, no false positives, and typically a smaller footprint than the hashed filter
+static void TrySetExactBloomFilterRange(JoinHashTable &ht, const LogicalType &probe_type, const Value &min_val,
+                                        const Value &max_val) {
+	static constexpr uint64_t MAX_EXACT_BITS_PER_KEY = 128;
+	static constexpr uint64_t MAX_EXACT_RANGE = (1ULL << 31);
+	auto &bf = ht.GetBloomFilter();
+	if (bf.IsInitialized() || bf.IsExact() || min_val.IsNull() || max_val.IsNull()) {
+		return;
+	}
+	const auto &build_type = ht.layout_ptr->GetTypes()[0];
+	if (build_type.InternalType() != probe_type.InternalType() || min_val.type() != build_type ||
+	    max_val.type() != build_type) {
+		return;
+	}
+	int64_t min;
+	int64_t max;
+	if (!GetExactBloomFilterKey(min_val, min) || !GetExactBloomFilterKey(max_val, max) || min > max) {
+		return;
+	}
+	const auto range = static_cast<uint64_t>(max) - static_cast<uint64_t>(min);
+	if (range >= MAX_EXACT_RANGE || range / MAX_EXACT_BITS_PER_KEY >= ht.Count()) {
+		return;
+	}
+	bf.SetKeyRange(min, range);
+}
