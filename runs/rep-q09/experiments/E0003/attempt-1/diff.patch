+//! Translates a join key value "storage_value - offset" back into the storage value domain
+static bool ApplyJoinFilterOffset(Value &val, const JoinFilterPushdownColumn &column) {
+	if (val.IsNull()) {
+		return true;
+	}
+	if (!val.DefaultTryCastAs(LogicalType::HUGEINT)) {
+		return false;
+	}
+	auto storage_val = Value::HUGEINT(val.GetValue<hugeint_t>() + hugeint_t(column.offset.GetValue<int64_t>()));
+	if (!storage_val.DefaultTryCastAs(column.storage_type)) {
+		return false;
+	}
+	val = std::move(storage_val);
+	return true;
+}
+
+//! Whether a bloom filter on join keys "storage_value - offset" can be probed with the storage values
+static bool BloomFilterSupportsOffset(const LogicalType &key_type, const LogicalType &storage_type) {
+	if (!key_type.IsIntegral() || !storage_type.IsIntegral()) {
+		return false;
+	}
+	return GetTypeIdSize(key_type.InternalType()) <= GetTypeIdSize(PhysicalType::INT64) &&
+	       GetTypeIdSize(storage_type.InternalType()) <= GetTypeIdSize(PhysicalType::INT64) &&
+	       storage_type.InternalType() != PhysicalType::UINT64;
+}
