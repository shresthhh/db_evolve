+static uint64_t KeyOffsetMask(const LogicalType &key_type) {
+	const auto key_width = GetTypeIdSize(key_type.InternalType());
+	return key_width < sizeof(uint64_t) ? (1ULL << (key_width * 8)) - 1 : ~0ULL;
+}
+
+uint64_t BFTableFilter::ApplyKeyOffset(const int64_t value) const {
+	// mirrors the integral compression: (value - offset) truncated to the width of the key type
+	return (static_cast<uint64_t>(value) - static_cast<uint64_t>(key_offset)) & KeyOffsetMask(key_type);
+}
+
+template <class T>
+static void TemplatedApplyKeyOffset(const UnifiedVectorFormat &vdata, Vector &result, const idx_t count,
+                                    const uint64_t offset, const uint64_t mask) {
+	const auto data = UnifiedVectorFormat::GetData<T>(vdata);
+	auto result_data = FlatVector::GetData<uint64_t>(result);
+	auto &result_validity = FlatVector::Validity(result);
+	for (idx_t i = 0; i < count; i++) {
+		const auto idx = vdata.sel->get_index(i);
+		if (!vdata.validity.RowIsValid(idx)) {
+			result_validity.SetInvalid(i);
+			result_data[i] = 0;
+			continue;
+		}
+		result_data[i] = (static_cast<uint64_t>(static_cast<int64_t>(data[idx])) - offset) & mask;
+	}
+}
