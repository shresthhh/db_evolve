+void BFTableFilter::HashWithOffset(Vector &keys_v, const SelectionVector &sel, const idx_t approved_count,
+                                   BFTableFilterState &state) const {
+	UnifiedVectorFormat vdata;
+	if (sel.IsSet()) {
+		Vector sliced(keys_v, sel, approved_count);
+		sliced.ToUnifiedFormat(approved_count, vdata);
+	} else {
+		keys_v.ToUnifiedFormat(approved_count, vdata);
+	}
+	// the (UBIGINT) found_v vector is used as scratch space for the translated keys
+	auto &offset_keys = state.found_v;
+	offset_keys.SetVectorType(VectorType::FLAT_VECTOR);
+	FlatVector::Validity(offset_keys).Reset(approved_count);
+	const auto offset = static_cast<uint64_t>(key_offset);
+	const auto mask = KeyOffsetMask(key_type);
+	switch (keys_v.GetType().InternalType()) {
+	case PhysicalType::INT8:
+		TemplatedApplyKeyOffset<int8_t>(vdata, offset_keys, approved_count, offset, mask);
+		break;
+	case PhysicalType::INT16:
+		TemplatedApplyKeyOffset<int16_t>(vdata, offset_keys, approved_count, offset, mask);
+		break;
+	case PhysicalType::INT32:
+		TemplatedApplyKeyOffset<int32_t>(vdata, offset_keys, approved_count, offset, mask);
+		break;
+	case PhysicalType::INT64:
+		TemplatedApplyKeyOffset<int64_t>(vdata, offset_keys, approved_count, offset, mask);
+		break;
+	case PhysicalType::UINT8:
+		TemplatedApplyKeyOffset<uint8_t>(vdata, offset_keys, approved_count, offset, mask);
+		break;
+	case PhysicalType::UINT16:
+		TemplatedApplyKeyOffset<uint16_t>(vdata, offset_keys, approved_count, offset, mask);
+		break;
+	case PhysicalType::UINT32:
+		TemplatedApplyKeyOffset<uint32_t>(vdata, offset_keys, approved_count, offset, mask);
+		break;
+	default:
+		throw InternalException("Unsupported type for bloom filter with key offset");
+	}
+	VectorOperations::Hash(offset_keys, state.hashes_v, approved_count);
+}
