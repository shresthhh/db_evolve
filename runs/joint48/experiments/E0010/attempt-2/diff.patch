+void RadixPartitionedHashTable::EnablePartitionPrefix(GlobalSinkState &sink_p, idx_t estimated_input_count) const {
+	auto &sink = sink_p.Cast<RadixHTGlobalSinkState>();
+	if (partition_prefix_count == 0) {
+		return;
+	}
+	// Partitioning on the prefix concentrates skewed prefixes in fewer partitions,
+	// so only do this if the input is estimated to comfortably fit in memory
+	static constexpr idx_t MEMORY_FRACTION = 16;
+	const auto row_size = GetLayout().GetRowWidth() + 2 * sizeof(ht_entry_t);
+	const auto max_count = sink.memory_limit / MEMORY_FRACTION / row_size;
+	sink.use_partition_prefix = estimated_input_count <= max_count;
+}
