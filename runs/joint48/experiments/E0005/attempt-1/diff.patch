+//! The HT hash combines all equality keys, but the bloom filter is only on the first key:
+//! gather the first key column and hash it on its own (matching the probe-side hashing)
+static void InsertFirstKeyIntoBloomFilter(const TupleDataCollection &data_collection, const LogicalType &key_type,
+                                          const BloomFilter &bloom_filter, TupleDataChunkState &chunk_state,
+                                          const idx_t count) {
+	Vector key0(key_type, count);
+	data_collection.Gather(chunk_state.row_locations, *FlatVector::IncrementalSelectionVector(), count, 0, key0,
+	                       *FlatVector::IncrementalSelectionVector(), nullptr);
+	Vector key0_hashes(LogicalType::HASH, count);
+	VectorOperations::Hash(key0, key0_hashes, count);
+	bloom_filter.InsertHashes(key0_hashes, count);
+}
