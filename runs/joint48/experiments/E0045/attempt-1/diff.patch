-//! start of the last run (first_end == count if all keys are equal)
+//! Branch-free single pass over the keys: records the start of every run of equal keys in heads (heads[0] == 0) and the
+//! run index of every row in run_ids, and returns whether the keys are non-decreasing. Runs are often short, so
+//! branching on key changes would mispredict on most rows
+template <class T, bool HAS_SEL>
+static bool FindRunsInternal(const T *__restrict data, const SelectionVector &sel, const idx_t count,
+                             sel_t *__restrict heads, sel_t *__restrict run_ids, idx_t &run_count, T &last) {
+	T prev = data[HAS_SEL ? sel.get_index(0) : 0];
+	heads[0] = 0;
+	run_ids[0] = 0;
+	idx_t n = 1;
+	bool decreasing = false;
+	for (idx_t i = 1; i < count; i++) {
+		const T cur = data[HAS_SEL ? sel.get_index(i) : i];
+		// Writes the candidate head at n, which is only kept (n advances) if the key changes
+		heads[n] = UnsafeNumericCast<sel_t>(i);
+		n += cur != prev;
+		decreasing |= cur < prev;
+		run_ids[i] = UnsafeNumericCast<sel_t>(n - 1);
+		prev = cur;
+	}
+	run_count = n;
+	last = prev;
+	return !decreasing;
+}
