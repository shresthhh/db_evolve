+	const auto group_cols = layout.ColumnCount() - 1;
+	if (scan_status == RadixHTScanStatus::INIT) {
+		if (runs_scan_chunk.ColumnCount() == 0) {
+			runs.InitializeScanChunk(runs_scan_chunk);
+			runs_result.Initialize(BufferAllocator::Get(gstate.context), scan_chunk.GetTypes());
+		}
+		runs.InitializeScan(runs_scan_state);
+		scan_status = RadixHTScanStatus::IN_PROGRESS;
+	}
+
+	if (!runs.Scan(runs_scan_state, runs_scan_chunk)) {
+		if (sink.scan_pin_properties == TupleDataPinProperties::DESTROY_AFTER_DONE) {
+			runs.Reset();
+		}
+		ScanDone(sink, gstate);
+		return;
+	}
+
+	// Group values come from the run store, aggregates are finalized from the run states (no destructors)
+	const auto count = runs_scan_chunk.size();
+	runs_result.Reset();
+	for (idx_t c = 0; c < group_cols; c++) {
+		runs_result.data[c].Reference(runs_scan_chunk.data[c]);
+	}
+	runs_result.SetCardinality(count);
+	auto &row_column = runs_scan_chunk.data[group_cols];
+	row_column.Flatten(count);
+	Vector rows(LogicalType::POINTER, data_ptr_cast(FlatVector::GetData<uint64_t>(row_column)));
+	RowOperations::FinalizeStates(row_state, layout, rows, runs_result, group_cols);
+
+	Output(sink.radix_ht, runs_result, chunk);
+}
