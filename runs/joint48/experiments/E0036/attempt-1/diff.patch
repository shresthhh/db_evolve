+//! Finds the starts of the runs of equal keys in [begin, end) of a sorted, non-NULL key column
+template <class T>
+static idx_t FindRunHeads(const UnifiedVectorFormat &format, const idx_t begin, const idx_t end,
+                          SelectionVector &heads) {
+	const auto data = UnifiedVectorFormat::GetData<T>(format);
+	const auto &sel = *format.sel;
+	idx_t run_count = 0;
+	T prev = data[sel.get_index(begin)];
+	heads.set_index(run_count++, begin);
+	for (idx_t i = begin + 1; i < end; i++) {
+		const T cur = data[sel.get_index(i)];
+		if (cur != prev) {
+			heads.set_index(run_count++, i);
+			prev = cur;
+		}
+	}
+	return run_count;
+}
+
+//! Aggregates the interior rows [begin, end) of a split chunk without the HT: every run of equal keys is a complete
+//! group (see ClusteredIntervalsDisjoint), so it gets a single aggregate state, and its head row is appended to the
+//! run store. Returns false (and sinks nothing) if the other group columns are not constant within the key runs
+static bool SinkInteriorRuns(ClientContext &context, const RadixPartitionedHashTable &radix_ht,
+                             RadixHTLocalSinkState &lstate, DataChunk &group_chunk, DataChunk &payload_input,
+                             const unsafe_vector<idx_t> &filter, const idx_t begin, const idx_t end) {
+	auto &heads = lstate.run_heads;
+	idx_t run_count;
+	switch (group_chunk.data[0].GetType().InternalType()) {
+	case PhysicalType::INT8:
+		run_count = FindRunHeads<int8_t>(lstate.key_format, begin, end, heads);
+		break;
+	case PhysicalType::INT16:
+		run_count = FindRunHeads<int16_t>(lstate.key_format, begin, end, heads);
+		break;
+	case PhysicalType::INT32:
+		run_count = FindRunHeads<int32_t>(lstate.key_format, begin, end, heads);
+		break;
+	case PhysicalType::INT64:
+		run_count = FindRunHeads<int64_t>(lstate.key_format, begin, end, heads);
+		break;
+	case PhysicalType::UINT8:
+		run_count = FindRunHeads<uint8_t>(lstate.key_format, begin, end, heads);
+		break;
+	case PhysicalType::UINT16:
+		run_count = FindRunHeads<uint16_t>(lstate.key_format, begin, end, heads);
+		break;
+	case PhysicalType::UINT32:
+		run_count = FindRunHeads<uint32_t>(lstate.key_format, begin, end, heads);
+		break;
+	case PhysicalType::UINT64:
+		run_count = FindRunHeads<uint64_t>(lstate.key_format, begin, end, heads);
+		break;
+	default:
+		return false;
+	}
+	const auto count = end - begin;
+
+	// The other group columns may only change where the key changes (otherwise a group could occur in several runs)
+	for (idx_t c = 1; c < group_chunk.ColumnCount() && count > 1; c++) {
+		Vector left(group_chunk.data[c], begin, end - 1);
+		Vector right(group_chunk.data[c], begin + 1, end);
+		auto &distinct_sel = lstate.run_distinct_sel;
+		const auto distinct_count =
+		    VectorOperations::DistinctFrom(left, right, nullptr, count - 1, &distinct_sel, nullptr);
+		idx_t h = 0;
+		for (idx_t k = 0; k < distinct_count; k++) {
+			const auto row = begin + distinct_sel.get_index(k) + 1;
+			while (h < run_count && heads.get_index(h) < row) {
+				h++;
+			}
+			if (h == run_count || heads.get_index(h) != row) {
+				return false;
+			}
+		}
+	}
+
+	if (!lstate.runs) {
+		lstate.runs_layout = make_uniq<TupleDataLayout>(radix_ht.GetLayout().Copy());
+		lstate.runs_allocator = make_shared_ptr<ArenaAllocator>(BufferAllocator::Get(context));
+		lstate.runs_row_state = make_uniq<RowOperationsState>(*lstate.runs_allocator);
+		auto types = radix_ht.group_types;
+		types.emplace_back(LogicalType::UBIGINT);
+		lstate.runs = make_uniq<ColumnDataCollection>(BufferManager::GetBufferManager(context), types);
+		lstate.runs->InitializeAppend(lstate.runs_append);
+		lstate.runs_chunk.InitializeEmpty(types);
+	}
+	auto &layout = *lstate.runs_layout;
+
+	// One block of aggregate states per run, addressed through a (fake) row pointer such that row + aggr_offset points
+	// at the states, like the rows of the HT, so the RowOperations work on them unchanged
+	const auto aggr_offset = layout.GetAggrOffset();
+	const auto stride = AlignValue(MaxValue<idx_t>(layout.GetAggrWidth(), 1));
+	const auto states = lstate.runs_allocator->AllocateAligned(run_count * stride);
+	const auto rows = FlatVector::GetData<data_ptr_t>(lstate.run_rows);
+	const auto addresses = FlatVector::GetData<data_ptr_t>(lstate.run_addresses);
+	for (idx_t r = 0; r < run_count; r++) {
+		const auto run_states = states + r * stride;
+		rows[r] = run_states - aggr_offset;
+		const auto run_end = r + 1 < run_count ? heads.get_index(r + 1) : end;
+		for (idx_t i = heads.get_index(r); i < run_end; i++) {
+			addresses[i - begin] = run_states;
+		}
+	}
+	RowOperations::InitializeStates(layout, lstate.run_rows, *FlatVector::IncrementalSelectionVector(), run_count);
+
+	// Update the states (same as GroupedAggregateHashTable::UpdateAggregates, FILTER is excluded)
+	auto &slice_payload = lstate.slice_payload;
+	for (idx_t c = 0; c < payload_input.ColumnCount(); c++) {
+		slice_payload.data[c].Slice(payload_input.data[c], begin, end);
+	}
+	slice_payload.SetCardinality(count);
+	auto &aggregates = layout.GetAggregates();
+	idx_t filter_idx = 0;
+	idx_t payload_idx = 0;
+	for (idx_t i = 0; i < aggregates.size(); i++) {
+		auto &aggr = aggregates[i];
+		if (filter_idx < filter.size() && i == filter[filter_idx]) {
+			RowOperations::UpdateStates(*lstate.runs_row_state, aggr, lstate.run_addresses, slice_payload, payload_idx,
+			                            count);
+			filter_idx++;
+		}
+		payload_idx += aggr.child_count;
+		VectorOperations::AddInPlace(lstate.run_addresses, NumericCast<int64_t>(aggr.payload_size), count);
+	}
+
+	// Append the run heads and their row pointers to the run store
+	auto &runs_chunk = lstate.runs_chunk;
+	const auto group_count = group_chunk.ColumnCount();
+	for (idx_t c = 0; c < group_count; c++) {
+		runs_chunk.data[c].Slice(group_chunk.data[c], heads, run_count);
+	}
+	Vector row_column(LogicalType::UBIGINT, data_ptr_cast(rows));
+	runs_chunk.data[group_count].Reference(row_column);
+	runs_chunk.SetCardinality(run_count);
+	lstate.runs->Append(lstate.runs_append, runs_chunk);
+	return true;
+}
