+//! Fallback if the interior runs are not proven to be complete groups: append every run as a row to the main data (the
+//! normal partition finalize then combines duplicates) and move its states there
+static void MergeRunStores(ClientContext &context, const RadixPartitionedHashTable &radix_ht,
+                           RadixHTGlobalSinkState &gstate) {
+	D_ASSERT(gstate.uncombined_data);
+	auto &uncombined_data = *gstate.uncombined_data;
+	auto ht = radix_ht.CreateHT(context, GroupedAggregateHashTable::InitialCapacity(),
+	                            RadixPartitioning::RadixBitsOfPowerOfTwo(uncombined_data.PartitionCount()));
+	ht->SkipLookups();
+	auto layout = radix_ht.GetLayout().Copy();
+	RowOperationsState row_state(*ht->GetAggregateAllocator());
+	const auto group_count = radix_ht.group_types.size();
+	DataChunk groups;
+	groups.InitializeEmpty(radix_ht.group_types);
+	Vector sources(LogicalType::POINTER);
+	Vector targets(LogicalType::POINTER);
+	for (auto &runs : gstate.run_stores) {
+		DataChunk scan_chunk;
+		runs->InitializeScanChunk(scan_chunk);
+		ColumnDataScanState scan_state;
+		runs->InitializeScan(scan_state);
+		while (runs->Scan(scan_state, scan_chunk)) {
+			const auto count = scan_chunk.size();
+			for (idx_t c = 0; c < group_count; c++) {
+				groups.data[c].Reference(scan_chunk.data[c]);
+			}
+			groups.SetCardinality(count);
+			if (ht->Count() + count > GroupedAggregateHashTable::ResizeThreshold(ht->Capacity())) {
+				ht->Abandon();
+			}
+			ht->FindOrCreateGroups(groups, targets);
+			auto &row_column = scan_chunk.data[group_count];
+			row_column.Flatten(count);
+			memcpy(FlatVector::GetData<data_ptr_t>(sources), FlatVector::GetData<uint64_t>(row_column),
+			       count * sizeof(data_ptr_t));
+			RowOperations::CombineStates(row_state, layout, sources, targets, count);
+		}
+		runs.reset();
+	}
+	gstate.run_stores.clear();
+	auto data = ht->AcquirePartitionedData();
+	D_ASSERT(data->PartitionCount() == uncombined_data.PartitionCount());
+	uncombined_data.Combine(*data);
+	gstate.stored_allocators.emplace_back(ht->GetAggregateAllocator());
+	gstate.stored_allocators_size += gstate.stored_allocators.back()->AllocationSize();
+}
