+//! Registers the open interval (min_key, max_key) of a chunk whose interior runs are about to be streamed. Returns false
+//! (and stops all streaming) once two registered intervals overlap: the disjointness proof would fail anyway
+static bool RegisterRunInterval(RadixHTGlobalSinkState &gstate, const uint64_t min_key, const uint64_t max_key) {
+	if (gstate.run_intervals_overlap) {
+		return false;
+	}
+	lock_guard<mutex> guard(gstate.run_intervals_lock);
+	if (gstate.run_intervals_overlap) {
+		return false;
+	}
+	auto &intervals = gstate.run_intervals;
+	auto next = intervals.lower_bound(min_key);
+	bool overlap = next != intervals.end() && next->first < max_key;
+	if (!overlap && next != intervals.begin()) {
+		overlap = std::prev(next)->second > min_key;
+	}
+	if (overlap) {
+		gstate.run_intervals_overlap = true;
+		intervals.clear();
+		return false;
+	}
+	intervals.emplace_hint(next, min_key, max_key);
+	return true;
+}
