+void PerfectAggregateHashTable::CombineRange(PerfectAggregateHashTable &other, idx_t begin, idx_t end,
+                                             ArenaAllocator &arena) {
+	D_ASSERT(lazy_init && other.lazy_init);
+	D_ASSERT(total_groups == other.total_groups);
+	D_ASSERT(tuple_size == other.tuple_size);
+	D_ASSERT(end <= total_groups);
+	auto source_is_set = other.lazy_group_is_set;
+	auto target_is_set = lazy_group_is_set;
+
+	Vector source_addresses(LogicalType::POINTER);
+	Vector target_addresses(LogicalType::POINTER);
+	Vector new_addresses(LogicalType::POINTER);
+	auto source_addresses_ptr = FlatVector::GetData<data_ptr_t>(source_addresses);
+	auto target_addresses_ptr = FlatVector::GetData<data_ptr_t>(target_addresses);
+	auto new_addresses_ptr = FlatVector::GetData<data_ptr_t>(new_addresses);
+
+	idx_t combine_count = 0;
+	idx_t new_count = 0;
+	RowOperationsState row_state(arena);
+	for (idx_t i = begin; i < end; i++) {
+		if (!source_is_set[i]) {
+			continue;
+		}
+		auto target_ptr = data + i * tuple_size;
+		if (!target_is_set[i]) {
+			target_is_set[i] = true;
+			new_addresses_ptr[new_count++] = target_ptr;
+		}
+		source_addresses_ptr[combine_count] = other.data + i * tuple_size;
+		target_addresses_ptr[combine_count] = target_ptr;
+		combine_count++;
+		if (combine_count == STANDARD_VECTOR_SIZE) {
+			if (new_count > 0) {
+				RowOperations::InitializeStates(*layout_ptr, new_addresses, *FlatVector::IncrementalSelectionVector(),
+				                                new_count);
+				new_count = 0;
+			}
+			RowOperations::CombineStates(row_state, *layout_ptr, source_addresses, target_addresses, combine_count);
+			combine_count = 0;
+		}
+	}
+	if (new_count > 0) {
+		RowOperations::InitializeStates(*layout_ptr, new_addresses, *FlatVector::IncrementalSelectionVector(),
+		                                new_count);
+	}
+	RowOperations::CombineStates(row_state, *layout_ptr, source_addresses, target_addresses, combine_count);
+}
