+//! Freed block-sized allocations of the fallback allocator, kept for immediate reuse.
+//! Operators that churn through many short-lived blocks (e.g., partitioned hash tables that repeatedly
+//! abandon / repartition their data) otherwise pay for a large-size alloc/free in the general-purpose
+//! allocator on every block, which gets markedly slower once its arenas are shared with many long-lived blocks.
+//! The cache is bounded, only ever holds memory that was just released, and is emptied on flush.
+struct FallbackBlockCache {
+	static constexpr idx_t CAPACITY_BYTES = 64ULL * 1024ULL * 1024ULL;
+	duckdb_moodycamel::ConcurrentQueue<data_ptr_t> q;
+	atomic<idx_t> count {0};
+};
