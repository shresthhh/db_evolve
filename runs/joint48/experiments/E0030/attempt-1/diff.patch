+data_ptr_t BlockAllocator::TryAllocateFromFallbackCache() const {
+	auto &cache = *fallback_cache;
+	if (cache.count.load(std::memory_order_relaxed) == 0) {
+		return nullptr;
+	}
+	data_ptr_t pointer;
+	if (!cache.q.try_dequeue(pointer)) {
+		return nullptr;
+	}
+	--cache.count;
+	return pointer;
+}
+
+bool BlockAllocator::TryFreeToFallbackCache(const data_ptr_t pointer) const {
+	auto &cache = *fallback_cache;
+	const auto capacity = MaxValue<idx_t>(FallbackBlockCache::CAPACITY_BYTES / block_size, 1);
+	if (cache.count.fetch_add(1) >= capacity) {
+		--cache.count;
+		return false;
+	}
+	cache.q.enqueue(pointer);
+	return true;
+}
+
+void BlockAllocator::FlushFallbackCache() const {
+	auto &cache = *fallback_cache;
+	data_ptr_t pointer;
+	while (cache.count.load(std::memory_order_relaxed) != 0 && cache.q.try_dequeue(pointer)) {
+		--cache.count;
+		allocator.FreeData(pointer, block_size);
+	}
+}
