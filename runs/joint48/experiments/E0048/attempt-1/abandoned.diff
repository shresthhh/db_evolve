+			memcpy(FlatVector::GetData(*targets[i]) + positions[i] * SIZE, source_data + idx * SIZE, SIZE);
+		}
+		return;
+	}
+	for (idx_t i = 0; i < count; i++) {
+		const auto idx = source.sel->get_index(i);
+		auto &target = *targets[i];
+		memcpy(FlatVector::GetData(target) + positions[i] * SIZE, source_data + idx * SIZE, SIZE);
+		if (!source.validity.RowIsValid(idx)) {
+			FlatVector::Validity(target).SetInvalid(positions[i]);
+		}
+	}
