+template <class T>
+void PerfectHashJoinExecutor::TemplatedBuildTask(idx_t chunk_idx_from, idx_t chunk_idx_to) {
+	auto &data_collection = ht.GetDataCollection();
+	const auto min_value = perfect_join_statistics.build_min.GetValueUnsafe<T>();
+	const auto max_value = perfect_join_statistics.build_max.GetValueUnsafe<T>();
+	Vector keys(ht.equality_types[0]);
+	const auto &incremental_sel = *FlatVector::IncrementalSelectionVector();
+
+	TupleDataChunkIterator iterator(data_collection, TupleDataPinProperties::KEEP_EVERYTHING_PINNED, chunk_idx_from,
+	                                chunk_idx_to, false);
+	const auto row_locations = iterator.GetRowLocations();
+	idx_t unique_count = 0;
+	do {
+		const auto count = iterator.GetCurrentChunkCount();
+		auto &row_location_vector = iterator.GetChunkState().row_locations;
+		// Gather only marks NULLs, so reset the validity of the previous chunk first
+		FlatVector::Validity(keys).Reset();
+		data_collection.Gather(row_location_vector, incremental_sel, count, 0, keys, incremental_sel, nullptr);
+		if (!InsertPerfectHashKeys<T>(keys, count, row_locations, min_value, max_value, build_bits.get(),
+		                              slot_to_row.get(), unique_count)) {
+			parallel_has_duplicates = true;
+			return;
+		}
+	} while (!parallel_has_duplicates && iterator.Next());
+	parallel_unique_keys += unique_count;
+}
+
+void PerfectHashJoinExecutor::BuildTask(idx_t task_idx) {
+	const auto chunk_count = ht.GetDataCollection().ChunkCount();
+	const auto chunk_idx_from = task_idx * CHUNKS_PER_BUILD_TASK;
+	const auto chunk_idx_to = MinValue<idx_t>(chunk_idx_from + CHUNKS_PER_BUILD_TASK, chunk_count);
+	if (chunk_idx_from >= chunk_idx_to || parallel_has_duplicates) {
+		return;
+	}
+	switch (ht.equality_types[0].InternalType()) {
+	case PhysicalType::INT8:
+		return TemplatedBuildTask<int8_t>(chunk_idx_from, chunk_idx_to);
+	case PhysicalType::INT16:
+		return TemplatedBuildTask<int16_t>(chunk_idx_from, chunk_idx_to);
+	case PhysicalType::INT32:
+		return TemplatedBuildTask<int32_t>(chunk_idx_from, chunk_idx_to);
+	case PhysicalType::INT64:
+		return TemplatedBuildTask<int64_t>(chunk_idx_from, chunk_idx_to);
+	case PhysicalType::INT128:
+		return TemplatedBuildTask<hugeint_t>(chunk_idx_from, chunk_idx_to);
+	case PhysicalType::UINT8:
+		return TemplatedBuildTask<uint8_t>(chunk_idx_from, chunk_idx_to);
+	case PhysicalType::UINT16:
+		return TemplatedBuildTask<uint16_t>(chunk_idx_from, chunk_idx_to);
+	case PhysicalType::UINT32:
+		return TemplatedBuildTask<uint32_t>(chunk_idx_from, chunk_idx_to);
+	case PhysicalType::UINT64:
+		return TemplatedBuildTask<uint64_t>(chunk_idx_from, chunk_idx_to);
+	case PhysicalType::UINT128:
+		return TemplatedBuildTask<uhugeint_t>(chunk_idx_from, chunk_idx_to);
+	default:
+		throw NotImplementedException("Type not supported for perfect hash join");
+	}
+}
