+template <class T>
+static bool InsertPerfectHashKeys(Vector &keys, const idx_t count, const data_ptr_t *rows, const T min_value,
+                                  const T max_value, atomic<validity_t> *bits, data_ptr_t *slot_to_row,
+                                  idx_t &unique_count) {
+	UnifiedVectorFormat vector_data;
+	keys.ToUnifiedFormat(count, vector_data);
+	const auto data = vector_data.GetData<T>();
+	for (idx_t i = 0; i < count; i++) {
+		const auto data_idx = vector_data.sel->get_index(i);
+		if (!vector_data.validity.RowIsValid(data_idx)) {
+			// NULL keys are only kept for joins that propagate the build side, they never match
+			continue;
+		}
+		const auto input_value = data[data_idx];
+		if (input_value < min_value || input_value > max_value) {
+			continue;
+		}
+		const auto slot = UnsafeNumericCast<idx_t>(input_value - min_value);
+		const auto bit = validity_t(1) << (slot % ValidityMask::BITS_PER_VALUE);
+		const auto previous = bits[slot / ValidityMask::BITS_PER_VALUE].fetch_or(bit, std::memory_order_relaxed);
+		if (previous & bit) {
+			return false; // duplicate key
+		}
+		slot_to_row[slot] = rows[i];
+		unique_count++;
+	}
+	return true;
+}
