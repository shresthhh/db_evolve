+bool PerfectHashJoinExecutor::FinishBuild() {
+	build_task_count = 0;
+	if (parallel_has_duplicates) {
+		build_bits.reset();
+		slot_to_row.reset();
+		return false;
+	}
+	const auto build_size = perfect_join_statistics.build_range + 1;
+	auto bitmap_data = bitmap_build_idx.GetData();
+	for (idx_t i = 0; i < ValidityMask::EntryCount(build_size); i++) {
+		bitmap_data[i] = build_bits[i].load(std::memory_order_relaxed);
+	}
+	build_bits.reset();
+	unique_keys = parallel_unique_keys;
+	if (unique_keys == build_size && !ht.has_null) {
+		perfect_join_statistics.is_build_dense = true;
+		bitmap_build_idx.Reset(build_size); // All valid
+	}
+
+	// The payload is gathered by GatherTask over disjoint slot ranges that are aligned to validity entries, so no two
+	// tasks write the same validity word. Slots without a build key are NULL, gathered NULLs are set by the tasks.
+	const auto column_count = join.rhs_output_columns.col_types.size();
+	for (idx_t i = 0; i < column_count; i++) {
+		auto &col_mask = FlatVector::Validity(perfect_hash_table[i]->data);
+		if (bitmap_build_idx.AllValid()) {
+			col_mask.Initialize(build_size);
+		} else {
+			col_mask.Copy(bitmap_build_idx, build_size);
+		}
+	}
+	gather_task_count = column_count == 0 ? 0 : (build_size + SLOTS_PER_GATHER_TASK - 1) / SLOTS_PER_GATHER_TASK;
+
+	if (PropagatesBuildSide(join.join_type)) {
+		// slot_to_row is kept so the matches found while probing can be written to the HT rows
+		slot_found_match = make_unsafe_uniq_array<uint8_t>(build_size);
+	} else if (gather_task_count == 0) {
+		slot_to_row.reset();
+	}
+	return true;
+}
