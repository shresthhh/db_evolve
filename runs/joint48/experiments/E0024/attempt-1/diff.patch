+//! Builds the perfect hash table in parallel: first inserts the keys (BUILD), then gathers the payload (GATHER)
+class PerfectHashJoinBuildEvent : public BasePipelineEvent {
+public:
+	PerfectHashJoinBuildEvent(Pipeline &pipeline_p, HashJoinGlobalSinkState &sink, bool gather_p)
+	    : BasePipelineEvent(pipeline_p), sink(sink), gather(gather_p) {
+	}
+
+	HashJoinGlobalSinkState &sink;
+	bool gather;
+
+public:
+	void Schedule() override {
+		auto &context = pipeline->GetClientContext();
+		auto &executor = *sink.perfect_join_executor;
+		const auto task_count = gather ? executor.GatherTaskCount() : executor.BuildTaskCount();
+		vector<shared_ptr<Task>> tasks;
+		for (idx_t task_idx = 0; task_idx < task_count; task_idx++) {
+			tasks.push_back(
+			    make_uniq<PerfectHashJoinBuildTask>(shared_from_this(), context, executor, task_idx, gather, sink.op));
+		}
+		SetTasks(std::move(tasks));
+	}
+
+	void FinishEvent() override {
+		if (gather) {
+			sink.perfect_join_executor->FinishGather();
+			return;
+		}
+		auto &ht = *sink.hash_table;
+		const auto use_perfect_hash = sink.perfect_join_executor->FinishBuild();
+		if (sink.perfect_filter_min_max) {
+			sink.op.filter_pushdown->FinalizeFilters(sink.context, &ht, sink.op, std::move(sink.perfect_filter_min_max),
+			                                         use_perfect_hash, &sink.deferred_bloom_filters);
+		}
+		if (!use_perfect_hash) {
+			// duplicate keys: fall back to the regular hash join
+			sink.perfect_join_executor.reset();
+			sink.ScheduleFinalize(*pipeline, *this);
+		} else if (sink.perfect_join_executor->GatherTaskCount() > 0) {
+			InsertEvent(make_shared_ptr<PerfectHashJoinBuildEvent>(*pipeline, sink, true));
+		}
+	}
+};
