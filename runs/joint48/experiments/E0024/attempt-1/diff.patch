+class PerfectHashJoinBuildTask : public ExecutorTask {
+public:
+	PerfectHashJoinBuildTask(shared_ptr<Event> event_p, ClientContext &context, PerfectHashJoinExecutor &executor_p,
+	                         idx_t task_idx_p, bool gather_p, const PhysicalOperator &op_p)
+	    : ExecutorTask(context, std::move(event_p), op_p), executor(executor_p), task_idx(task_idx_p),
+	      gather(gather_p) {
+	}
+
+	TaskExecutionResult ExecuteTask(TaskExecutionMode mode) override {
+		if (gather) {
+			executor.GatherTask(task_idx);
+		} else {
+			executor.BuildTask(task_idx);
+		}
+		event->FinishTask();
+		return TaskExecutionResult::TASK_FINISHED;
+	}
+	string TaskType() const override {
+		return "PerfectHashJoinBuildTask";
+	}
+
+private:
+	PerfectHashJoinExecutor &executor;
+	idx_t task_idx;
+	bool gather;
+};
