+void PerfectHashJoinExecutor::GatherTask(idx_t task_idx) {
+	auto &data_collection = ht.GetDataCollection();
+	const auto build_size = perfect_join_statistics.build_range + 1;
+	const auto slot_begin = task_idx * SLOTS_PER_GATHER_TASK;
+	const auto slot_end = MinValue<idx_t>(slot_begin + SLOTS_PER_GATHER_TASK, build_size);
+	const auto column_count = join.rhs_output_columns.col_types.size();
+	const bool all_slots_valid = bitmap_build_idx.AllValid();
+
+	Vector addresses(LogicalType::POINTER);
+	auto address_data = FlatVector::GetData<data_ptr_t>(addresses);
+	const auto &incremental_sel = *FlatVector::IncrementalSelectionVector();
+	SelectionVector sel_slots(STANDARD_VECTOR_SIZE);
+	for (idx_t batch_begin = slot_begin; batch_begin < slot_end; batch_begin += STANDARD_VECTOR_SIZE) {
+		const auto batch_end = MinValue<idx_t>(batch_begin + STANDARD_VECTOR_SIZE, slot_end);
+		idx_t count = 0;
+		for (idx_t slot = batch_begin; slot < batch_end; slot++) {
+			if (all_slots_valid || bitmap_build_idx.RowIsValidUnsafe(slot)) {
+				sel_slots.set_index(count, slot);
+				address_data[count++] = slot_to_row[slot];
+			}
+		}
+		if (count == 0) {
+			continue;
+		}
+		for (idx_t i = 0; i < column_count; i++) {
+			auto &vector = perfect_hash_table[i]->data;
+			data_collection.Gather(addresses, incremental_sel, count, ht.output_columns[i], vector, sel_slots, nullptr);
+		}
+	}
+}
+
+void PerfectHashJoinExecutor::FinishGather() {
+	gather_task_count = 0;
+	if (!PropagatesBuildSide(join.join_type)) {
+		slot_to_row.reset();
+	}
+}
