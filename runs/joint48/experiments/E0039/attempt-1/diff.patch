diff --git a/src/include/duckdb/common/huge_page_util.hpp b/src/include/duckdb/common/huge_page_util.hpp
new file mode 100644
index 0000000..b0fc8bf
--- /dev/null
+++ b/src/include/duckdb/common/huge_page_util.hpp
@@ -0,0 +1,90 @@
+//===----------------------------------------------------------------------===//
+//                         DuckDB
+//
+// duckdb/common/huge_page_util.hpp
+//
+//
+//===----------------------------------------------------------------------===//
+
+#pragma once
+
+#include "duckdb/common/constants.hpp"
+
+#include <cstdio>
+#include <cstring>
+#if defined(__linux__)
+#include <sys/mman.h>
+#endif
+
+namespace duckdb {
+
+//! Helpers to back large, randomly accessed arrays (e.g., hash join tables) with transparent huge pages.
+//! Arrays beyond the TLB reach of 4KB pages pay a TLB miss + page walk on (almost) every random access.
+//! Usage: over-allocate by HUGE_PAGE_SIZE, align the start with Align, call Advise before first touch,
+//! and call Release on the same range before the memory is freed, so that recycled allocator memory
+//! does not keep the huge page advice.
+struct HugePageUtil {
+	static constexpr idx_t HUGE_PAGE_SIZE = 2ULL * 1024ULL * 1024ULL;
+	//! Arrays of at least this size are backed by huge pages
+	static constexpr idx_t MIN_ARRAY_SIZE = 8ULL * 1024ULL * 1024ULL;
+
+	//! Whether transparent huge pages can be requested with madvise
+	static bool Enabled() {
+		static const bool enabled = ReadEnabled();
+		return enabled;
+	}
+
+	static bool ShouldUse(idx_t size) {
+		return size >= MIN_ARRAY_SIZE && Enabled();
+	}
+
+	static data_ptr_t Align(data_ptr_t ptr) {
+		const auto addr = reinterpret_cast<uintptr_t>(ptr);
+		return reinterpret_cast<data_ptr_t>((addr + HUGE_PAGE_SIZE - 1) & ~(uintptr_t(HUGE_PAGE_SIZE) - 1));
+	}
+
+	//! Size rounded down to whole huge pages (the range that is advised/released)
+	static idx_t AdvisedSize(idx_t size) {
+		return size & ~(HUGE_PAGE_SIZE - 1);
+	}
+
+	//! ptr must be aligned with Align
+	static void Advise(data_ptr_t ptr, idx_t size) {
+#if defined(__linux__) && defined(MADV_HUGEPAGE)
+		const auto advised_size = AdvisedSize(size);
+		if (advised_size > 0) {
+			madvise(ptr, advised_size, MADV_HUGEPAGE);
+		}
+#endif
+	}
+
+	//! Drops the pages of the range and removes the huge page advice; the contents are lost
+	static void Release(data_ptr_t ptr, idx_t size) {
+#if defined(__linux__) && defined(MADV_HUGEPAGE) && defined(MADV_NOHUGEPAGE)
+		const auto advised_size = AdvisedSize(size);
+		if (advised_size > 0) {
+			madvise(ptr, advised_size, MADV_DONTNEED);
+			madvise(ptr, advised_size, MADV_NOHUGEPAGE);
+		}
+#endif
+	}
+
+private:
+	static bool ReadEnabled() {
+#if defined(__linux__) && defined(MADV_HUGEPAGE) && defined(MADV_NOHUGEPAGE)
+		auto file = std::fopen("/sys/kernel/mm/transparent_hugepage/enabled", "r");
+		if (!file) {
+			return false;
+		}
+		char buffer[128];
+		const auto read = std::fread(buffer, 1, sizeof(buffer) - 1, file);
+		std::fclose(file);
+		buffer[read] = '\0';
+		return std::strstr(buffer, "[madvise]") != nullptr || std::strstr(buffer, "[always]") != nullptr;
+#else
+		return false;
+#endif
+	}
+};
+
+} // namespace duckdb
