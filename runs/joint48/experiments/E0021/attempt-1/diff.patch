+//! A SEMI delim join whose LHS has a selection normally keeps its join with the DelimGet, so that the
+//! (de-duplicated) selected LHS keys reduce the RHS. When the RHS is simple and the correlation is a plain
+//! equality, a regular SEMI join with runtime join filters (min/max, Bloom filter) achieves the same reduction
+//! without materializing and de-duplicating the LHS keys and without the extra join.
+static bool SelectionIsReplaceableByJoinFilter(const DelimCandidate &candidate) {
+	auto &delim_join = candidate.delim_join;
+	if (delim_join.join_type != JoinType::SEMI || candidate.delim_get_count != 1 || candidate.joins.size() != 1) {
+		return false;
+	}
+	auto &join_op = *candidate.joins[0].join.get();
+	if (join_op.type != LogicalOperatorType::LOGICAL_COMPARISON_JOIN) {
+		return false;
+	}
+	auto &join = join_op.Cast<LogicalComparisonJoin>();
+	if (join.join_type != JoinType::INNER && join.join_type != JoinType::SEMI) {
+		return false;
+	}
