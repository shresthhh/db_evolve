+//! Hashed mode probe on integer keys, fused with hashing: computes exactly the hash VectorOperations::Hash produces
+//! (duckdb::Hash<T> for valid rows, HashOp::NULL_HASH for NULLs) and tests it, in a single pass
+static constexpr hash_t BF_NULL_HASH = 0xbf58476d1ce4e5b9; // must equal HashOp::NULL_HASH in vector_hash.cpp
+
+template <class T>
+static idx_t TemplatedLookupHashed(const BloomFilter &bf, const UnifiedVectorFormat &vdata,
+                                   optional_ptr<const SelectionVector> row_sel, SelectionVector &result_sel,
+                                   const idx_t count) {
+	const auto data = UnifiedVectorFormat::GetData<T>(vdata);
+	idx_t found_count = 0;
+	if (vdata.validity.AllValid()) {
+		for (idx_t i = 0; i < count; i++) {
+			const auto row = row_sel ? row_sel->get_index(i) : i;
+			const auto idx = vdata.sel->get_index(row);
+			result_sel.set_index(found_count, i);
+			found_count += bf.LookupOne(duckdb::Hash<T>(data[idx]));
+		}
+	} else {
+		const bool null_found = bf.LookupOne(BF_NULL_HASH);
+		for (idx_t i = 0; i < count; i++) {
+			const auto row = row_sel ? row_sel->get_index(i) : i;
+			const auto idx = vdata.sel->get_index(row);
+			result_sel.set_index(found_count, i);
+			found_count += vdata.validity.RowIsValid(idx) ? bf.LookupOne(duckdb::Hash<T>(data[idx])) : null_found;
+		}
+	}
+	return found_count;
+}
+
+static bool LookupHashedKeys(const BloomFilter &bf, const UnifiedVectorFormat &vdata, PhysicalType type,
+                             optional_ptr<const SelectionVector> row_sel, SelectionVector &result_sel,
+                             const idx_t count, idx_t &found_count) {
+	switch (type) {
+	case PhysicalType::INT8:
+		found_count = TemplatedLookupHashed<int8_t>(bf, vdata, row_sel, result_sel, count);
+		return true;
+	case PhysicalType::INT16:
+		found_count = TemplatedLookupHashed<int16_t>(bf, vdata, row_sel, result_sel, count);
+		return true;
+	case PhysicalType::INT32:
+		found_count = TemplatedLookupHashed<int32_t>(bf, vdata, row_sel, result_sel, count);
+		return true;
+	case PhysicalType::INT64:
+		found_count = TemplatedLookupHashed<int64_t>(bf, vdata, row_sel, result_sel, count);
+		return true;
+	case PhysicalType::UINT8:
+		found_count = TemplatedLookupHashed<uint8_t>(bf, vdata, row_sel, result_sel, count);
+		return true;
+	case PhysicalType::UINT16:
+		found_count = TemplatedLookupHashed<uint16_t>(bf, vdata, row_sel, result_sel, count);
+		return true;
+	case PhysicalType::UINT32:
+		found_count = TemplatedLookupHashed<uint32_t>(bf, vdata, row_sel, result_sel, count);
+		return true;
+	case PhysicalType::UINT64:
+		found_count = TemplatedLookupHashed<uint64_t>(bf, vdata, row_sel, result_sel, count);
+		return true;
+	default:
+		return false;
+	}
+}
+
+static bool IsFusedHashType(PhysicalType type) {
+	switch (type) {
+	case PhysicalType::INT8:
+	case PhysicalType::INT16:
+	case PhysicalType::INT32:
+	case PhysicalType::INT64:
+	case PhysicalType::UINT8:
+	case PhysicalType::UINT16:
+	case PhysicalType::UINT32:
+	case PhysicalType::UINT64:
+		return true;
+	default:
+		return false;
+	}
+}
