+			for (idx_t j = 0; j < approved_count; j++) {
+				result_data[new_sel.get_index(j)] = decoded[j];
+			}
+		}
+	}
+	EndScan(scan_state, offsets, start, vector_count);
+
+	if (approved_count < vector_count) {
+		sel.Initialize(new_sel);
+	}
+	sel_count = approved_count;
+}
