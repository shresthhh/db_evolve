+//! Whether the current segment of "state" holds the next "count" rows
+static bool SegmentCovers(const ColumnScanState &state, idx_t count) {
+	if (!state.current) {
+		return false;
+	}
+	return state.current->GetRowStart() + state.current->GetNode().count - state.offset_in_column >= count;
+}
+
+//! Whether all segments holding the next "count" rows of "state" have a filter function (and, if "check_nulls" is
+//! set, cannot contain NULL values)
+static bool CanFilterAcrossSegments(const ColumnScanState &state, idx_t count, bool check_nulls) {
+	if (!state.segment_tree) {
+		return false;
+	}
+	auto segment = state.current;
+	idx_t position = state.offset_in_column;
+	idx_t covered = 0;
+	while (covered < count) {
+		if (!segment) {
+			return false;
+		}
+		auto &node = segment->GetNode();
+		auto segment_end = segment->GetRowStart() + node.count;
+		if (position > segment_end) {
+			return false;
+		}
+		auto piece_count = MinValue<idx_t>(segment_end - position, count - covered);
+		if (piece_count > 0) {
+			if (!node.GetCompressionFunction().filter) {
+				return false;
+			}
+			if (check_nulls && node.stats.statistics.CanHaveNull()) {
+				return false;
+			}
+		}
+		covered += piece_count;
+		position += piece_count;
+		if (covered < count) {
+			segment = state.segment_tree->GetNextSegment(*segment);
+		}
+	}
+	return true;
+}
+
+//! Filters the next "count" rows of "state" that span multiple segments, applying each segment's filter function to
+//! its piece of the rows. The scanned values are not emitted.
+static void FilterAcrossSegments(ColumnScanState &state, const LogicalType &type, idx_t count, SelectionVector &sel,
+                                 idx_t &sel_count, const TableFilter &filter, TableFilterState &filter_state) {
+	SelectionVector new_sel(STANDARD_VECTOR_SIZE);
+	idx_t new_count = 0;
+	idx_t remaining = count;
+	idx_t piece_offset = 0;
+	while (remaining > 0) {
+		auto &current = state.current->GetNode();
+		auto piece_count =
+		    MinValue<idx_t>(remaining, state.current->GetRowStart() + current.count - state.offset_in_column);
+		if (piece_count > 0) {
+			state.internal_index = state.offset_in_column;
+			// the candidate rows that fall into this piece, relative to the piece start
+			SelectionVector piece_sel(piece_count);
+			idx_t piece_sel_count = 0;
+			for (idx_t i = 0; i < sel_count; i++) {
+				auto idx = sel.get_index(i);
+				if (idx >= piece_offset && idx < piece_offset + piece_count) {
+					piece_sel.set_index(piece_sel_count++, idx - piece_offset);
+				}
+			}
+			if (piece_sel_count > 0) {
+				Vector piece_result(type);
+				current.Filter(state, piece_count, piece_result, piece_sel, piece_sel_count, filter, filter_state);
+				for (idx_t i = 0; i < piece_sel_count; i++) {
+					new_sel.set_index(new_count++, piece_sel.get_index(i) + piece_offset);
+				}
+				state.offset_in_column += piece_count;
+				state.internal_index = state.offset_in_column;
+			} else {
+				state.offset_in_column += piece_count;
+				current.Skip(state);
+			}
+			remaining -= piece_count;
+			piece_offset += piece_count;
+		}
+		if (remaining > 0) {
+			auto next = state.segment_tree->GetNextSegment(*state.current);
+			if (!next) {
+				throw InternalException("StandardColumnData::Filter - ran out of segments");
+			}
+			state.previous_states.emplace_back(std::move(state.scan_state));
+			state.current = next;
+			state.current->GetNode().InitializeScan(state);
+			state.segment_checked = false;
+		}
+	}
+	state.internal_index = state.offset_in_column;
+	sel.Initialize(new_sel);
+	sel_count = new_count;
+}
