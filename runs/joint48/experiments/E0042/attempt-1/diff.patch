+//===--------------------------------------------------------------------===//
+// Filter
+//===--------------------------------------------------------------------===//
+void FSSTStorage::Filter(ColumnSegment &segment, ColumnScanState &state, idx_t vector_count, Vector &result,
+                         SelectionVector &sel, idx_t &sel_count, const TableFilter &filter,
+                         TableFilterState &filter_state) {
+	auto &scan_state = state.scan_state->Cast<FSSTScanState>();
+	if (scan_state.pattern_filter != &filter) {
+		scan_state.InitializePattern(filter);
+	}
+	if (!scan_state.has_pattern || vector_count > STANDARD_VECTOR_SIZE) {
+		// fallback: scan + filter
+		StringScan(segment, state, vector_count, result);
+		UnifiedVectorFormat vdata;
+		result.ToUnifiedFormat(vector_count, vdata);
+		ColumnSegment::FilterSelection(sel, result, vdata, filter, filter_state, vector_count, sel_count);
+		return;
+	}
+	// run the pattern DFA over the compressed strings of the candidate rows
+	auto start = state.GetPositionInSegment();
+	auto baseptr = scan_state.handle.Ptr() + segment.GetBlockOffset();
+	auto dict = GetDictionary(segment, scan_state.handle);
+	auto base_data = data_ptr_cast(baseptr + sizeof(fsst_compression_header_t));
+	auto offsets = StartScan(scan_state, base_data, start, vector_count);
+	auto lengths = scan_state.bitunpack_buffer.get() + offsets.scan_offset;
+	auto dict_offsets = scan_state.delta_decode_buffer.get() + offsets.unused_delta_decoded_values;
+	auto get_string = [&](idx_t row) {
+		return const_data_ptr_cast(
+		    FetchStringPointer(dict, baseptr, UnsafeNumericCast<int32_t>(dict_offsets[row])));
+	};
+	const uint16_t *table = scan_state.pattern_table.data();
+	const uint8_t *accept = scan_state.pattern_accept.data();
+
+	SelectionVector new_sel(sel_count);
+	idx_t approved_count = 0;
+	idx_t i = 0;
+	// process four strings at a time to overlap the dependent table lookups
+	for (; i + 4 <= sel_count; i += 4) {
+		idx_t rows[4];
+		const_data_ptr_t strs[4];
+		uint32_t lens[4];
+		uint32_t states[4] = {0, 0, 0, 0};
+		for (idx_t l = 0; l < 4; l++) {
+			rows[l] = sel.get_index(i + l);
+			lens[l] = lengths[rows[l]];
+			strs[l] = get_string(rows[l]);
+		}
+		const uint32_t common = MinValue(MinValue(lens[0], lens[1]), MinValue(lens[2], lens[3]));
+		for (uint32_t k = 0; k < common; k++) {
+			states[0] = table[states[0] + strs[0][k]];
+			states[1] = table[states[1] + strs[1][k]];
+			states[2] = table[states[2] + strs[2][k]];
+			states[3] = table[states[3] + strs[3][k]];
+		}
+		for (idx_t l = 0; l < 4; l++) {
+			uint32_t s = states[l];
+			for (uint32_t k = common; k < lens[l]; k++) {
+				s = table[s + strs[l][k]];
+			}
+			new_sel.set_index(approved_count, rows[l]);
+			approved_count += accept[s >> 8];
+		}
+	}
+	for (; i < sel_count; i++) {
+		auto row = sel.get_index(i);
+		auto len = lengths[row];
+		auto str = get_string(row);
+		uint32_t s = 0;
+		for (uint32_t k = 0; k < len; k++) {
+			s = table[s + str[k]];
+		}
+		new_sel.set_index(approved_count, row);
+		approved_count += accept[s >> 8];
+	}
+
+	if (state.filter_only) {
+		// the values are not used after filtering - emit a placeholder instead of decompressing
+		result.Reference(Value(result.GetType()));
+	} else if (scan_state.duckdb_fsst_decoder && Settings::Get<EnableFSSTVectorsSetting>(segment.db)) {
+		// emit the compressed strings - only the selected rows are decompressed when the vector is sliced
+		result.SetVectorType(VectorType::FSST_VECTOR);
+		auto string_block_limit = StringUncompressed::GetStringBlockLimit(segment.GetBlockSize());
+		FSSTVector::RegisterDecoder(result, scan_state.duckdb_fsst_decoder, string_block_limit);
+		auto result_data = FSSTVector::GetCompressedData<string_t>(result);
+		for (idx_t row = 0; row < vector_count; row++) {
+			result_data[row] = UncompressedStringStorage::FetchStringFromDict(
+			    segment, dict.end, result, baseptr, UnsafeNumericCast<int32_t>(dict_offsets[row]), lengths[row]);
+		}
+		FSSTVector::SetCount(result, vector_count);
+	} else {
+		// decompress the selected rows
+		D_ASSERT(result.GetVectorType() == VectorType::FLAT_VECTOR);
+		auto result_data = FlatVector::GetData<string_t>(result);
+		for (idx_t row = 0; row < vector_count; row++) {
+			result_data[row] = string_t(nullptr, 0);
+		}
+		if (scan_state.duckdb_fsst_decoder && approved_count > 0) {
+			auto &str_buffer = StringVector::GetStringBuffer(result);
+			string_t decoded[STANDARD_VECTOR_SIZE];
