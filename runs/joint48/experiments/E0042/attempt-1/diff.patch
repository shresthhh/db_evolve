+//===--------------------------------------------------------------------===//
+// Pattern filter
+//===--------------------------------------------------------------------===//
+//! A filter of the form [NOT] (str LIKE pattern) where the pattern consists of literal parts separated by '%'
+//! (this includes contains, prefix and suffix), as a DFA over bytes. A string passes the filter iff the DFA ends in an
+//! accepting state after consuming it.
+struct FSSTPatternDFA {
+	//! upper bound on the number of states, so that lifted transition tables can be addressed with 16 bits
+	static constexpr idx_t MAX_STATES = 127;
+	static constexpr idx_t ALPHABET = 256;
+
+	idx_t state_count = 0;
+	//! transitions[state * ALPHABET + byte]
+	vector<uint8_t> transitions;
+	//! accept[state]: whether a string that ends in the state passes the filter
+	vector<uint8_t> accept;
+
+	static unique_ptr<FSSTPatternDFA> TryCreate(const TableFilter &filter);
+	static unique_ptr<FSSTPatternDFA> Build(const vector<string> &parts, bool anchored_start, bool anchored_end,
+	                                        bool negate);
+};
+
+unique_ptr<FSSTPatternDFA> FSSTPatternDFA::TryCreate(const TableFilter &filter) {
+	if (filter.filter_type != TableFilterType::EXPRESSION_FILTER) {
+		return nullptr;
+	}
+	bool negate = false;
+	reference<const Expression> current(*filter.Cast<ExpressionFilter>().expr);
+	if (current.get().GetExpressionType() == ExpressionType::OPERATOR_NOT) {
+		auto &op = current.get().Cast<BoundOperatorExpression>();
+		if (op.children.size() != 1) {
+			return nullptr;
+		}
+		negate = true;
+		current = *op.children[0];
+	}
+	if (current.get().GetExpressionClass() != ExpressionClass::BOUND_FUNCTION) {
+		return nullptr;
+	}
+	auto &func = current.get().Cast<BoundFunctionExpression>();
+	if (func.children.size() != 2 || func.return_type.id() != LogicalTypeId::BOOLEAN ||
+	    func.children[0]->GetExpressionClass() != ExpressionClass::BOUND_REF ||
+	    func.children[0]->return_type.id() != LogicalTypeId::VARCHAR ||
+	    func.children[1]->GetExpressionClass() != ExpressionClass::BOUND_CONSTANT) {
+		return nullptr;
+	}
+	auto &constant = func.children[1]->Cast<BoundConstantExpression>().value;
+	if (constant.IsNull() || constant.type().id() != LogicalTypeId::VARCHAR) {
+		return nullptr;
+	}
+	auto &pattern = StringValue::Get(constant);
+	auto &name = func.function.name;
+	vector<string> parts;
+	bool anchored_start = false;
+	bool anchored_end = false;
+	if (name == "contains") {
+		parts.push_back(pattern);
+	} else if (name == "prefix" || name == "starts_with") {
+		parts.push_back(pattern);
+		anchored_start = true;
+	} else if (name == "suffix" || name == "ends_with") {
+		parts.push_back(pattern);
+		anchored_end = true;
+	} else if (name == "~~" || name == "!~~") {
+		if (name == "!~~") {
+			negate = !negate;
+		}
+		// only patterns of literals and '%' are supported
+		if (pattern.find('_') != string::npos || pattern.find('\\') != string::npos) {
+			return nullptr;
+		}
+		anchored_start = pattern.empty() || pattern[0] != '%';
+		anchored_end = pattern.empty() || pattern.back() != '%';
+		idx_t start = 0;
+		for (idx_t i = 0; i <= pattern.size(); i++) {
+			if (i == pattern.size() || pattern[i] == '%') {
+				parts.push_back(pattern.substr(start, i - start));
+				start = i + 1;
+			}
+		}
+	} else {
+		return nullptr;
+	}
+	// empty parts are trivially matched
+	vector<string> non_empty_parts;
+	for (auto &part : parts) {
+		if (!part.empty()) {
+			non_empty_parts.push_back(std::move(part));
+		}
+	}
+	return Build(non_empty_parts, anchored_start, anchored_end, negate);
+}
+
+unique_ptr<FSSTPatternDFA> FSSTPatternDFA::Build(const vector<string> &parts, bool anchored_start, bool anchored_end,
+                                                 bool negate) {
+	idx_t total_length = 0;
+	for (auto &part : parts) {
+		total_length += part.size();
+	}
+	if (total_length + 3 > MAX_STATES) {
+		return nullptr;
+	}
+	auto result = make_uniq<FSSTPatternDFA>();
+	auto &transitions = result->transitions;
+	auto &accept = result->accept;
+	auto set_row = [&](idx_t state, idx_t target) {
+		memset(transitions.data() + state * ALPHABET, UnsafeNumericCast<uint8_t>(target), ALPHABET);
+	};
+	if (parts.empty()) {
+		// state 0 is the start, state 1 is reached by any byte
+		result->state_count = 2;
+		transitions.resize(2 * ALPHABET);
+		accept = {1, 0};
+		if (anchored_start && anchored_end) {
+			// only the empty string matches
+			set_row(0, 1);
+			set_row(1, 1);
+		} else {
+			// everything matches
+			set_row(0, 0);
+			accept[1] = 1;
+			set_row(1, 1);
+		}
+	} else {
+		// part i occupies the states [base[i], base[i] + |part i|), an anchored last part has one more state for the
+		// complete match. "done" means all parts were found (the rest of the string is free), "dead" means no match
+		vector<idx_t> base(parts.size());
+		idx_t state_count = 0;
+		for (idx_t i = 0; i < parts.size(); i++) {
+			base[i] = state_count;
+			state_count += parts[i].size();
+			if (i + 1 == parts.size() && anchored_end) {
+				state_count++;
+			}
+		}
+		const idx_t done = state_count++;
+		const idx_t dead = state_count++;
+		result->state_count = state_count;
+		transitions.resize(state_count * ALPHABET);
+		accept.assign(state_count, 0);
+		set_row(done, done);
+		accept[done] = 1;
+		set_row(dead, dead);
+		for (idx_t i = 0; i < parts.size(); i++) {
+			auto part = const_data_ptr_cast(parts[i].c_str());
+			const idx_t m = parts[i].size();
+			const bool last = i + 1 == parts.size();
+			const idx_t after = last ? done : base[i + 1];
+			const bool must_end = last && anchored_end;
+			if (i == 0 && anchored_start) {
+				// the part must match at the start of the string
+				for (idx_t j = 0; j < m; j++) {
+					set_row(base[i] + j, dead);
+					idx_t target = j + 1 < m ? base[i] + j + 1 : (must_end ? base[i] + m : after);
+					transitions[(base[i] + j) * ALPHABET + part[j]] = UnsafeNumericCast<uint8_t>(target);
+				}
+				if (must_end) {
+					// nothing may follow the part
+					set_row(base[i] + m, dead);
+					accept[base[i] + m] = 1;
+				}
+				continue;
+			}
+			// KMP automaton: delta[j][c] is the longest prefix of the part that is a suffix of (matched j) + c
+			vector<uint8_t> delta((m + 1) * ALPHABET);
+			idx_t fail = 0;
+			for (idx_t j = 0; j <= m; j++) {
+				if (j >= 2) {
+					fail = delta[fail * ALPHABET + part[j - 1]];
+				}
+				for (idx_t c = 0; c < ALPHABET; c++) {
+					delta[j * ALPHABET + c] = j == 0 ? 0 : delta[fail * ALPHABET + c];
+				}
+				if (j < m) {
+					delta[j * ALPHABET + part[j]] = UnsafeNumericCast<uint8_t>(j + 1);
+				}
+			}
+			const idx_t row_count = must_end ? m + 1 : m;
+			for (idx_t j = 0; j < row_count; j++) {
+				for (idx_t c = 0; c < ALPHABET; c++) {
+					idx_t next = delta[j * ALPHABET + c];
+					idx_t target;
+					if (must_end) {
+						// the part has to be matched at the end of the string: keep matching after a full match
+						target = base[i] + next;
+					} else {
+						// the first occurrence of the part is enough
+						target = next == m ? after : base[i] + next;
+					}
+					transitions[(base[i] + j) * ALPHABET + c] = UnsafeNumericCast<uint8_t>(target);
+				}
+			}
+			if (must_end) {
+				accept[base[i] + m] = 1;
+			}
+		}
+	}
+	if (negate) {
+		for (auto &entry : accept) {
+			entry = !entry;
+		}
+	}
+	return result;
+}
