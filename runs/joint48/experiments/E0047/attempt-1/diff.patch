+//! Copies the initial state bytes to every row; WIDTH != 0 makes the copy a fixed-size (inlined) one
+template <idx_t WIDTH>
+static void CopyStateTemplate(data_ptr_t *pointers, const SelectionVector &sel, const idx_t count, const idx_t offset,
+                              const_data_ptr_t tmpl, const idx_t width = WIDTH) {
+	const auto copy_width = WIDTH != 0 ? WIDTH : width;
+	if (sel.IsSet()) {
+		for (idx_t i = 0; i < count; ++i) {
+			memcpy(pointers[sel.get_index_unsafe(i)] + offset, tmpl, copy_width);
+		}
+	} else {
+		for (idx_t i = 0; i < count; ++i) {
+			memcpy(pointers[i] + offset, tmpl, copy_width);
+		}
+	}
+}
