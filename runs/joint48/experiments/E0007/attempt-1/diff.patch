+template <class T>
+static idx_t TemplatedLookupExact(const BloomFilter &bf, const UnifiedVectorFormat &vdata,
+                                  optional_ptr<const SelectionVector> row_sel, SelectionVector &result_sel,
+                                  const idx_t count) {
+	const auto data = UnifiedVectorFormat::GetData<T>(vdata);
+	idx_t found_count = 0;
+	if (vdata.validity.AllValid()) {
+		for (idx_t i = 0; i < count; i++) {
+			const auto row = row_sel ? row_sel->get_index(i) : i;
+			const auto idx = vdata.sel->get_index(row);
+			result_sel.set_index(found_count, i);
+			found_count += bf.LookupExact(static_cast<uint64_t>(data[idx]));
+		}
+	} else {
+		for (idx_t i = 0; i < count; i++) {
+			const auto row = row_sel ? row_sel->get_index(i) : i;
+			const auto idx = vdata.sel->get_index(row);
+			result_sel.set_index(found_count, i);
+			found_count += vdata.validity.RowIsValid(idx) && bf.LookupExact(static_cast<uint64_t>(data[idx]));
+		}
+	}
+	return found_count;
