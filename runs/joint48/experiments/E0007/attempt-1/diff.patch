+template <class T>
+static FilterPropagateResult TemplatedCheckStatisticsExact(const BloomFilter &bf, const BaseStatistics &stats,
+                                                           bool filters_null_values) {
+	if (bf.ExactOverflow() || !NumericStats::HasMinMax(stats)) {
+		return FilterPropagateResult::NO_PRUNING_POSSIBLE;
+	}
+	const auto min = NumericStats::GetMin<T>(stats);
+	const auto max = NumericStats::GetMax<T>(stats);
+	if (min > max) {
+		return FilterPropagateResult::NO_PRUNING_POSSIBLE; // Invalid stats
+	}
+	// the key range of the filter, in T (it was derived from T-typed keys, so it is representable)
+	const auto key_min = static_cast<T>(bf.ExactMin());
+	const auto key_max = static_cast<T>(bf.ExactMin() + bf.ExactRange());
+	if (max < key_min || min > key_max) {
+		if (filters_null_values || !stats.CanHaveNull()) {
+			return FilterPropagateResult::FILTER_ALWAYS_FALSE;
+		}
+		return FilterPropagateResult::NO_PRUNING_POSSIBLE;
+	}
+	// small ranges: probe every value
+	T range_typed;
+	if (!TrySubtractOperator::Operation(max, min, range_typed) || range_typed > 2048) {
+		return FilterPropagateResult::NO_PRUNING_POSSIBLE;
+	}
+	const auto range = NumericCast<idx_t>(range_typed);
+	T val = min;
+	idx_t hits = 0;
+	for (idx_t i = 0; i <= range; i++) {
+		hits += bf.LookupExact(static_cast<uint64_t>(val));
+		val += i < range; // Avoids potential signed integer overflow on the last iteration
+	}
+	if (hits == 0 && (filters_null_values || !stats.CanHaveNull())) {
+		return FilterPropagateResult::FILTER_ALWAYS_FALSE;
+	}
+	if (hits == range + 1) {
+		// the join itself still discards NULLs, the filter is only a pre-filter
+		return FilterPropagateResult::FILTER_ALWAYS_TRUE;
+	}
+	return FilterPropagateResult::NO_PRUNING_POSSIBLE;
+}
