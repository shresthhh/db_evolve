+//! A bloom filter on dense integer keys can instead be an exact bitmap with one bit per value in [min, max]:
+//! no hashing and no false positives, at a memory cost bounded by (at most) the size of the pointer table
+static constexpr idx_t EXACT_BF_MAX_BITS_PER_KEY = 128;
+static constexpr idx_t EXACT_BF_MAX_RANGE = idx_t(1) << 32;
+
+static void TrySetExactBloomFilter(JoinHashTable &ht, const PhysicalComparisonJoin &op, const Value &min_val,
+                                   const Value &max_val) {
+	auto &bf = ht.GetBloomFilter();
+	if (bf.IsExact() || bf.IsInitialized() || ht.NullValuesAreEqual(0) || ht.Count() == 0) {
+		return;
+	}
+	auto &cond = op.conditions[0];
+	if (cond.comparison != ExpressionType::COMPARE_EQUAL || cond.left->return_type != cond.right->return_type ||
+	    ht.equality_types.empty() || ht.equality_types[0] != cond.right->return_type ||
+	    min_val.IsNull() || max_val.IsNull() || min_val.type() != cond.right->return_type ||
+	    max_val.type() != cond.right->return_type) {
+		return;
+	}
+	uint64_t min_bits;
+	uint64_t max_bits;
+	bool is_signed;
+	switch (cond.right->return_type.InternalType()) {
+	case PhysicalType::INT8:
+	case PhysicalType::INT16:
+	case PhysicalType::INT32:
+	case PhysicalType::INT64:
+		min_bits = static_cast<uint64_t>(min_val.GetValue<int64_t>());
+		max_bits = static_cast<uint64_t>(max_val.GetValue<int64_t>());
+		is_signed = true;
+		break;
+	case PhysicalType::UINT8:
+	case PhysicalType::UINT16:
+	case PhysicalType::UINT32:
+	case PhysicalType::UINT64:
+		min_bits = min_val.GetValue<uint64_t>();
+		max_bits = max_val.GetValue<uint64_t>();
+		is_signed = false;
+		break;
+	default:
+		return;
+	}
+	if (is_signed ? static_cast<int64_t>(max_bits) < static_cast<int64_t>(min_bits) : max_bits < min_bits) {
+		return;
+	}
+	// max >= min, so the difference of two 64-bit values is exact in uint64 arithmetic
+	const uint64_t range = max_bits - min_bits;
+	const auto key_cap = ht.Count() > EXACT_BF_MAX_RANGE ? EXACT_BF_MAX_RANGE : ht.Count() * EXACT_BF_MAX_BITS_PER_KEY;
+	if (range >= MinValue<uint64_t>(EXACT_BF_MAX_RANGE, key_cap)) {
+		return;
+	}
+	bf.SetExactRange(min_bits, range);
+}
