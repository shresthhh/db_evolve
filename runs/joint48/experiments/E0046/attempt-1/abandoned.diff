+	case 64:
+		return CopyStateTemplate<64>(pointers, sel, count, aggr_offset, state_template);
+	default:
+		if (sel.IsSet()) {
+			for (idx_t i = 0; i < count; ++i) {
+				memcpy(pointers[sel.get_index_unsafe(i)] + aggr_offset, state_template, width);
+			}
+		} else {
+			for (idx_t i = 0; i < count; ++i) {
+				memcpy(pointers[i] + aggr_offset, state_template, width);
+			}
+		}
+	}
+}
