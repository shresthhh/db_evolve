+//! Convert a join key value to the value stored in the probe-side column: apply the compression offset (if any),
+//! then cast to the storage type. Returns false if the value cannot be represented in storage.
+static bool JoinFilterValueToStorage(Value &value, const JoinFilterPushdownColumn &column) {
+	if (!value.IsNull() && !column.storage_offset.IsNull()) {
+		Value offset = column.storage_offset;
+		if (!value.DefaultTryCastAs(LogicalType::HUGEINT) || !offset.DefaultTryCastAs(LogicalType::HUGEINT)) {
+			return false;
+		}
+		auto result = HugeIntValue::Get(value);
+		if (!Hugeint::TryAddInPlace(result, HugeIntValue::Get(offset))) {
+			return false;
+		}
+		value = Value::HUGEINT(result);
+	}
+	if (column.storage_type.IsValid() && !value.DefaultTryCastAs(column.storage_type)) {
+		return false;
+	}
+	return true;
+}
+
+//! For equality joins with a moderate number of build keys (too many for an IN-list), push a zonemap-only filter
+//! that is an OR of at most "max_ranges" ranges covering all keys, split at the largest gaps between the keys.
+//! This prunes row groups (and segments) whose min/max fall between the build keys.
+static constexpr idx_t RANGE_SET_MAX_KEYS_PER_RANGE = 64;
+
+static void PushRangeSetFilter(const JoinFilterPushdownFilter &info, JoinHashTable &ht, const PhysicalOperator &op,
+                               idx_t build_idx, const JoinFilterPushdownColumn &column, idx_t filter_col_idx,
+                               idx_t max_ranges) {
+	auto &storage_type = column.storage_type;
+	if (max_ranges < 2 || !storage_type.IsValid() || !storage_type.IsIntegral() ||
+	    storage_type.InternalType() == PhysicalType::INT128 || storage_type.InternalType() == PhysicalType::UINT128) {
+		return;
+	}
+	Vector tuples_addresses(LogicalType::POINTER, ht.Count());
+	Vector build_vector(ht.layout_ptr->GetTypes()[build_idx], ht.Count());
+	auto key_count = ht.ScanKeyColumn(tuples_addresses, build_vector, build_idx);
+	if (key_count == 0) {
+		return;
+	}
+	vector<hugeint_t> keys;
+	keys.reserve(key_count);
+	for (idx_t k = 0; k < key_count; k++) {
+		auto value = build_vector.GetValue(k);
+		if (value.IsNull()) {
+			// NULL keys never match an equality
+			continue;
+		}
+		if (!JoinFilterValueToStorage(value, column) || !value.DefaultTryCastAs(LogicalType::HUGEINT)) {
+			return;
+		}
+		keys.push_back(HugeIntValue::Get(value));
+	}
+	std::sort(keys.begin(), keys.end());
+	keys.erase(std::unique(keys.begin(), keys.end()), keys.end());
+	if (keys.size() < 2) {
+		// the min/max filter is exact already
+		return;
+	}
+
+	// find the (max_ranges - 1) largest gaps between consecutive keys and split the ranges there
+	vector<bool> split_after(keys.size(), false);
+	if (keys.size() <= max_ranges) {
+		std::fill(split_after.begin(), split_after.end(), true);
+	} else {
+		vector<pair<hugeint_t, idx_t>> gaps;
+		gaps.reserve(keys.size() - 1);
+		for (idx_t i = 0; i + 1 < keys.size(); i++) {
+			gaps.emplace_back(keys[i + 1] - keys[i], i);
+		}
+		const auto split_count = max_ranges - 1;
+		std::nth_element(gaps.begin(), gaps.begin() + NumericCast<int64_t>(split_count), gaps.end(),
+		                 [](const pair<hugeint_t, idx_t> &a, const pair<hugeint_t, idx_t> &b) {
+			                 return a.first > b.first || (a.first == b.first && a.second < b.second);
+		                 });
+		for (idx_t i = 0; i < split_count; i++) {
+			split_after[gaps[i].second] = true;
+		}
+	}
+
+	auto or_filter = make_uniq<ConjunctionOrFilter>();
+	idx_t range_start = 0;
+	for (idx_t i = 0; i < keys.size(); i++) {
+		if (!split_after[i] && i + 1 < keys.size()) {
+			continue;
+		}
+		auto lower = Value::HUGEINT(keys[range_start]).DefaultCastAs(storage_type);
+		if (range_start == i) {
+			or_filter->child_filters.push_back(make_uniq<ConstantFilter>(ExpressionType::COMPARE_EQUAL, lower));
+		} else {
+			auto upper = Value::HUGEINT(keys[i]).DefaultCastAs(storage_type);
+			auto and_filter = make_uniq<ConjunctionAndFilter>();
+			and_filter->child_filters.push_back(
+			    make_uniq<ConstantFilter>(ExpressionType::COMPARE_GREATERTHANOREQUALTO, lower));
+			and_filter->child_filters.push_back(
+			    make_uniq<ConstantFilter>(ExpressionType::COMPARE_LESSTHANOREQUALTO, upper));
+			or_filter->child_filters.push_back(std::move(and_filter));
+		}
+		range_start = i + 1;
+	}
+	// zonemap pruning only: evaluating the OR per row would be expensive
+	auto filter = make_uniq<OptionalFilter>(std::move(or_filter));
+	info.dynamic_filters->PushFilter(op, filter_col_idx, std::move(filter));
+}
