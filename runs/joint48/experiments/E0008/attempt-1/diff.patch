+//! Exact mode with a key offset: the bitmap position of a scanned value v is (widen(v) - key_offset - exact_min)
+//! (wrapping). The values [min, max] map to a contiguous (possibly wrapping) arc of positions of length max - min
+template <class T>
+static FilterPropagateResult TemplatedCheckStatisticsExactOffset(const BloomFilter &bf, const BaseStatistics &stats,
+                                                                 bool filters_null_values, uint64_t key_offset) {
+	if (bf.ExactOverflow() || !NumericStats::HasMinMax(stats)) {
+		return FilterPropagateResult::NO_PRUNING_POSSIBLE;
+	}
+	const auto min = NumericStats::GetMin<T>(stats);
+	const auto max = NumericStats::GetMax<T>(stats);
+	if (min > max) {
+		return FilterPropagateResult::NO_PRUNING_POSSIBLE; // Invalid stats
+	}
+	const bool can_prune_all = filters_null_values || !stats.CanHaveNull();
+	// max >= min, so the modular difference of the widened values is the exact (non-negative) difference
+	const uint64_t width = static_cast<uint64_t>(max) - static_cast<uint64_t>(min);
+	const uint64_t start = static_cast<uint64_t>(min) - key_offset - bf.ExactMin();
+	if (start > bf.ExactRange() && width <= NumericLimits<uint64_t>::Maximum() - start) {
+		// the arc [start, start + width] does not wrap and lies entirely after the bitmap
+		return can_prune_all ? FilterPropagateResult::FILTER_ALWAYS_FALSE
+		                     : FilterPropagateResult::NO_PRUNING_POSSIBLE;
+	}
+	if (width > 2048) {
+		return FilterPropagateResult::NO_PRUNING_POSSIBLE;
+	}
+	idx_t hits = 0;
+	for (uint64_t i = 0; i <= width; i++) {
+		hits += bf.LookupExact(static_cast<uint64_t>(min) + i - key_offset);
+	}
+	if (hits == 0 && can_prune_all) {
+		return FilterPropagateResult::FILTER_ALWAYS_FALSE;
+	}
+	if (hits == width + 1) {
+		return FilterPropagateResult::FILTER_ALWAYS_TRUE;
+	}
+	return FilterPropagateResult::NO_PRUNING_POSSIBLE;
+}
