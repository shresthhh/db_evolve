+//! Once the perfect hash table's keys are inserted: fills its exact bloom filter (if any) from the occupied slots and
+//! pushes it to the probe-side scans
+static void PushPerfectHashJoinBloomFilters(ClientContext &context, HashJoinGlobalSinkState &sink) {
+	if (sink.deferred_bloom_filters.empty()) {
+		return;
+	}
+	if (sink.perfect_join_executor->FillExactBloomFilter(context)) {
+		for (auto &entry : sink.deferred_bloom_filters) {
+			sink.op.filter_pushdown->PushBloomFilter(entry.first, *sink.hash_table, sink.op, entry.second);
+		}
+	}
+	sink.deferred_bloom_filters.clear();
+}
