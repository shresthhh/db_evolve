+bool PerfectHashJoinExecutor::FillExactBloomFilter(ClientContext &context) {
+	auto &bf = ht.GetBloomFilter();
+	if (!bf.IsExact() || bf.IsInitialized() || perfect_join_statistics.build_min.IsNull()) {
+		return false;
+	}
+	// the exact bloom filter takes the keys widened to 64 bits. Its range is the min/max of the build keys, which lies
+	// within the perfect HT's range (that can come from the column statistics). Should a key fall outside of it anyway,
+	// the bloom filter overflows and lets everything pass
+	uint64_t min_bits;
+	switch (perfect_join_statistics.build_min.type().InternalType()) {
+	case PhysicalType::INT8:
+	case PhysicalType::INT16:
+	case PhysicalType::INT32:
+	case PhysicalType::INT64:
+		min_bits = static_cast<uint64_t>(perfect_join_statistics.build_min.GetValue<int64_t>());
+		break;
+	case PhysicalType::UINT8:
+	case PhysicalType::UINT16:
+	case PhysicalType::UINT32:
+	case PhysicalType::UINT64:
+		min_bits = perfect_join_statistics.build_min.GetValue<uint64_t>();
+		break;
+	default:
+		return false;
+	}
+	bf.Initialize(context, ht.Count());
+	const auto build_size = perfect_join_statistics.build_range + 1;
+	if (bitmap_build_idx.AllValid()) {
+		for (idx_t slot = 0; slot < build_size; slot++) {
+			bf.InsertExact(min_bits + slot);
+		}
+		return true;
+	}
+	const auto bitmap_data = bitmap_build_idx.GetData();
+	for (idx_t entry_idx = 0; entry_idx < ValidityMask::EntryCount(build_size); entry_idx++) {
+		auto entry = bitmap_data[entry_idx];
+		while (entry) {
+			const auto bit = CountZeros<uint64_t>::Trailing(entry);
+			entry &= entry - 1;
+			const auto slot = entry_idx * ValidityMask::BITS_PER_VALUE + bit;
+			if (slot < build_size) {
+				bf.InsertExact(min_bits + slot);
+			}
+		}
+	}
+	return true;
+}
