+void PerfectAggregateHashTable::AddChunkStaged(const uintptr_t *slots, DataChunk &payload, idx_t count) {
+	// counting sort of the rows by stripe: afterwards stage_offsets[p] is the end of stripe p in the sorted order
+	const auto partition_count = stage_partitions.size();
+	auto offsets = stage_offsets.data();
+	memset(offsets, 0, partition_count * sizeof(idx_t));
+	for (idx_t i = 0; i < count; i++) {
+		offsets[slots[i] >> STAGE_STRIPE_BITS]++;
+	}
+	idx_t total = 0;
+	for (idx_t p = 0; p < partition_count; p++) {
+		auto partition_rows = offsets[p];
+		offsets[p] = total;
+		total += partition_rows;
+	}
+	sel_t sorted_rows[STANDARD_VECTOR_SIZE];
+	uintptr_t sorted_slots[STANDARD_VECTOR_SIZE];
+	for (idx_t i = 0; i < count; i++) {
+		const auto slot = slots[i];
+		const auto pos = offsets[slot >> STAGE_STRIPE_BITS]++;
+		sorted_rows[pos] = UnsafeNumericCast<sel_t>(i);
+		sorted_slots[pos] = slot;
+	}
+
+	// append the rows of every stripe to its staged chunk, flushing the stripe if the staged chunks are full
+	idx_t begin = 0;
+	for (idx_t p = 0; p < partition_count; p++) {
+		const auto end = offsets[p];
+		if (end == begin) {
+			continue;
+		}
+		const auto n = end - begin;
+		auto &partition = stage_partitions[p];
+		if (partition.buffers.empty()) {
+			partition.buffers.push_back(make_uniq<StageBuffer>());
+			if (!payload_types.empty()) {
+				partition.buffers.back()->payload.Initialize(allocator, payload_types);
+			}
+		}
+		if (partition.buffers[partition.used]->payload.size() + n > STANDARD_VECTOR_SIZE) {
+			if (partition.used + 1 < STAGE_BUFFERS_PER_STRIPE) {
+				partition.used++;
+				if (partition.used == partition.buffers.size()) {
+					partition.buffers.push_back(make_uniq<StageBuffer>());
+					if (!payload_types.empty()) {
+						partition.buffers.back()->payload.Initialize(allocator, payload_types);
+					}
+				}
+			} else {
+				FlushStagePartition(p);
+			}
+		}
+		auto &buffer = *partition.buffers[partition.used];
+		const auto offset = buffer.payload.size();
+		SelectionVector part_sel(sorted_rows + begin);
+		for (idx_t c = 0; c < payload.ColumnCount(); c++) {
+			VectorOperations::Copy(payload.data[c], buffer.payload.data[c], part_sel, n, 0, offset);
+		}
+		memcpy(buffer.slots + offset, sorted_slots + begin, n * sizeof(uintptr_t));
+		buffer.payload.SetCardinality(offset + n);
+		begin = end;
+	}
+}
+
+void PerfectAggregateHashTable::FlushStagePartition(idx_t partition_idx) {
+	auto &partition = stage_partitions[partition_idx];
+	if (partition.buffers.empty() || partition.buffers[0]->payload.size() == 0) {
+		return;
+	}
+	auto &target = stage_target ? *stage_target : *this;
+	unique_lock<mutex> guard;
+	if (stage_locks) {
+		guard = unique_lock<mutex>(stage_locks[partition_idx]);
+	}
+	for (idx_t b = 0; b < partition.buffers.size() && b <= partition.used; b++) {
+		auto &buffer = *partition.buffers[b];
+		const auto count = buffer.payload.size();
+		if (count == 0) {
+			continue;
+		}
+		UpdateLazy(target, buffer.slots, buffer.payload, count);
+		buffer.payload.Reset();
+	}
+	partition.used = 0;
+}
+
+void PerfectAggregateHashTable::FlushStaged() {
+	for (idx_t p = 0; p < stage_partitions.size(); p++) {
+		FlushStagePartition(p);
+	}
+}
