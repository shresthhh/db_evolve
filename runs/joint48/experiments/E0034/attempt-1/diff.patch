+bool PerfectAggregateHashTable::SetStageTarget(PerfectAggregateHashTable &target, mutex *stripe_locks,
+                                               ArenaAllocator &arena) {
+	D_ASSERT(lazy_init && target.lazy_init);
+	D_ASSERT(total_groups == target.total_groups && tuple_size == target.tuple_size);
+	if (!use_staging) {
+		return false;
+	}
+	FlushStaged();
+	stage_target = &target;
+	stage_locks = stripe_locks;
+	stage_arena = &arena;
+	return true;
+}
