+bool PerfectHashJoinExecutor::FillExactBloomFilter(ClientContext &context, BloomFilter &bf) {
+	if (!bf.IsExact() || bf.IsInitialized() || build_task_count != 0 || !perfect_join_statistics.is_build_small ||
+	    perfect_join_statistics.build_min.IsNull()) {
+		return false;
+	}
+	// the exact filter is probed with the key widened to 64 bits (sign- or zero-extended), slot i holds (min + i)
+	uint64_t base;
+	switch (ht.equality_types[0].InternalType()) {
+	case PhysicalType::INT8:
+	case PhysicalType::INT16:
+	case PhysicalType::INT32:
+	case PhysicalType::INT64:
+		base = static_cast<uint64_t>(perfect_join_statistics.build_min.GetValue<int64_t>());
+		break;
+	case PhysicalType::UINT8:
+	case PhysicalType::UINT16:
+	case PhysicalType::UINT32:
+	case PhysicalType::UINT64:
+		base = perfect_join_statistics.build_min.GetValue<uint64_t>();
+		break;
+	default:
+		return false;
+	}
+	bf.Initialize(context, ht.Count());
+	const auto build_size = perfect_join_statistics.build_range + 1;
+	const bool all_valid = bitmap_build_idx.AllValid();
+	const auto bitmap_data = bitmap_build_idx.GetData();
+	for (idx_t entry_idx = 0; entry_idx < ValidityMask::EntryCount(build_size); entry_idx++) {
+		auto bits = all_valid ? ~validity_t(0) : bitmap_data[entry_idx];
+		const auto entry_base = entry_idx * ValidityMask::BITS_PER_VALUE;
+		while (bits) {
+			const auto slot = entry_base + CountZeros<uint64_t>::Trailing(bits);
+			bits &= bits - 1;
+			if (slot >= build_size) {
+				break;
+			}
+			bf.InsertExact(base + slot);
+		}
+	}
+	// a key outside of the exact range makes the filter let everything pass, which is still correct
+	return true;
+}
