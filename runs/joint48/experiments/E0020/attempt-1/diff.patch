+//! For a probe column that stores (key + offset) of an integral compression: the offset in 64-bit wraparound
+//! arithmetic, as subtracted from the (sign- or zero-extended) storage value by an exact bloom filter
+static bool GetExactBloomFilterKeyOffset(const JoinFilterPushdownColumn &column, uint64_t &key_offset) {
+	auto &storage_type = column.storage_type;
+	if (column.storage_offset.IsNull() || !storage_type.IsValid() || !storage_type.IsIntegral() ||
+	    GetTypeIdSize(storage_type.InternalType()) > GetTypeIdSize(PhysicalType::INT64)) {
+		return false;
+	}
+	Value offset = column.storage_offset;
+	if (!offset.DefaultTryCastAs(LogicalType::HUGEINT)) {
+		return false;
+	}
+	key_offset = HugeIntValue::Get(offset).lower;
+	return true;
+}
