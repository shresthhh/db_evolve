+//! Pre-filters rows of a flat VARCHAR vector for a substring-style expression filter: rows whose string does not
+//! contain the required literal are decided without evaluating the expression. Non-inlined strings stored back to
+//! back in memory are searched as one run. Returns false if the fast path does not apply.
+bool SubstringPrefilterSelection(Vector &result, idx_t scan_count, SelectionVector &sel, idx_t &s_count,
+                                 const TableFilter &filter, TableFilterState &filter_state) {
+	if (filter.filter_type != TableFilterType::EXPRESSION_FILTER || s_count == 0 ||
+	    result.GetVectorType() != VectorType::FLAT_VECTOR || result.GetType().InternalType() != PhysicalType::VARCHAR ||
+	    scan_count > STANDARD_VECTOR_SIZE || s_count > STANDARD_VECTOR_SIZE) {
+		return false;
+	}
+	SubstringPrefilter prefilter;
+	if (!ExtractSubstringPrefilter(*filter.Cast<ExpressionFilter>().expr, prefilter)) {
+		return false;
+	}
+	auto strings = FlatVector::GetData<string_t>(result);
+	auto &validity = FlatVector::Validity(result);
+
+	// 0 = NULL (never passes), 1 = needs evaluation, 2 = literal absent
+	uint8_t row_state[STANDARD_VECTOR_SIZE];
+	// non-inlined strings in selection order: position in sel and end offset within its run
+	uint32_t long_pos[STANDARD_VECTOR_SIZE];
+	uint32_t long_end[STANDARD_VECTOR_SIZE];
+	idx_t long_count = 0;
+	const char *run_base = nullptr;
+	const char *run_end = nullptr;
+	idx_t run_first = 0;
+
+	const char *needle = prefilter.literal.c_str();
+	const idx_t n = prefilter.literal.size();
+	auto search_run = [&](idx_t first, idx_t end) {
+		if (first >= end) {
+			return;
+		}
+		idx_t cur = first;
+		SearchLiteral(run_base, long_end[end - 1], needle, n, [&](idx_t p) -> idx_t {
+			while (long_end[cur] <= p) {
+				cur++;
+			}
+			idx_t str_end = long_end[cur];
+			if (p + n <= str_end) {
+				// match lies fully inside this string
+				row_state[long_pos[cur]] = 1;
+				cur++;
+				return str_end;
+			}
+			return p + 1;
+		});
+	};
+
+	for (idx_t i = 0; i < s_count; i++) {
+		auto idx = sel.get_index(i);
+		if (!validity.RowIsValid(idx)) {
+			row_state[i] = 0;
+			continue;
+		}
+		auto &str = strings[idx];
+		if (str.IsInlined()) {
+			row_state[i] = 1;
+			continue;
+		}
+		row_state[i] = 2;
+		auto data = str.GetData();
+		auto size = str.GetSize();
+		if (data != run_end || !run_base || idx_t(run_end - run_base) + size > NumericLimits<uint32_t>::Maximum()) {
+			search_run(run_first, long_count);
+			run_base = data;
+			run_first = long_count;
+		}
+		run_end = data + size;
+		long_pos[long_count] = UnsafeNumericCast<uint32_t>(i);
+		long_end[long_count] = UnsafeNumericCast<uint32_t>(run_end - run_base);
+		long_count++;
+	}
+	search_run(run_first, long_count);
+
+	// evaluate the expression only on the rows that may contain the literal
+	SelectionVector candidate_sel(s_count);
+	idx_t candidate_count = 0;
+	for (idx_t i = 0; i < s_count; i++) {
+		if (row_state[i] == 1) {
+			candidate_sel.set_index(candidate_count++, sel.get_index(i));
+		}
+	}
+	idx_t passed_count = candidate_count;
+	if (candidate_count > 0) {
+		UnifiedVectorFormat vdata;
+		result.ToUnifiedFormat(scan_count, vdata);
+		ColumnSegment::FilterSelection(candidate_sel, result, vdata, filter, filter_state, scan_count, passed_count);
+	}
+	if (!prefilter.negated) {
+		// rows without the literal never pass
+		sel.Initialize(candidate_sel);
+		s_count = passed_count;
+		return true;
+	}
+	// negated: rows without the literal pass (unless NULL); candidates pass if the expression accepted them
+	SelectionVector out_sel(s_count);
+	idx_t passed_idx = 0;
+	idx_t out_count = 0;
+	for (idx_t i = 0; i < s_count; i++) {
+		auto idx = sel.get_index(i);
+		if (row_state[i] == 2) {
+			out_sel.set_index(out_count++, idx);
+		} else if (row_state[i] == 1) {
+			if (passed_idx < passed_count && candidate_sel.get_index(passed_idx) == idx) {
+				passed_idx++;
+				out_sel.set_index(out_count++, idx);
+			}
+		}
+	}
+	sel.Initialize(out_sel);
+	s_count = out_count;
+	return true;
+}
