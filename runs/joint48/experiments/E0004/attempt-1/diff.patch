+//! A literal that must occur in every string accepted by a substring-style filter (LIKE with only '%' wildcards,
+//! or contains). "negated" means the filter is the NOT of such a predicate.
+struct SubstringPrefilter {
+	string literal;
+	bool negated = false;
+};
+
+bool ExtractSubstringPrefilter(const Expression &expr, SubstringPrefilter &result) {
+	const Expression *current = &expr;
+	bool negated = false;
+	while (current->GetExpressionType() == ExpressionType::OPERATOR_NOT) {
+		auto &op = current->Cast<BoundOperatorExpression>();
+		if (op.children.size() != 1) {
+			return false;
+		}
+		negated = !negated;
+		current = op.children[0].get();
+	}
+	if (current->GetExpressionClass() != ExpressionClass::BOUND_FUNCTION) {
+		return false;
+	}
+	auto &func = current->Cast<BoundFunctionExpression>();
+	if (func.children.size() != 2 || func.children[0]->GetExpressionType() != ExpressionType::BOUND_REF ||
+	    func.children[1]->GetExpressionType() != ExpressionType::VALUE_CONSTANT ||
+	    func.children[0]->return_type.id() != LogicalTypeId::VARCHAR) {
+		return false;
+	}
+	auto &constant = func.children[1]->Cast<BoundConstantExpression>().value;
+	if (constant.IsNull() || constant.type().id() != LogicalTypeId::VARCHAR) {
+		return false;
+	}
+	auto &pattern = StringValue::Get(constant);
+	auto &name = func.function.name;
+	if (name == "contains") {
+		result.literal = pattern;
+	} else if (name == "~~" || name == "!~~") {
+		if (name == "!~~") {
+			negated = !negated;
+		}
+		// only '%' wildcards: every segment between them must occur literally
+		idx_t best_start = 0, best_len = 0, seg_start = 0;
+		for (idx_t i = 0; i <= pattern.size(); i++) {
+			if (i < pattern.size()) {
+				auto c = pattern[i];
+				if (c == '_' || c == '\\') {
+					return false;
+				}
+				if (c != '%') {
+					continue;
+				}
+			}
+			if (i - seg_start > best_len) {
+				best_start = seg_start;
+				best_len = i - seg_start;
+			}
+			seg_start = i + 1;
+		}
+		result.literal = pattern.substr(best_start, best_len);
+	} else {
+		return false;
+	}
+	result.negated = negated;
+	return result.literal.size() >= 2;
+}
+
+//! Searches buf[0, len) for needle; on_hit(pos) is called for each match and returns the position to resume from
+template <class ON_HIT>
+void SearchLiteral(const char *buf, idx_t len, const char *needle, idx_t n, ON_HIT &&on_hit) {
+	if (len < n) {
+		return;
+	}
+	const idx_t last_pos = len - n;
+	idx_t pos = 0;
+#if defined(__SSE2__)
+	const __m128i first = _mm_set1_epi8(needle[0]);
+	const __m128i last = _mm_set1_epi8(needle[n - 1]);
+	while (pos <= last_pos) {
+		idx_t block;
+		if (last_pos - pos >= 15) {
+			block = pos;
+		} else if (last_pos >= 15) {
+			// overlapping final block instead of a scalar tail
+			block = last_pos - 15;
+		} else {
+			break;
+		}
+		auto f = _mm_loadu_si128(reinterpret_cast<const __m128i *>(buf + block));
+		auto l = _mm_loadu_si128(reinterpret_cast<const __m128i *>(buf + block + n - 1));
+		auto eq = _mm_and_si128(_mm_cmpeq_epi8(f, first), _mm_cmpeq_epi8(l, last));
+		uint32_t mask = static_cast<uint32_t>(_mm_movemask_epi8(eq));
+		mask &= ~0u << (pos - block);
+		const idx_t block_end = block + 16;
+		pos = block_end;
+		while (mask) {
+			idx_t p = block + static_cast<idx_t>(__builtin_ctz(mask));
+			mask &= mask - 1;
+			if (memcmp(buf + p + 1, needle + 1, n - 2) != 0) {
+				continue;
+			}
+			idx_t resume = on_hit(p);
+			if (resume >= block_end) {
+				pos = resume;
+				break;
+			}
+			mask &= ~0u << (resume - block);
+		}
+	}
+#endif
+	while (pos <= last_pos) {
+		if (buf[pos] == needle[0] && buf[pos + n - 1] == needle[n - 1] &&
+		    memcmp(buf + pos + 1, needle + 1, n - 2) == 0) {
+			pos = on_hit(pos);
+		} else {
+			pos++;
+		}
+	}
+}
