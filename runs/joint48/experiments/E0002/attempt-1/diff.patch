+//! Estimate the selectivity of a positive substring / pattern match against a constant string
+//! (contains, LIKE, prefix, suffix). Longer literals are assumed to be more selective.
+//! Returns a negative value if the expression is not such a match.
+static double EstimateStringMatchSelectivity(const Expression &expr) {
+	if (expr.GetExpressionClass() != ExpressionClass::BOUND_FUNCTION) {
+		return -1;
+	}
+	auto &func = expr.Cast<BoundFunctionExpression>();
+	auto &name = func.function.name;
+	bool is_like = name == "~~" || name == "like_escape";
+	bool is_substring = name == "contains" || name == "prefix" || name == "suffix";
+	if (!is_like && !is_substring) {
+		return -1;
+	}
+	if (func.children.size() < 2 || func.children[0]->IsFoldable() ||
+	    func.children[1]->GetExpressionClass() != ExpressionClass::BOUND_CONSTANT) {
+		return -1;
+	}
+	auto &constant = func.children[1]->Cast<BoundConstantExpression>().value;
+	if (constant.IsNull() || constant.type().id() != LogicalTypeId::VARCHAR) {
+		return -1;
+	}
+	auto &pattern = StringValue::Get(constant);
+	idx_t literal_length = 0;
+	for (auto c : pattern) {
+		if (is_like && (c == '%' || c == '_')) {
+			continue;
+		}
+		literal_length++;
+	}
+	double selectivity = RelationStatisticsHelper::DEFAULT_SELECTIVITY *
+	                     std::pow(0.75, double(MinValue<idx_t>(literal_length, 64)));
+	return MaxValue<double>(selectivity, 0.01);
+}
