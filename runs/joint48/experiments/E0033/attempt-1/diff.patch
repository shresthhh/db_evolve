+//! Order-preserving encoding of an integral key as uint64_t (equal keys map to equal codes)
+template <class T>
+static uint64_t ClusteredOrderKey(const T value) {
+	if (std::is_signed<T>::value) {
+		return static_cast<uint64_t>(static_cast<int64_t>(value)) ^ (static_cast<uint64_t>(1) << 63);
+	}
+	return static_cast<uint64_t>(value);
+}
+
+//! Checks that the key column is non-NULL and non-decreasing, and finds the end of the first run of equal keys and the
+//! start of the last run (first_end == count if all keys are equal)
+template <class T>
+static bool FindClusteredRuns(const UnifiedVectorFormat &format, const idx_t count, idx_t &first_end,
+                              idx_t &last_start, uint64_t &min_key, uint64_t &max_key) {
+	const auto data = UnifiedVectorFormat::GetData<T>(format);
+	const auto &sel = *format.sel;
+	if (!format.validity.AllValid()) {
+		for (idx_t i = 0; i < count; i++) {
+			if (!format.validity.RowIsValid(sel.get_index(i))) {
+				return false;
+			}
+		}
+	}
+	const T first = data[sel.get_index(0)];
+	T prev = first;
+	first_end = count;
+	last_start = 0;
+	for (idx_t i = 1; i < count; i++) {
+		const T cur = data[sel.get_index(i)];
+		if (cur != prev) {
+			if (cur < prev) {
+				return false;
+			}
+			if (first_end == count) {
+				first_end = i;
+			}
+			last_start = i;
+			prev = cur;
+		}
+	}
+	min_key = ClusteredOrderKey<T>(first);
+	max_key = ClusteredOrderKey<T>(prev);
+	return true;
+}
+
+//! Sinks a chunk that is sorted on the first group key: the rows of its first and last key go to the boundary HT, the
+//! rows strictly in between go to the main HT. Returns false (and sinks nothing) if the chunk cannot be split
+static bool SinkClustered(ClientContext &context, const RadixPartitionedHashTable &radix_ht,
+                          RadixHTLocalSinkState &lstate, DataChunk &group_chunk, DataChunk &payload_input,
+                          const unsafe_vector<idx_t> &filter) {
+	const auto count = group_chunk.size();
+	if (count == 0) {
+		return true;
+	}
+	if (count > STANDARD_VECTOR_SIZE || lstate.intervals.size() >= RadixHTLocalSinkState::MAX_CLUSTERED_CHUNKS) {
+		return false;
+	}
+	auto &key = group_chunk.data[0];
+	key.ToUnifiedFormat(count, lstate.key_format);
+	idx_t first_end;
+	idx_t last_start;
+	uint64_t min_key;
+	uint64_t max_key;
+	bool sorted;
+	switch (key.GetType().InternalType()) {
+	case PhysicalType::INT8:
+		sorted = FindClusteredRuns<int8_t>(lstate.key_format, count, first_end, last_start, min_key, max_key);
+		break;
+	case PhysicalType::INT16:
+		sorted = FindClusteredRuns<int16_t>(lstate.key_format, count, first_end, last_start, min_key, max_key);
+		break;
+	case PhysicalType::INT32:
+		sorted = FindClusteredRuns<int32_t>(lstate.key_format, count, first_end, last_start, min_key, max_key);
+		break;
+	case PhysicalType::INT64:
+		sorted = FindClusteredRuns<int64_t>(lstate.key_format, count, first_end, last_start, min_key, max_key);
+		break;
+	case PhysicalType::UINT8:
+		sorted = FindClusteredRuns<uint8_t>(lstate.key_format, count, first_end, last_start, min_key, max_key);
+		break;
+	case PhysicalType::UINT16:
+		sorted = FindClusteredRuns<uint16_t>(lstate.key_format, count, first_end, last_start, min_key, max_key);
+		break;
+	case PhysicalType::UINT32:
+		sorted = FindClusteredRuns<uint32_t>(lstate.key_format, count, first_end, last_start, min_key, max_key);
+		break;
+	case PhysicalType::UINT64:
+		sorted = FindClusteredRuns<uint64_t>(lstate.key_format, count, first_end, last_start, min_key, max_key);
+		break;
+	default:
+		return false;
+	}
+	if (!sorted) {
+		return false;
+	}
+
+	if (!lstate.boundary_ht) {
+		lstate.boundary_ht = radix_ht.CreateHT(context, GroupedAggregateHashTable::InitialCapacity(), 0);
+		lstate.slice_groups.InitializeEmpty(group_chunk.GetTypes());
+		lstate.slice_payload.InitializeEmpty(payload_input.GetTypes());
+	}
+	auto &boundary_ht = *lstate.boundary_ht;
+	auto &slice_groups = lstate.slice_groups;
+	auto &slice_payload = lstate.slice_payload;
+
+	if (first_end == count) {
+		// A single key: everything is boundary
+		boundary_ht.AddChunk(group_chunk, payload_input, filter);
+		lstate.boundary_keys.push_back(min_key);
+		return true;
+	}
+
+	// Boundary rows: the first and the last run
+	auto &sel = lstate.boundary_sel;
+	idx_t boundary_count = 0;
+	for (idx_t i = 0; i < first_end; i++) {
+		sel.set_index(boundary_count++, i);
+	}
+	for (idx_t i = last_start; i < count; i++) {
+		sel.set_index(boundary_count++, i);
+	}
+	slice_groups.Slice(group_chunk, sel, boundary_count);
+	slice_payload.Slice(payload_input, sel, boundary_count);
+	boundary_ht.AddChunk(slice_groups, slice_payload, filter);
+	lstate.boundary_keys.push_back(min_key);
+	lstate.boundary_keys.push_back(max_key);
+
+	// Interior rows: a contiguous range with keys strictly in (min_key, max_key)
+	if (first_end < last_start) {
+		for (idx_t c = 0; c < group_chunk.ColumnCount(); c++) {
+			slice_groups.data[c].Slice(group_chunk.data[c], first_end, last_start);
+		}
+		slice_groups.SetCardinality(last_start - first_end);
+		for (idx_t c = 0; c < payload_input.ColumnCount(); c++) {
+			slice_payload.data[c].Slice(payload_input.data[c], first_end, last_start);
+		}
+		slice_payload.SetCardinality(last_start - first_end);
+		lstate.ht->AddChunk(slice_groups, slice_payload, filter);
+		lstate.intervals.emplace_back(min_key, max_key);
+	}
+	return true;
+}
+
+//! Checks that the interior rows of all split chunks are key-disjoint from each other and from all boundary rows
+static bool ClusteredIntervalsDisjoint(vector<pair<uint64_t, uint64_t>> &intervals, const vector<uint64_t> &keys) {
+	std::sort(intervals.begin(), intervals.end());
+	for (idx_t i = 1; i < intervals.size(); i++) {
+		if (intervals[i - 1].second > intervals[i].first) {
+			return false;
+		}
+	}
+	for (const auto &key : keys) {
+		// The only interval that can strictly contain the key is the last one with min < key
+		auto it = std::lower_bound(intervals.begin(), intervals.end(), make_pair(key, uint64_t(0)));
+		if (it == intervals.begin()) {
+			continue;
+		}
+		--it;
+		if (it->first < key && key < it->second) {
+			return false;
+		}
+	}
+	return true;
+}
