+	//! Decode one FSST string into "out", which must have room for 8 bytes per compressed byte
+	static inline idx_t DecodeString(const duckdb_fsst_decoder_t &decoder, const_data_ptr_t in, idx_t in_len,
+	                                 data_ptr_t out) {
+		idx_t pos_in = 0;
+		idx_t pos_out = 0;
+		while (pos_in < in_len) {
+			const uint8_t code = in[pos_in];
+			if (DUCKDB_LIKELY(code != FSST_ESC)) {
+				// every symbol is stored as 8 bytes, of which the first len[code] are valid
+				memcpy(out + pos_out, &decoder.symbol[code], sizeof(uint64_t));
+				pos_out += decoder.len[code];
+				pos_in++;
+			} else {
+				if (pos_in + 1 >= in_len) {
+					throw IOException("Corrupt database file: FSST string ends with an escape code");
+				}
+				out[pos_out++] = in[pos_in + 1];
+				pos_in += 2;
+			}
+		}
+		return pos_out;
+	}
+
+	//! Decompress "count" strings (row index of result j given by get_index(j)) back to back into shared
+	//! allocations of the string heap. Each string's decode is bounded by the remaining space of the allocation,
+	//! which always covers the worst case (8 bytes per code) of all strings still to be decoded in it.
+	template <class GET_INDEX>
+	void DecompressStrings(StringDictionaryContainer dict, data_ptr_t baseptr, const bp_delta_offsets_t &offsets,
+	                       idx_t count, GET_INDEX get_index, string_t *result_data,
+	                       VectorStringBuffer &str_buffer) const {
+		if (all_values_inlined) {
+			for (idx_t j = 0; j < count; j++) {
+				result_data[j] = DecompressString(dict, baseptr, offsets, get_index(j), str_buffer);
+			}
+			return;
+		}
+		// cap on the worst-case decoded size of one shared allocation
+		static constexpr idx_t BATCH_BOUND = 65536;
+		// slack so that the last string of a batch can also use the fast decode loop
+		static constexpr idx_t BATCH_SLACK = 32;
+		auto decoder = static_cast<duckdb_fsst_decoder_t *>(duckdb_fsst_decoder_ptr);
+		idx_t batch_start = 0;
+		while (batch_start < count) {
+			idx_t bound = 0;
+			idx_t batch_end = batch_start;
+			for (; batch_end < count; batch_end++) {
+				idx_t str_bound = idx_t(bitunpack_buffer[offsets.scan_offset + get_index(batch_end)]) * 8;
+				if (batch_end > batch_start && bound + str_bound > BATCH_BOUND) {
+					break;
+				}
+				bound += str_bound;
+			}
+			if (bound == 0) {
+				// only empty strings
+				for (idx_t j = batch_start; j < batch_end; j++) {
+					result_data[j] = string_t(nullptr, 0);
+				}
+				batch_start = batch_end;
+				continue;
+			}
+			const idx_t alloc_len = bound + BATCH_SLACK;
+			auto target = str_buffer.AllocateShrinkableBuffer(alloc_len);
+			idx_t used = 0;
+			for (idx_t j = batch_start; j < batch_end; j++) {
+				auto index = get_index(j);
+				uint32_t str_len = bitunpack_buffer[offsets.scan_offset + index];
+				if (str_len == 0) {
+					result_data[j] = string_t(nullptr, 0);
+					continue;
+				}
+				auto str_ptr = FSSTStorage::FetchStringPointer(
+				    dict, baseptr,
+				    UnsafeNumericCast<int32_t>(delta_decode_buffer[index + offsets.unused_delta_decoded_values]));
+				auto out = target + used;
+				auto decoded_size = DecodeString(*decoder, const_data_ptr_cast(str_ptr), str_len, out);
+				D_ASSERT(decoded_size <= alloc_len - used);
+				// strings that fit inline are copied into the string_t, so their space is reused
+				result_data[j] = string_t(const_char_ptr_cast(out), UnsafeNumericCast<uint32_t>(decoded_size));
+				if (decoded_size > string_t::INLINE_LENGTH) {
+					used += decoded_size;
+				}
+			}
+			str_buffer.FinalizeShrinkableBuffer(target, alloc_len, used);
+			batch_start = batch_end;
+		}
+	}
