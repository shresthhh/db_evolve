+// Adds the bindings of projections that pass through a binding in 'bindings' (post-order, so chains are followed)
+static void PropagateBindingsThroughProjections(const LogicalOperator &op, vector<ColumnBinding> &bindings) {
+	for (auto &child : op.children) {
+		PropagateBindingsThroughProjections(*child, bindings);
+	}
+	if (op.type != LogicalOperatorType::LOGICAL_PROJECTION) {
+		return;
+	}
+	auto &proj = op.Cast<LogicalProjection>();
+	for (idx_t i = 0; i < proj.expressions.size(); i++) {
+		auto &expr = *proj.expressions[i];
+		if (expr.GetExpressionType() != ExpressionType::BOUND_COLUMN_REF) {
+			continue;
+		}
+		auto &binding = expr.Cast<BoundColumnRefExpression>().binding;
+		if (std::find(bindings.begin(), bindings.end(), binding) != bindings.end()) {
+			bindings.emplace_back(proj.table_index, i);
+		}
+	}
+}
+
+static bool SubtreeIsSimpleSelectJoin(const LogicalOperator &op) {
+	switch (op.type) {
+	case LogicalOperatorType::LOGICAL_PROJECTION:
+	case LogicalOperatorType::LOGICAL_FILTER:
+	case LogicalOperatorType::LOGICAL_GET:
+	case LogicalOperatorType::LOGICAL_DELIM_GET:
+		break;
+	case LogicalOperatorType::LOGICAL_COMPARISON_JOIN: {
+		// joins that do not NULL-extend any of their outputs
+		auto &join = op.Cast<LogicalComparisonJoin>();
+		if (join.join_type != JoinType::INNER && join.join_type != JoinType::SEMI) {
+			return false;
+		}
+		break;
+	}
+	default:
+		return false;
+	}
+	for (auto &child : op.children) {
+		if (!SubtreeIsSimpleSelectJoin(*child)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+// The selection on the LHS of a SEMI DelimJoin is normally a reason to keep the join with the DelimGet,
+// because it shrinks the RHS. If the RHS is a plain select/join tree that is joined to the DelimGet with
+// equality conditions only, the plain semi join that remains after deliminating gets the same reduction
+// from join filter pushdown (min/max + Bloom filter on the probe side), without the duplicate elimination.
+// On success, 'non_null_bindings' holds the non-DelimGet side bindings of the join with the DelimGet:
+// RemoveJoinWithDelimGet filters these with IS NOT NULL (all conditions are COMPARE_EQUAL).
+static bool SelectionIsReplaceableByJoinFilter(const DelimCandidate &candidate,
+                                               vector<ColumnBinding> &non_null_bindings) {
+	auto &delim_join = candidate.delim_join;
+	if (delim_join.join_type != JoinType::SEMI || candidate.delim_get_count != 1 || candidate.joins.size() != 1) {
+		return false;
+	}
+	auto &join = candidate.joins[0].join.get()->Cast<LogicalComparisonJoin>();
+	if (join.join_type != JoinType::INNER && join.join_type != JoinType::SEMI) {
+		return false;
+	}
+	if (join.conditions.empty()) {
+		return false;
+	}
+	const idx_t delim_idx = OperatorIsDelimGet(*join.children[0]) ? 0 : 1;
+	for (auto &cond : join.conditions) {
+		if (cond.comparison != ExpressionType::COMPARE_EQUAL ||
+		    cond.left->GetExpressionType() != ExpressionType::BOUND_COLUMN_REF ||
+		    cond.right->GetExpressionType() != ExpressionType::BOUND_COLUMN_REF) {
+			return false;
+		}
+		auto &other_side = delim_idx == 0 ? *cond.right : *cond.left;
+		non_null_bindings.push_back(other_side.Cast<BoundColumnRefExpression>().binding);
+	}
+	return SubtreeIsSimpleSelectJoin(*delim_join.children[1]);
+}
