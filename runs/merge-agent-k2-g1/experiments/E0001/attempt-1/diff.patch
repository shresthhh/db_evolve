+			return false;
+		}
+		bool found = false;
+		for (idx_t k = 0; k < outer_conjuncts.size(); k++) {
+			if (ConjunctEquals(*remapped, outer_conjuncts[k].get())) {
+				conjunct_matched[k] = true;
+				found = true;
+			}
+		}
+		if (!found) {
+			return false;
+		}
+		if (remapped->GetExpressionType() == ExpressionType::COMPARE_EQUAL) {
+			auto &comp = remapped->Cast<BoundComparisonExpression>();
+			for (auto side : {comp.left.get(), comp.right.get()}) {
+				if (side->GetExpressionClass() == ExpressionClass::BOUND_COLUMN_REF) {
+					equality_columns.insert(side->Cast<BoundColumnRefExpression>().binding);
+				}
+			}
+		}
+	}
+	// the remaining outer conjuncts may only restrict the extra tables
+	for (idx_t k = 0; k < outer_conjuncts.size(); k++) {
+		auto &conjunct = outer_conjuncts[k].get();
+		if (conjunct.IsVolatile() || conjunct.HasSubquery()) {
+			return false;
+		}
+		if (!conjunct_matched[k] && !OnlyReferencesTables(conjunct, extra_tables)) {
+			return false;
+		}
+	}
+	// every correlated column belongs to an extra table and is NULL-rejected by an equality
+	vector<unique_ptr<Expression>> partitions;
+	for (auto &col : subquery.binder->correlated_columns) {
+		if (extra_tables.find(col.binding.table_index) == extra_tables.end() ||
+		    equality_columns.find(col.binding) == equality_columns.end()) {
+			return false;
+		}
+		partitions.push_back(make_uniq<BoundColumnRefExpression>(col.name, col.type, col.binding));
+	}
+	auto aggr_child = aggr.children[0]->Copy();
+	if (!Remap(aggr_child)) {
+		return false;
+	}
