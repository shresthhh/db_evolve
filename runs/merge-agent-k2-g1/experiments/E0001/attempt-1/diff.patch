+idx_t RowGroupCollection::GetParallelScanMorselVectors(idx_t total_rows, idx_t row_group_size, idx_t thread_count) {
+	// aim for a few morsels per thread, but never smaller than the minimum morsel size or larger than a row group
+	static constexpr idx_t MORSELS_PER_THREAD = 4;
+	static constexpr idx_t MIN_MORSEL_VECTORS = 4;
+	auto row_group_vectors = MaxValue<idx_t>(1, row_group_size / STANDARD_VECTOR_SIZE);
+	auto total_vectors = (total_rows + STANDARD_VECTOR_SIZE - 1) / STANDARD_VECTOR_SIZE;
+	auto target_morsels = MaxValue<idx_t>(1, thread_count) * MORSELS_PER_THREAD;
+	auto morsel_vectors = (total_vectors + target_morsels - 1) / target_morsels;
+	morsel_vectors = MaxValue<idx_t>(morsel_vectors, MIN_MORSEL_VECTORS);
+	return MinValue<idx_t>(morsel_vectors, row_group_vectors);
