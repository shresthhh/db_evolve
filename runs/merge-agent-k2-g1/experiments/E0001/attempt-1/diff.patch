+//! Map a join key value to the value domain of the probe-side storage column (undoing integral compression if needed)
+static bool CastJoinFilterValueToStorage(Value &value, const JoinFilterPushdownColumn &column) {
+	if (!column.storage_offset.IsNull() && !value.IsNull()) {
+		// the probe expression is (storage_value - offset), so the storage value is (value + offset)
+		Value offset = column.storage_offset;
+		if (!value.DefaultTryCastAs(LogicalType::HUGEINT) || !offset.DefaultTryCastAs(LogicalType::HUGEINT)) {
+			return false;
+		}
+		hugeint_t result;
+		if (!TryAddOperator::Operation(value.GetValue<hugeint_t>(), offset.GetValue<hugeint_t>(), result)) {
+			return false;
+		}
+		value = Value::HUGEINT(result);
+	}
+	if (column.storage_type.IsValid() && !value.DefaultTryCastAs(column.storage_type)) {
+		return false;
+	}
+	return true;
+}
+
