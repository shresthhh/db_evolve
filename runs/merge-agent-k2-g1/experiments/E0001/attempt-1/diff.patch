+	// (6) rewrite: filter(other conjuncts) -> window(min/max over partition) -> filter(subquery conjunct)
+	auto window_index = binder.GenerateTableIndex();
+	auto window_expr = make_uniq<BoundWindowExpression>(ExpressionType::WINDOW_AGGREGATE, aggr.return_type,
+	                                                    make_uniq<AggregateFunction>(aggr.function),
+	                                                    aggr.bind_info ? aggr.bind_info->Copy() : nullptr);
