+		break;
+	case PhysicalType::UINT32:
+		DenseFilterSelection<uint32_t>(sel, vdata, filter, approved_tuple_count);
+		break;
+	case PhysicalType::UINT64:
+		DenseFilterSelection<uint64_t>(sel, vdata, filter, approved_tuple_count);
+		break;
+	case PhysicalType::INT8:
+		DenseFilterSelection<int8_t>(sel, vdata, filter, approved_tuple_count);
+		break;
+	case PhysicalType::INT16:
+		DenseFilterSelection<int16_t>(sel, vdata, filter, approved_tuple_count);
+		break;
+	case PhysicalType::INT32:
+		DenseFilterSelection<int32_t>(sel, vdata, filter, approved_tuple_count);
+		break;
+	case PhysicalType::INT64:
+		DenseFilterSelection<int64_t>(sel, vdata, filter, approved_tuple_count);
+		break;
+	case PhysicalType::INT128:
+		DenseFilterSelection<hugeint_t>(sel, vdata, filter, approved_tuple_count);
+		break;
+	case PhysicalType::UINT128:
+		DenseFilterSelection<uhugeint_t>(sel, vdata, filter, approved_tuple_count);
+		break;
+	case PhysicalType::FLOAT:
+		DenseFilterSelection<float>(sel, vdata, filter, approved_tuple_count);
+		break;
+	case PhysicalType::DOUBLE:
+		DenseFilterSelection<double>(sel, vdata, filter, approved_tuple_count);
+		break;
+	default:
+		throw InternalException("Unsupported type in TryDenseFilterSelection");
+	}
+	return true;
+}
