+template <class T>
+static idx_t TemplatedFilterFlatRuns(const BloomFilter &bf, Vector &keys_v, SelectionVector &sel,
+                                     idx_t &approved_tuple_count, BFTableFilterState &state) {
+	// Keys are flat and NULL-free: hash inline and reuse the lookup result for runs of equal keys
+	const auto keys = FlatVector::GetData<T>(keys_v);
+	idx_t found_count = 0;
+	if (sel.IsSet()) {
+		if (approved_tuple_count == 0) {
+			return 0;
+		}
+		T prev_key = keys[sel.get_index(0)];
+		bool prev_found = bf.LookupOne(Hash<T>(prev_key));
+		for (idx_t i = 0; i < approved_tuple_count; i++) {
+			const auto idx = sel.get_index(i);
+			const T key = keys[idx];
+			if (key != prev_key) {
+				prev_key = key;
+				prev_found = bf.LookupOne(Hash<T>(key));
+			}
+			sel.set_index(found_count, idx);
+			found_count += prev_found;
+		}
+	} else {
+		if (approved_tuple_count == 0) {
+			return 0;
+		}
+		if (state.current_capacity < approved_tuple_count) {
+			state.bf_sel.Initialize(approved_tuple_count);
+			state.hashes_v.Initialize(false, approved_tuple_count);
+			state.current_capacity = approved_tuple_count;
+		}
+		T prev_key = keys[0];
+		bool prev_found = bf.LookupOne(Hash<T>(prev_key));
+		for (idx_t i = 0; i < approved_tuple_count; i++) {
+			const T key = keys[i];
+			if (key != prev_key) {
+				prev_key = key;
+				prev_found = bf.LookupOne(Hash<T>(key));
+			}
+			state.bf_sel.set_index(found_count, i);
+			found_count += prev_found;
+		}
+		if (found_count != approved_tuple_count) {
+			sel.Initialize(state.bf_sel);
+		}
+	}
+	approved_tuple_count = found_count;
+	return found_count;
+}
+
+static bool FlatKeysHaveNoNulls(Vector &keys_v, const SelectionVector &sel, idx_t approved_tuple_count) {
+	auto &validity = FlatVector::Validity(keys_v);
+	if (validity.AllValid()) {
+		return true;
+	}
+	if (!sel.IsSet()) {
+		return validity.CountValid(approved_tuple_count) == approved_tuple_count;
+	}
+	for (idx_t i = 0; i < approved_tuple_count; i++) {
+		if (!validity.RowIsValid(sel.get_index(i))) {
+			return false;
+		}
+	}
+	return true;
+}
