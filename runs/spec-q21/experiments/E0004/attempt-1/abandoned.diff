+// Probe flat, NULL-free integer keys directly. Consecutive equal keys (common for data clustered or sorted on the
+// key) reuse the previous row's hash and lookup result. Equal keys hash identically, so results are unchanged.
+template <class T>
+static idx_t TemplatedLookupRuns(const BloomFilter &bf, const Vector &keys_v, const SelectionVector &sel,
+                                 const idx_t count, SelectionVector &result_sel) {
+	const auto keys = FlatVector::GetData<T>(keys_v);
+	idx_t found_count = 0;
+	if (count == 0) {
+		return 0;
+	}
+	const bool has_sel = sel.IsSet();
+	T prev = keys[has_sel ? sel.get_index(0) : 0];
+	idx_t prev_found = bf.LookupOne(Hash<T>(prev));
+	for (idx_t i = 0; i < count; i++) {
+		const T key = keys[has_sel ? sel.get_index(i) : i];
+		if (key != prev) {
+			prev = key;
+			prev_found = bf.LookupOne(Hash<T>(key));
+		}
+		result_sel.set_index(found_count, i);
+		found_count += prev_found;
+	}
+	return found_count;
+}
+
+static bool TryLookupRuns(const BloomFilter &bf, const Vector &keys_v, const SelectionVector &sel, const idx_t count,
+                          SelectionVector &result_sel, idx_t &found_count) {
+	if (keys_v.GetVectorType() != VectorType::FLAT_VECTOR || !FlatVector::Validity(keys_v).AllValid()) {
+		return false;
+	}
+	switch (keys_v.GetType().InternalType()) {
+	case PhysicalType::INT8:
+		found_count = TemplatedLookupRuns<int8_t>(bf, keys_v, sel, count, result_sel);
+		return true;
+	case PhysicalType::INT16:
+		found_count = TemplatedLookupRuns<int16_t>(bf, keys_v, sel, count, result_sel);
+		return true;
+	case PhysicalType::INT32:
+		found_count = TemplatedLookupRuns<int32_t>(bf, keys_v, sel, count, result_sel);
+		return true;
+	case PhysicalType::INT64:
+		found_count = TemplatedLookupRuns<int64_t>(bf, keys_v, sel, count, result_sel);
+		return true;
+	case PhysicalType::UINT8:
+		found_count = TemplatedLookupRuns<uint8_t>(bf, keys_v, sel, count, result_sel);
+		return true;
+	case PhysicalType::UINT16:
+		found_count = TemplatedLookupRuns<uint16_t>(bf, keys_v, sel, count, result_sel);
+		return true;
+	case PhysicalType::UINT32:
+		found_count = TemplatedLookupRuns<uint32_t>(bf, keys_v, sel, count, result_sel);
+		return true;
+	case PhysicalType::UINT64:
+		found_count = TemplatedLookupRuns<uint64_t>(bf, keys_v, sel, count, result_sel);
+		return true;
+	default:
+		return false;
+	}
+}
