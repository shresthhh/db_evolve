diff --git a/src/execution/operator/join/physical_hash_join.cpp b/src/execution/operator/join/physical_hash_join.cpp
index aed2de0..8ad5daa 100644
--- a/src/execution/operator/join/physical_hash_join.cpp
+++ b/src/execution/operator/join/physical_hash_join.cpp
@@ -770,9 +770,11 @@ bool JoinFilterPushdownInfo::CanUseBloomFilter(const ClientContext &context, opt
 		return false;
 	}
 
-	// bf is only supported for single key joins with equality condition as the Filter API only allows
-	// single-column filters so far
-	const bool can_use_bf = ht->conditions.size() == 1 && cmp == ExpressionType::COMPARE_EQUAL;
+	// bf is only supported for joins with a single equality key as the Filter API only allows single-column
+	// filters so far. The hash table (and thus the bloom filter) only hashes the equality columns, so additional
+	// non-equality conditions do not affect the bloom filter. Equality conditions are always placed first, so the
+	// single equality condition is ht->conditions[0]
+	const bool can_use_bf = ht->equality_predicate_columns.size() == 1 && cmp == ExpressionType::COMPARE_EQUAL;
 
 	// building the bloom filter is costly on the build to make probing faster, so only use it if there are
 	// more probing tuples than build tuples
diff --git a/src/optimizer/join_filter_pushdown_optimizer.cpp b/src/optimizer/join_filter_pushdown_optimizer.cpp
index 0801577..78c411f 100644
--- a/src/optimizer/join_filter_pushdown_optimizer.cpp
+++ b/src/optimizer/join_filter_pushdown_optimizer.cpp
@@ -302,7 +302,9 @@ void JoinFilterPushdownOptimizer::GenerateJoinFilters(LogicalComparisonJoin &joi
 	if (!pushdown_info->probe_info.empty()) {
 		const auto &rhs_child = join.children[1];
 		if (rhs_child->type == LogicalOperatorType::LOGICAL_DELIM_GET) {
-			pushdown_info->build_side_has_filter = IsFiltering(join.children[0]);
+			// the delim get contains the distinct correlated values of the outer query, which are typically a
+			// small subset of the probe side keys - treat it as filtering
+			pushdown_info->build_side_has_filter = true;
 		} else {
 			pushdown_info->build_side_has_filter = IsFiltering(join.children[1]);
 		}
