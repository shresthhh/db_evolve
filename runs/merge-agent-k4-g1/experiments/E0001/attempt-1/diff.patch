+void PerfectAggregateHashTable::FusedUpdate(DataChunk &payload, idx_t count) {
+	// FusedUpdateLoop relies on these numeric values
+	static_assert(uint8_t(FusedAggregateKind::COUNT_STAR) == 0 && uint8_t(FusedAggregateKind::SUM_INT32) == 1 &&
+	                  uint8_t(FusedAggregateKind::SUM_INT64) == 2 && uint8_t(FusedAggregateKind::AVG_INT32) == 3 &&
+	                  uint8_t(FusedAggregateKind::AVG_INT64) == 4,
