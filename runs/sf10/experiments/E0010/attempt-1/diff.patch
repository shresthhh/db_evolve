+	auto &conjunction = bindings[0].get().Cast<BoundConjunctionExpression>();
+	if (conjunction.GetExpressionType() == ExpressionType::CONJUNCTION_OR) {
+		auto derived_filter = DeriveFilter(conjunction);
+		if (!derived_filter) {
+			return nullptr;
+		}
+		// Add the derived expression to the original expression with an AND
+		auto result = make_uniq_base<Expression, BoundConjunctionExpression>(ExpressionType::CONJUNCTION_AND);
+		auto &result_conjunction = result->Cast<BoundConjunctionExpression>();
+		result_conjunction.children.push_back(conjunction.Copy());
+		for (auto &derived : derived_filter->children) {
+			result_conjunction.children.push_back(std::move(derived));
+		}
+		return result;
+	}
+
+	// The root is an AND: derive filters from each of its OR children (e.g., after common terms were factored out)
+	D_ASSERT(conjunction.GetExpressionType() == ExpressionType::CONJUNCTION_AND);
+	vector<unique_ptr<Expression>> new_children;
+	for (auto &child : conjunction.children) {
+		if (child->GetExpressionClass() != ExpressionClass::BOUND_CONJUNCTION ||
+		    child->GetExpressionType() != ExpressionType::CONJUNCTION_OR) {
+			continue;
+		}
+		auto derived_filter = DeriveFilter(child->Cast<BoundConjunctionExpression>());
+		if (!derived_filter) {
+			continue;
+		}
+		for (auto &derived : derived_filter->children) {
+			// Only add derived filters that are not present yet (otherwise the rewriter would never reach a fixpoint)
+			bool exists = false;
+			for (auto &existing : conjunction.children) {
+				if (existing->Equals(*derived)) {
+					exists = true;
+					break;
+				}
+			}
+			for (auto &existing : new_children) {
+				if (exists || existing->Equals(*derived)) {
+					exists = true;
+					break;
+				}
+			}
+			if (!exists) {
+				new_children.push_back(std::move(derived));
+			}
+		}
+	}
+	if (new_children.empty()) {
+		return nullptr;
+	}
+	auto result = conjunction.Copy();
+	auto &result_conjunction = result->Cast<BoundConjunctionExpression>();
+	for (auto &derived : new_children) {
+		result_conjunction.children.push_back(std::move(derived));
 	}
+	changes_made = true;
 	return result;
 }
 
