+void PerfectHashJoinExecutor::PropagateMatches() {
+	if (!slot_matched) {
+		return;
+	}
+	// scan the rows in the same order as FullScanHashTable did
+	auto &data_collection = ht.GetDataCollection();
+	if (data_collection.ChunkCount() > 0) {
+		JoinHTScanState scan_state(data_collection, 0, data_collection.ChunkCount(),
+		                           TupleDataPinProperties::KEEP_EVERYTHING_PINNED);
+		auto &iterator = scan_state.iterator;
+		const auto row_locations = iterator.GetRowLocations();
+		idx_t row_idx = 0;
+		do {
+			const auto count = iterator.GetCurrentChunkCount();
+			for (idx_t i = 0; i < count; i++, row_idx++) {
+				const auto slot = row_slots[row_idx];
+				if (slot != NumericLimits<uint32_t>::Maximum() && slot_matched[slot]) {
+					Store<bool>(true, row_locations[i] + ht.tuple_size);
+				}
+			}
+		} while (iterator.Next());
+		D_ASSERT(row_idx == ht.Count());
+	}
+	slot_matched.reset();
+	row_slots.reset();
+}
