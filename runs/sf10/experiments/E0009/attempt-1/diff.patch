+void JoinHashTable::SetBuildBloomFilter(idx_t cond_idx) {
+	D_ASSERT(cond_idx < conditions.size());
+	if (bloom_filters.size() != conditions.size()) {
+		bloom_filters.resize(conditions.size());
+	}
+	if (!bloom_filters[cond_idx]) {
+		bloom_filters[cond_idx] = make_uniq<BloomFilter>();
+	}
+}
+
+bool JoinHashTable::HasBloomFilter(idx_t cond_idx) const {
+	return cond_idx < bloom_filters.size() && bloom_filters[cond_idx];
+}
+
+idx_t JoinHashTable::BloomFilterCount() const {
+	idx_t result = 0;
+	for (auto &bf : bloom_filters) {
+		result += bf ? 1 : 0;
+	}
+	return result;
+}
+
+BloomFilter &JoinHashTable::GetBloomFilter(idx_t cond_idx) {
+	D_ASSERT(HasBloomFilter(cond_idx));
+	return *bloom_filters[cond_idx];
+}
