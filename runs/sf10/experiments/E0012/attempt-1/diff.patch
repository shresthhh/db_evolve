+static bool OperatorIsDelimGet(LogicalOperator &op);
+
+// Collects the non-DelimGet side bindings of the joins with DelimGets, if all their conditions are plain equalities.
+// RemoveJoinWithDelimGet adds an IS NOT NULL filter on each of these bindings
+static bool CollectEqualityBindings(const vector<JoinWithDelimGet> &joins, vector<ColumnBinding> &bindings) {
+	for (auto &join : joins) {
+		auto &comparison_join = join.join.get()->Cast<LogicalComparisonJoin>();
+		const idx_t delim_idx = OperatorIsDelimGet(*comparison_join.children[0]) ? 0 : 1;
+		for (auto &cond : comparison_join.conditions) {
+			auto &other_side = delim_idx == 0 ? *cond.right : *cond.left;
+			if (cond.comparison != ExpressionType::COMPARE_EQUAL ||
+			    other_side.GetExpressionType() != ExpressionType::BOUND_COLUMN_REF) {
+				return false;
+			}
+			bindings.push_back(other_side.Cast<BoundColumnRefExpression>().binding);
+		}
+	}
+	return true;
+}
+
+// Whether the binding is (a pass-through of) one of the given bindings
+static bool TraceToBinding(const LogicalOperator &op, ColumnBinding binding, const vector<ColumnBinding> &targets) {
+	for (auto &target : targets) {
+		if (target == binding) {
+			return true;
+		}
+	}
+	optional_ptr<const Expression> expr;
+	if (op.type == LogicalOperatorType::LOGICAL_PROJECTION) {
+		auto &proj = op.Cast<LogicalProjection>();
+		if (binding.table_index == proj.table_index && binding.column_index < proj.expressions.size()) {
+			expr = proj.expressions[binding.column_index].get();
+		}
+	} else if (op.type == LogicalOperatorType::LOGICAL_AGGREGATE_AND_GROUP_BY) {
+		auto &aggr = op.Cast<LogicalAggregate>();
+		if (binding.table_index == aggr.group_index && binding.column_index < aggr.groups.size()) {
+			expr = aggr.groups[binding.column_index].get();
+		}
+	}
+	if (expr) {
+		if (expr->GetExpressionType() != ExpressionType::BOUND_COLUMN_REF) {
+			return false;
+		}
+		binding = expr->Cast<BoundColumnRefExpression>().binding;
+	}
+	for (auto &child : op.children) {
+		if (TraceToBinding(*child, binding, targets)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+// Whether the subtree cannot introduce NULLs into columns that are non-NULL in its inputs
+// (no outer joins, no grouping sets, ...)
+static bool PreservesNonNullColumns(const LogicalOperator &op) {
+	switch (op.type) {
+	case LogicalOperatorType::LOGICAL_PROJECTION:
+	case LogicalOperatorType::LOGICAL_FILTER:
+	case LogicalOperatorType::LOGICAL_GET:
+	case LogicalOperatorType::LOGICAL_CROSS_PRODUCT:
+	case LogicalOperatorType::LOGICAL_ORDER_BY:
+	case LogicalOperatorType::LOGICAL_LIMIT:
+	case LogicalOperatorType::LOGICAL_TOP_N:
+	case LogicalOperatorType::LOGICAL_DISTINCT:
+	case LogicalOperatorType::LOGICAL_WINDOW:
+		break;
+	case LogicalOperatorType::LOGICAL_AGGREGATE_AND_GROUP_BY:
+		if (op.Cast<LogicalAggregate>().grouping_sets.size() > 1) {
+			return false;
+		}
+		break;
+	case LogicalOperatorType::LOGICAL_COMPARISON_JOIN:
+		switch (op.Cast<LogicalComparisonJoin>().join_type) {
+		case JoinType::INNER:
+		case JoinType::SEMI:
+		case JoinType::ANTI:
+		case JoinType::RIGHT_SEMI:
+		case JoinType::RIGHT_ANTI:
+			break;
+		default:
+			return false;
+		}
+		break;
+	default:
+		return false;
+	}
+	for (auto &child : op.children) {
+		if (!PreservesNonNullColumns(*child)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+// After all joins with DelimGets were removed with plain equality conditions, an IS NOT NULL filter was added on every
+// correlated column of the RHS. If the RHS cannot re-introduce NULLs, the RHS keys of the (former) delim join are
+// never NULL, so IS NOT DISTINCT FROM is equivalent to = for INNER/SEMI/ANTI joins
+static void TryConvertNotDistinctToEquality(LogicalComparisonJoin &delim_join, const vector<ColumnBinding> &bindings) {
+	switch (delim_join.join_type) {
+	case JoinType::INNER:
+	case JoinType::SEMI:
+	case JoinType::ANTI:
+		break;
+	default:
+		return;
+	}
+	auto &rhs = *delim_join.children[1];
+	if (!PreservesNonNullColumns(rhs)) {
+		return;
+	}
+	for (auto &cond : delim_join.conditions) {
+		if (cond.comparison == ExpressionType::COMPARE_NOT_DISTINCT_FROM &&
+		    cond.right->GetExpressionType() == ExpressionType::BOUND_COLUMN_REF &&
+		    TraceToBinding(rhs, cond.right->Cast<BoundColumnRefExpression>().binding, bindings)) {
+			cond.comparison = ExpressionType::COMPARE_EQUAL;
+		}
+	}
+}
