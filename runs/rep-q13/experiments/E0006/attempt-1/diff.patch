diff --git a/src/storage/compression/fsst.cpp b/src/storage/compression/fsst.cpp
index df16e5f..7b6755a 100644
--- a/src/storage/compression/fsst.cpp
+++ b/src/storage/compression/fsst.cpp
@@ -570,6 +570,66 @@ struct FSSTScanState : public StringScanState {
 			return FSSTPrimitives::DecompressValue(duckdb_fsst_decoder_ptr, str_buffer, str_ptr, str_len);
 		}
 	}
+
+	//! Decompress (non-inlined) strings back-to-back into shared heap allocations. Passing the remaining space of
+	//! the shared allocation as output bound keeps the FSST fast decode loop active up to the end of every string,
+	//! and replaces the per-string allocate/shrink with one per batch.
+	void DecompressStringsBatched(StringDictionaryContainer dict, data_ptr_t baseptr, const bp_delta_offsets_t &offsets,
+	                              const SelectionVector *sel, idx_t count, string_t *result_data,
+	                              VectorStringBuffer &str_buffer) const {
+		// bound the size of a single shared allocation (a single large string may still exceed this)
+		static constexpr idx_t MAX_BATCH_BOUND = 65536;
+		// slack so that the fast decode loop (which needs 32 bytes of room) also covers the last string
+		static constexpr idx_t BATCH_SLACK = 32;
+		const auto decoder = static_cast<duckdb_fsst_decoder_t *>(duckdb_fsst_decoder_ptr);
+		auto &allocator = str_buffer.GetStringAllocator();
+		idx_t i = 0;
+		while (i < count) {
+			// determine the rows of this batch and an upper bound of their decompressed size
+			idx_t bound = BATCH_SLACK;
+			idx_t end = i;
+			for (; end < count; end++) {
+				auto index = sel ? sel->get_index(end) : end;
+				idx_t str_bound = idx_t(bitunpack_buffer[offsets.scan_offset + index]) * 8;
+				if (end > i && bound + str_bound > MAX_BATCH_BOUND) {
+					break;
+				}
+				bound += str_bound;
+			}
+			if (bound == BATCH_SLACK) {
+				// only empty strings
+				for (; i < end; i++) {
+					result_data[i] = string_t(nullptr, 0);
+				}
+				continue;
+			}
+			auto base = str_buffer.AllocateShrinkableBuffer(bound);
+			idx_t pos = 0;
+			for (; i < end; i++) {
+				auto index = sel ? sel->get_index(i) : i;
+				uint32_t str_len = bitunpack_buffer[offsets.scan_offset + index];
+				if (str_len == 0) {
+					result_data[i] = string_t(nullptr, 0);
+					continue;
+				}
+				auto str_ptr = FSSTStorage::FetchStringPointer(
+				    dict, baseptr,
+				    UnsafeNumericCast<int32_t>(delta_decode_buffer[index + offsets.unused_delta_decoded_values]));
+				D_ASSERT(pos + idx_t(str_len) * 8 <= bound);
+				auto target = base + pos;
+				auto decompressed_size = duckdb_fsst_decompress(
+				    decoder, str_len, const_data_ptr_cast(str_ptr), bound - pos, target);
+				D_ASSERT(decompressed_size <= idx_t(str_len) * 8);
+				// for inlined strings the constructor copies the data, so the space can be reused
+				result_data[i] = string_t(const_char_ptr_cast(target), UnsafeNumericCast<uint32_t>(decompressed_size));
+				if (decompressed_size > string_t::INLINE_LENGTH) {
+					pos += decompressed_size;
+				}
+			}
+			// all writes into this allocation are done: release the unused tail
+			allocator.ShrinkHead(bound - pos);
+		}
+	}
 };
 
