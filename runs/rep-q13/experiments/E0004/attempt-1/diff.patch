+//! Extracts a literal that must occur (as a byte substring) in every string for which the filter can be true
+//! (or, if negated, for which the filter can be false). Returns false if the filter is not of a supported shape.
+bool GetRequiredSubstring(const TableFilter &filter, string &needle, bool &negated) {
+	if (filter.filter_type != TableFilterType::EXPRESSION_FILTER) {
+		return false;
+	}
+	auto expr = &filter.Cast<ExpressionFilter>().expr;
+	negated = false;
+	if ((*expr)->GetExpressionType() == ExpressionType::OPERATOR_NOT) {
+		auto &op = (*expr)->Cast<BoundOperatorExpression>();
+		if (op.children.size() != 1) {
+			return false;
+		}
+		negated = true;
+		expr = &op.children[0];
+	}
+	if ((*expr)->GetExpressionClass() != ExpressionClass::BOUND_FUNCTION) {
+		return false;
+	}
+	auto &func = (*expr)->Cast<BoundFunctionExpression>();
+	if (func.children.size() != 2 || func.return_type.id() != LogicalTypeId::BOOLEAN) {
+		return false;
+	}
+	auto &input = *func.children[0];
+	auto &pattern = *func.children[1];
+	if (input.GetExpressionClass() != ExpressionClass::BOUND_REF ||
+	    pattern.GetExpressionClass() != ExpressionClass::BOUND_CONSTANT) {
+		return false;
+	}
+	if (input.return_type.id() != LogicalTypeId::VARCHAR || pattern.return_type.id() != LogicalTypeId::VARCHAR ||
+	    !StringType::GetCollation(input.return_type).empty() || !StringType::GetCollation(pattern.return_type).empty()) {
+		return false;
+	}
+	auto &value = pattern.Cast<BoundConstantExpression>().value;
+	if (value.IsNull() || value.type().id() != LogicalTypeId::VARCHAR) {
+		return false;
+	}
+	auto &str = StringValue::Get(value);
+	auto &name = func.function.name;
+	if (name == "contains") {
+		needle = str;
+	} else if (name == "~~" || name == "!~~") {
+		if (name == "!~~") {
+			negated = !negated;
+		}
+		// only '%' wildcards: every literal segment must occur in a matching string
+		needle.clear();
+		idx_t segment_start = 0;
+		for (idx_t i = 0; i <= str.size(); i++) {
+			if (i < str.size()) {
+				auto ch = str[i];
+				if (ch == '_' || ch == '\0') {
+					return false;
+				}
+				if (ch != '%') {
+					continue;
+				}
+			}
+			if (i - segment_start > needle.size()) {
+				needle = str.substr(segment_start, i - segment_start);
+			}
+			segment_start = i + 1;
+		}
+	} else {
+		return false;
+	}
+	return needle.size() >= 2;
+}
+
+//! Finds the first occurrence of needle (size >= 2) in buf[start, len)
+idx_t FindNeedleInBuffer(const unsigned char *buf, idx_t start, idx_t len, const unsigned char *needle,
+                         idx_t needle_size) {
+	if (len < needle_size || start > len - needle_size) {
+		return DConstants::INVALID_INDEX;
+	}
+	const idx_t last_start = len - needle_size;
+	idx_t i = start;
+#ifdef DUCKDB_SUBSTRING_PREFILTER_SSE2
+	const auto first = _mm_set1_epi8(static_cast<char>(needle[0]));
+	const auto last = _mm_set1_epi8(static_cast<char>(needle[needle_size - 1]));
+	for (; i + 16 <= last_start + 1; i += 16) {
+		auto block_first = _mm_loadu_si128(reinterpret_cast<const __m128i *>(buf + i));
+		auto block_last = _mm_loadu_si128(reinterpret_cast<const __m128i *>(buf + i + needle_size - 1));
+		auto eq = _mm_and_si128(_mm_cmpeq_epi8(block_first, first), _mm_cmpeq_epi8(block_last, last));
+		auto mask = static_cast<uint32_t>(_mm_movemask_epi8(eq));
+		while (mask) {
+			auto bit = static_cast<idx_t>(__builtin_ctz(mask));
+			if (memcmp(buf + i + bit + 1, needle + 1, needle_size - 2) == 0) {
+				return i + bit;
+			}
+			mask &= mask - 1;
+		}
+	}
+#endif
+	if (i > last_start) {
+		return DConstants::INVALID_INDEX;
+	}
+	auto result = FindStrInStr(buf + i, len - i, needle, needle_size);
+	return result == DConstants::INVALID_INDEX ? result : result + i;
+}
