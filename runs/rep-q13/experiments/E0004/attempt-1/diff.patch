+//! Marks the rows of a run of strings stored back-to-back in memory that contain the needle, using one search over
+//! the whole run. run_end[r] is the end offset of row r relative to run_base; hits spanning two rows are rejected.
+void SearchStringRun(const unsigned char *run_base, const idx_t *run_end, const sel_t *run_idx, idx_t run_rows,
+                     const unsigned char *needle, idx_t needle_size, bool *has_needle) {
+	idx_t run_len = run_end[run_rows - 1];
+	idx_t search_pos = 0;
+	idx_t row = 0;
+	while (true) {
+		auto hit = FindNeedleInBuffer(run_base, search_pos, run_len, needle, needle_size);
+		if (hit == DConstants::INVALID_INDEX) {
+			break;
+		}
+		while (run_end[row] <= hit) {
+			row++;
+		}
+		D_ASSERT(row < run_rows);
+		if (hit + needle_size <= run_end[row]) {
+			has_needle[run_idx[row]] = true;
+			search_pos = run_end[row];
+			row++;
+			if (row >= run_rows) {
+				break;
+			}
+		} else {
+			// hit spans multiple rows
+			search_pos = hit + 1;
+		}
+	}
+}
+
+//! Fast path for substring-type filters (LIKE / NOT LIKE / contains) over a flat VARCHAR vector: strings that are
+//! stored back-to-back in memory (e.g. decoded consecutively into the vector's string heap) are searched for a
+//! required literal at once, and the full expression is only evaluated on rows that contain the literal.
+//! Returns false (without modifying anything) if not applicable.
+bool TrySubstringPrefilter(Vector &result, idx_t scan_count, SelectionVector &sel, idx_t &s_count,
+                           const TableFilter &filter, TableFilterState &filter_state) {
+	if (result.GetVectorType() != VectorType::FLAT_VECTOR || scan_count == 0 || scan_count > STANDARD_VECTOR_SIZE ||
+	    s_count == 0 || result.GetType().InternalType() != PhysicalType::VARCHAR) {
+		return false;
+	}
+	string needle;
+	bool negated;
+	if (!GetRequiredSubstring(filter, needle, negated)) {
+		return false;
+	}
+	auto needle_ptr = const_uchar_ptr_cast(needle.c_str());
+	auto needle_size = needle.size();
+	auto &result_validity = FlatVector::Validity(result);
+	auto data = FlatVector::GetData<string_t>(result);
+
+	bool has_needle[STANDARD_VECTOR_SIZE];
+	idx_t run_end[STANDARD_VECTOR_SIZE];
+	sel_t run_idx[STANDARD_VECTOR_SIZE];
+	memset(has_needle, 0, sizeof(bool) * scan_count);
+	const unsigned char *run_base = nullptr;
+	idx_t run_len = 0;
+	idx_t run_rows = 0;
+	for (idx_t i = 0; i < s_count; i++) {
+		auto idx = sel.get_index(i);
+		if (!result_validity.RowIsValid(idx)) {
+			continue;
+		}
+		auto &str = data[idx];
+		auto size = str.GetSize();
+		auto ptr = const_uchar_ptr_cast(str.GetData());
+		if (str.IsInlined()) {
+			if (size >= needle_size && FindStrInStr(ptr, size, needle_ptr, needle_size) != DConstants::INVALID_INDEX) {
+				has_needle[idx] = true;
+			}
+			continue;
+		}
+		if (run_rows > 0 && ptr != run_base + run_len) {
+			SearchStringRun(run_base, run_end, run_idx, run_rows, needle_ptr, needle_size, has_needle);
+			run_rows = 0;
+		}
+		if (run_rows == 0) {
+			run_base = ptr;
+			run_len = 0;
+		}
+		run_len += size;
+		run_end[run_rows] = run_len;
+		run_idx[run_rows] = UnsafeNumericCast<sel_t>(idx);
+		run_rows++;
+	}
+	if (run_rows > 0) {
+		SearchStringRun(run_base, run_end, run_idx, run_rows, needle_ptr, needle_size, has_needle);
+	}
+
+	// split the incoming selection into rows decided without the expression and candidates
+	SelectionVector candidates(STANDARD_VECTOR_SIZE);
+	SelectionVector decided(STANDARD_VECTOR_SIZE);
+	idx_t candidate_count = 0;
+	idx_t decided_count = 0;
+	for (idx_t i = 0; i < s_count; i++) {
+		auto idx = sel.get_index(i);
+		if (has_needle[idx]) {
+			candidates.set_index(candidate_count++, idx);
+		} else if (negated && result_validity.RowIsValid(idx)) {
+			decided.set_index(decided_count++, idx);
+		}
+	}
+	if (candidate_count > 0) {
+		UnifiedVectorFormat vdata;
+		result.ToUnifiedFormat(scan_count, vdata);
+		candidate_count = ColumnSegment::FilterSelection(candidates, result, vdata, filter, filter_state, scan_count,
+		                                                 candidate_count);
+	}
+	// merge both (ascending) lists
+	SelectionVector new_sel(STANDARD_VECTOR_SIZE);
+	idx_t c = 0, d = 0, out = 0;
+	while (c < candidate_count && d < decided_count) {
+		auto cidx = candidates.get_index(c);
+		auto didx = decided.get_index(d);
+		if (cidx < didx) {
+			new_sel.set_index(out++, cidx);
+			c++;
+		} else {
+			new_sel.set_index(out++, didx);
+			d++;
+		}
+	}
+	for (; c < candidate_count; c++) {
+		new_sel.set_index(out++, candidates.get_index(c));
+	}
+	for (; d < decided_count; d++) {
+		new_sel.set_index(out++, decided.get_index(d));
+	}
+	sel.Initialize(new_sel);
+	s_count = out;
+	return true;
+}
