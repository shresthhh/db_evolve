+//! Called when the HT is full before the adaptivity threshold is reached. If the HLL estimate indicates that a larger
+//! HT would deduplicate much better, abandon the HT and grow it (bounded by ADAPTIVITY_THRESHOLD). Returns true if grown.
+//! Unlike DecideAdaptation, this never skips lookups and does not mark the state as adapted.
+bool MaybeGrowEarly(RadixHTGlobalSinkState &gstate, RadixHTLocalSinkState &lstate) {
+	//! Only grow if groups repeat at least this many times on average (otherwise deduplication gains little)
+	static constexpr double EARLY_GROW_MAX_UNIQUE_PERCENTAGE = 0.8;
+	if (lstate.adapted || gstate.external || gstate.number_of_threads <= RadixHTConfig::GROW_STRATEGY_THREAD_THRESHOLD ||
+	    lstate.local_sink_capacity >= RadixHTLocalSinkState::ADAPTIVITY_THRESHOLD) {
+		return false;
+	}
+	auto &ht = *lstate.ht;
+	const auto sink_count = ht.GetSinkCount();
+	const auto hll_count = MinValue(ht.GetHLLUpperBound(), sink_count);
+	if (hll_count <= GroupedAggregateHashTable::ResizeThreshold(lstate.local_sink_capacity)) {
+		return false; // The (estimated) groups fit in the current HT, we're not thrashing
+	}
+	const auto hll_percentage = static_cast<double>(hll_count) / static_cast<double>(sink_count);
+	if (hll_percentage > EARLY_GROW_MAX_UNIQUE_PERCENTAGE) {
+		return false; // Too few duplicates, a larger HT would not deduplicate much better
+	}
+	const auto new_capacity = MinValue(GroupedAggregateHashTable::GetCapacityForCount(hll_count),
+	                                   RadixHTLocalSinkState::ADAPTIVITY_THRESHOLD);
+	if (new_capacity <= lstate.local_sink_capacity) {
+		return false;
+	}
+	lstate.local_sink_capacity = new_capacity;
+	ht.Abandon();
+	ht.Resize(lstate.local_sink_capacity);
+	return true;
+}
