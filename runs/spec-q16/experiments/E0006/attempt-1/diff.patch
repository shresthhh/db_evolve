+template <class T>
+static void ExecuteIntegralConstantIn(const BoundOperatorExpression &expr, Vector &left, idx_t count, Vector &result) {
+	const bool is_in = expr.GetExpressionType() == ExpressionType::COMPARE_IN;
+	const idx_t n = expr.children.size() - 1;
+	T values[64];
+	for (idx_t i = 0; i < n; i++) {
+		values[i] = expr.children[i + 1]->Cast<BoundConstantExpression>().value.GetValueUnsafe<T>();
+	}
+	std::sort(values, values + n);
+	const T min_val = values[0];
+	const T max_val = values[n - 1];
+	// range fits in a small bitmap: use direct bit test, otherwise binary search
+	const uint64_t range = static_cast<uint64_t>(max_val) - static_cast<uint64_t>(min_val);
+	const bool use_bitmap = range < 4096;
+	uint64_t bitmap[64];
+	if (use_bitmap) {
+		memset(bitmap, 0, sizeof(bitmap));
+		for (idx_t i = 0; i < n; i++) {
+			auto off = static_cast<uint64_t>(values[i]) - static_cast<uint64_t>(min_val);
+			bitmap[off >> 6] |= uint64_t(1) << (off & 63);
+		}
+	}
+	auto contains = [&](T v) -> bool {
+		if (v < min_val || v > max_val) {
+			return false;
+		}
+		if (use_bitmap) {
+			auto off = static_cast<uint64_t>(v) - static_cast<uint64_t>(min_val);
+			return (bitmap[off >> 6] >> (off & 63)) & 1;
+		}
+		return std::binary_search(values, values + n, v);
+	};
+
+	if (left.GetVectorType() == VectorType::CONSTANT_VECTOR) {
+		result.SetVectorType(VectorType::CONSTANT_VECTOR);
+		if (ConstantVector::IsNull(left)) {
+			ConstantVector::SetNull(result, true);
+			return;
+		}
+		ConstantVector::SetNull(result, false);
+		auto v = *ConstantVector::GetData<T>(left);
+		ConstantVector::GetData<bool>(result)[0] = contains(v) == is_in;
+		return;
+	}
+	UnifiedVectorFormat ldata;
+	left.ToUnifiedFormat(count, ldata);
+	auto lvalues = UnifiedVectorFormat::GetData<T>(ldata);
+	result.SetVectorType(VectorType::FLAT_VECTOR);
+	auto rdata = FlatVector::GetData<bool>(result);
+	auto &rvalidity = FlatVector::Validity(result);
+	if (ldata.validity.AllValid()) {
+		for (idx_t i = 0; i < count; i++) {
+			rdata[i] = contains(lvalues[ldata.sel->get_index(i)]) == is_in;
+		}
+	} else {
+		for (idx_t i = 0; i < count; i++) {
+			auto idx = ldata.sel->get_index(i);
+			if (ldata.validity.RowIsValid(idx)) {
+				rdata[i] = contains(lvalues[idx]) == is_in;
+			} else {
+				rdata[i] = false;
+				rvalidity.SetInvalid(i);
+			}
+		}
+	}
+}
+
+// Fast path for "x [NOT] IN (c1, ..., cn)" where x is integral and all c_i are non-NULL constants of the same type
+static bool TryExecuteIntegralConstantIn(const BoundOperatorExpression &expr, Vector &left, idx_t count,
+                                         Vector &result) {
+	const idx_t n = expr.children.size() - 1;
+	if (n < 1 || n > 64 || result.GetType().id() != LogicalTypeId::BOOLEAN) {
+		return false;
+	}
+	auto &left_type = expr.children[0]->return_type;
+	if (left.GetType() != left_type) {
+		return false;
+	}
+	for (idx_t i = 1; i < expr.children.size(); i++) {
+		auto &child = *expr.children[i];
+		if (child.GetExpressionClass() != ExpressionClass::BOUND_CONSTANT || child.return_type != left_type ||
+		    child.Cast<BoundConstantExpression>().value.IsNull()) {
+			return false;
+		}
+	}
+	switch (left_type.InternalType()) {
+	case PhysicalType::INT8:
+		ExecuteIntegralConstantIn<int8_t>(expr, left, count, result);
+		return true;
+	case PhysicalType::INT16:
+		ExecuteIntegralConstantIn<int16_t>(expr, left, count, result);
+		return true;
+	case PhysicalType::INT32:
+		ExecuteIntegralConstantIn<int32_t>(expr, left, count, result);
+		return true;
+	case PhysicalType::INT64:
+		ExecuteIntegralConstantIn<int64_t>(expr, left, count, result);
+		return true;
+	case PhysicalType::UINT8:
+		ExecuteIntegralConstantIn<uint8_t>(expr, left, count, result);
+		return true;
+	case PhysicalType::UINT16:
+		ExecuteIntegralConstantIn<uint16_t>(expr, left, count, result);
+		return true;
+	case PhysicalType::UINT32:
+		ExecuteIntegralConstantIn<uint32_t>(expr, left, count, result);
+		return true;
+	case PhysicalType::UINT64:
+		ExecuteIntegralConstantIn<uint64_t>(expr, left, count, result);
+		return true;
+	default:
+		return false;
+	}
+}
