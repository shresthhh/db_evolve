+//! Before the adaptivity threshold is reached, decide (reversibly) after every abandoned HT fill whether lookups are
+//! worth doing. If both the HLL estimate and the actual deduplication so far say almost every row is unique, we skip
+//! lookups and just append - the deduplication is done in the finalize phase anyway. Must be called right after Abandon
+bool IsNearUnique(GroupedAggregateHashTable &ht) {
+	static constexpr double SKIP_LOOKUP_UNIQUE_PERCENTAGE_THRESHOLD = 0.95;
+	const auto sink_count = ht.GetSinkCount();
+	if (sink_count == 0 || !ht.HLLEnabled()) {
+		return false;
+	}
+	const auto hll_count = MinValue(ht.GetHLLUpperBound(), sink_count);
+	const auto materialized_count = ht.GetMaterializedCount();
+	const auto hll_percentage = static_cast<double>(hll_count) / static_cast<double>(sink_count);
+	const auto materialized_percentage = static_cast<double>(materialized_count) / static_cast<double>(sink_count);
+	return hll_percentage > SKIP_LOOKUP_UNIQUE_PERCENTAGE_THRESHOLD &&
+	       materialized_percentage > SKIP_LOOKUP_UNIQUE_PERCENTAGE_THRESHOLD;
+}
+
+void DecideEarlyAdaptation(GroupedAggregateHashTable &ht) {
+	D_ASSERT(ht.Count() == 0);
+	if (IsNearUnique(ht)) {
+		ht.SkipLookups();
+	} else if (ht.LookupsSkipped()) {
+		ht.EnableLookups();
+	}
+}
