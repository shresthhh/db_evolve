+	    ht.GetSinkCount() >= RadixHTLocalSinkState::EARLY_ADAPTIVITY_THRESHOLD) {
+		// Check once, early during the first HT fill, so near-unique data doesn't have to wait for the first abandon
+		lstate.early_checked = true;
