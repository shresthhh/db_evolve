+
+	// With many groups, partition the distinct HTs on the hash of the group columns only (which are the first
+	// columns of the distinct HTs). Every distinct partition then holds complete groups, so re-aggregating the
+	// distinct tuples into the main HT sees far fewer groups per task. With few groups, this would skew partitions.
+	static constexpr idx_t DISTINCT_PARTITION_ON_GROUPS_MIN_CARDINALITY = 4096;
+	if (estimated_cardinality >= DISTINCT_PARTITION_ON_GROUPS_MIN_CARDINALITY) {
+		for (idx_t i = 0; i < groupings.size(); i++) {
+			auto &distinct_data = groupings[i].distinct_data;
+			if (!distinct_data || grouping_sets[i].empty()) {
+				continue;
+			}
+			for (auto &radix_table : distinct_data->radix_tables) {
+				if (radix_table) {
+					radix_table->partition_key_count = grouping_sets[i].size();
+				}
+			}
+		}
+	}
 }
 
