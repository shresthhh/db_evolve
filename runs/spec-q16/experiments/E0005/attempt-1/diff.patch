+void GroupedAggregateHashTable::SetPartitionKeyCount(idx_t count_p) {
+	D_ASSERT(Count() == 0);
+	// Only useful if the partition key is a strict prefix of the group columns
+	partition_key_count = count_p < layout_ptr->ColumnCount() - 1 ? count_p : 0;
+}
+
+void GroupedAggregateHashTable::HashGroups(DataChunk &groups, Vector &hashes) {
+	groups.Hash(hashes);
+	if (partition_key_count == 0) {
+		return;
+	}
+	D_ASSERT(partition_key_count < groups.ColumnCount());
+	if (!partition_key_hashes) {
+		partition_key_hashes = make_uniq<Vector>(LogicalType::HASH);
+	}
+	auto &key_hashes = *partition_key_hashes;
+	const auto count = groups.size();
+	// Same hash function (and column order) as DataChunk::Hash on the key columns
+	VectorOperations::Hash(groups.data[0], key_hashes, count);
+	for (idx_t col_idx = 1; col_idx < partition_key_count; col_idx++) {
+		VectorOperations::CombineHash(key_hashes, groups.data[col_idx], count);
+	}
+	hashes.Flatten(count);
+	key_hashes.Flatten(count);
+	// Splice the radix bits of the key hash into the full hash, so that all rows of a key end up in the same
+	// partition. Salt and pointer table bits keep coming from the full hash.
+	static constexpr hash_t RADIX_MASK = RadixPartitioning::Mask(RadixPartitioning::MAX_RADIX_BITS);
+	auto hash_data = FlatVector::GetData<hash_t>(hashes);
+	const auto key_hash_data = FlatVector::GetData<hash_t>(key_hashes);
+	for (idx_t i = 0; i < count; i++) {
+		hash_data[i] = (hash_data[i] & ~RADIX_MASK) | (key_hash_data[i] & RADIX_MASK);
+	}
+}
