+	case PhysicalType::INT32:
+		return InsertExactBloomFilterKeys<int32_t>(bloom_filter, row_locations, count, key_offset, column_count);
+	case PhysicalType::INT64:
+		return InsertExactBloomFilterKeys<int64_t>(bloom_filter, row_locations, count, key_offset, column_count);
+	case PhysicalType::UINT8:
+		return InsertExactBloomFilterKeys<uint8_t>(bloom_filter, row_locations, count, key_offset, column_count);
+	case PhysicalType::UINT16:
+		return InsertExactBloomFilterKeys<uint16_t>(bloom_filter, row_locations, count, key_offset, column_count);
+	case PhysicalType::UINT32:
+		return InsertExactBloomFilterKeys<uint32_t>(bloom_filter, row_locations, count, key_offset, column_count);
