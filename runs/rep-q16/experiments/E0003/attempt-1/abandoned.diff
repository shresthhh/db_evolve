+void PerfectHashJoinExecutor::FillBloomFilter(ClientContext &context, const LogicalType &key_type) {
+	auto &bloom_filter = ht.GetBloomFilter();
+	bloom_filter.Initialize(context, ht.Count());
+
+	Vector tuples_addresses(LogicalType::POINTER, ht.Count());
+	Vector build_vector(key_type, ht.Count());
+	const auto key_count = ht.ScanKeyColumn(tuples_addresses, build_vector, 0);
+
+	// Same hash as the one used by the BF table filter on the probe side
+	Vector hashes(LogicalType::HASH, STANDARD_VECTOR_SIZE);
+	for (idx_t offset = 0; offset < key_count; offset += STANDARD_VECTOR_SIZE) {
+		const auto end = MinValue<idx_t>(offset + STANDARD_VECTOR_SIZE, key_count);
+		Vector slice(build_vector, offset, end);
+		VectorOperations::Hash(slice, hashes, end - offset);
+		hashes.Flatten(end - offset);
+		bloom_filter.InsertHashes(hashes, end - offset);
+	}
+}
