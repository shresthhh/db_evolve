+//! Whether "expr" is "col IN (c1, ..., cn)" with a short list of non-NULL constants that cannot throw
+static bool IsPushableConstantInList(const Expression &expr) {
+	static constexpr idx_t MAX_IN_LIST_SCAN_FILTER = 64;
+	if (expr.type != ExpressionType::COMPARE_IN || expr.IsVolatile() || expr.CanThrow()) {
+		return false;
+	}
+	auto &in_expr = expr.Cast<BoundOperatorExpression>();
+	if (in_expr.children.size() < 2 || in_expr.children.size() > MAX_IN_LIST_SCAN_FILTER + 1) {
+		return false;
+	}
+	if (in_expr.children[0]->type != ExpressionType::BOUND_COLUMN_REF) {
+		return false;
+	}
+	for (idx_t i = 1; i < in_expr.children.size(); i++) {
+		auto &child = *in_expr.children[i];
+		if (child.type != ExpressionType::VALUE_CONSTANT || child.Cast<BoundConstantExpression>().value.IsNull()) {
+			return false;
+		}
+	}
+	return true;
+}
