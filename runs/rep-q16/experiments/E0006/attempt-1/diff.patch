+//! Maximum number of bits per build-side row for an exact (one bit per key) bloom filter
+static constexpr idx_t EXACT_BF_MAX_BITS_PER_ROW = 128;
+//! Maximum size of an exact bloom filter (512 MiB, same as the maximum size of the hashed bloom filter)
+static constexpr idx_t EXACT_BF_MAX_BITS = idx_t(1) << 32;
+
+//! If the (single) join key is an integer whose build-side [min, max] range is dense enough, the bloom filter
+//! becomes an exact bitmap over that range: probing is a bit test instead of hashing, without false positives
+static void TrySetExactBloomFilter(JoinHashTable &ht, const Value &min_val, const Value &max_val) {
+	auto &bf = ht.GetBloomFilter();
+	if (bf.IsExact() || bf.IsInitialized() || ht.conditions.size() != 1 || ht.NullValuesAreEqual(0)) {
+		return;
+	}
+	const auto &key_type = ht.conditions[0].right->return_type;
+	if (key_type != ht.conditions[0].left->return_type || min_val.IsNull() || max_val.IsNull() ||
+	    min_val.type() != key_type || max_val.type() != key_type) {
+		return;
+	}
+	uint64_t min_key;
+	uint64_t max_key;
+	switch (key_type.InternalType()) {
+	case PhysicalType::INT8:
+	case PhysicalType::INT16:
+	case PhysicalType::INT32:
+	case PhysicalType::INT64:
+		min_key = static_cast<uint64_t>(min_val.GetValue<int64_t>());
+		max_key = static_cast<uint64_t>(max_val.GetValue<int64_t>());
+		break;
+	case PhysicalType::UINT8:
+	case PhysicalType::UINT16:
+	case PhysicalType::UINT32:
+	case PhysicalType::UINT64:
+		min_key = min_val.GetValue<uint64_t>();
+		max_key = max_val.GetValue<uint64_t>();
+		break;
+	default:
+		return;
+	}
+	const uint64_t range = max_key - min_key; // max >= min, so this is the exact (non-negative) difference
+	const auto max_bits = MinValue<idx_t>(EXACT_BF_MAX_BITS, ht.Count() * EXACT_BF_MAX_BITS_PER_ROW);
+	if (range >= max_bits) {
+		return;
+	}
+	bf.SetExactRange(min_key, range + 1);
+}
