+template <class T>
+static idx_t TemplatedExactLookup(const BloomFilter &bf, const UnifiedVectorFormat &format, idx_t count,
+                                  SelectionVector &result_sel) {
+	const auto data = UnifiedVectorFormat::GetData<T>(format);
+	idx_t found_count = 0;
+	if (format.validity.AllValid()) {
+		for (idx_t i = 0; i < count; i++) {
+			result_sel.set_index(found_count, i);
+			found_count += bf.LookupKey(ExactKey(data[format.sel->get_index(i)]));
+		}
+	} else {
+		for (idx_t i = 0; i < count; i++) {
+			const auto idx = format.sel->get_index(i);
+			result_sel.set_index(found_count, i);
+			// NULLs never pass: exact mode is only used for filters that reject NULLs
+			found_count += format.validity.RowIsValid(idx) && bf.LookupKey(ExactKey(data[idx]));
+		}
+	}
+	return found_count;
+}
