+template <class T>
+static inline bool LookupValue(const BloomFilter &bf, const T &value) {
+	return bf.LookupOne(Hash(value));
+}
+
+template <class T>
+static inline bool ExactLookupValue(const BloomFilter &bf, const T &value) {
+	return bf.LookupKey(ExactKey(value));
+}
+
 bool BFTableFilter::FilterValue(const Value &value) const {
+	if (filter.IsExact()) {
+		if (value.IsNull()) {
+			return false;
+		}
+		switch (value.type().InternalType()) {
+		case PhysicalType::INT8:
+			return ExactLookupValue(filter, value.GetValueUnsafe<int8_t>());
+		case PhysicalType::INT16:
+			return ExactLookupValue(filter, value.GetValueUnsafe<int16_t>());
+		case PhysicalType::INT32:
+			return ExactLookupValue(filter, value.GetValueUnsafe<int32_t>());
+		case PhysicalType::INT64:
+			return ExactLookupValue(filter, value.GetValueUnsafe<int64_t>());
+		case PhysicalType::UINT8:
+			return ExactLookupValue(filter, value.GetValueUnsafe<uint8_t>());
+		case PhysicalType::UINT16:
+			return ExactLookupValue(filter, value.GetValueUnsafe<uint16_t>());
+		case PhysicalType::UINT32:
+			return ExactLookupValue(filter, value.GetValueUnsafe<uint32_t>());
+		case PhysicalType::UINT64:
+			return ExactLookupValue(filter, value.GetValueUnsafe<uint64_t>());
+		default:
+			return true; // cannot decide, let it pass
+		}
+	}
 	const auto hash = value.Hash();
 	return filter.LookupOne(hash);
 }
 
