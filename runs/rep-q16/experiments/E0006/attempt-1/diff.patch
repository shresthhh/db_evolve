+
+template <class T>
+static inline typename std::enable_if<std::is_integral<T>::value, uint64_t>::type ExactKey(T value) {
+	// sign-extend signed types, so that the wrap-around difference to the minimum is the exact offset
+	return std::is_signed<T>::value ? static_cast<uint64_t>(static_cast<int64_t>(value))
+	                                : static_cast<uint64_t>(value);
+}
+
+template <class T>
+static inline typename std::enable_if<!std::is_integral<T>::value, uint64_t>::type ExactKey(T) {
+	throw InternalException("Unsupported type for exact bloom filter");
+}
+
+template <class T>
+static void TemplatedInsertKeysFromRows(uint64_t *bf, uint64_t exact_min, idx_t exact_bits,
+                                        const data_ptr_t row_locations[],
+                                        idx_t count, idx_t key_offset, idx_t col_idx, idx_t column_count) {
+	idx_t entry_idx;
+	idx_t idx_in_entry;
+	TemplatedValidityMask<uint8_t>::GetEntryIndex(col_idx, entry_idx, idx_in_entry);
+	for (idx_t i = 0; i < count; i++) {
+		const auto row = row_locations[i];
+		TemplatedValidityMask<uint8_t> row_mask(row, column_count);
+		if (!TemplatedValidityMask<uint8_t>::RowIsValid(row_mask.GetValidityEntryUnsafe(entry_idx), idx_in_entry)) {
+			continue; // NULL keys never match: exact mode is only used when the filter rejects NULLs
+		}
+		const uint64_t offset = ExactKey(Load<T>(row + key_offset)) - exact_min;
+		if (offset >= exact_bits) {
+			throw InternalException("Exact bloom filter key outside of the build-side min/max range");
+		}
+		std::atomic<uint64_t> &slot = *reinterpret_cast<std::atomic<uint64_t> *>(&bf[offset >> 6]);
+		const uint64_t mask = 1ULL << (offset & 63);
+		if (!(slot.load(std::memory_order_relaxed) & mask)) {
+			slot.fetch_or(mask, std::memory_order_relaxed);
+		}
+	}
+}
+
+void BloomFilter::InsertKeysFromRows(PhysicalType type, const data_ptr_t row_locations[], idx_t count,
+                                     idx_t key_offset, idx_t col_idx, idx_t column_count) const {
+	D_ASSERT(initialized && exact);
+#define EXACT_INSERT(T)                                                                                                \
+	return TemplatedInsertKeysFromRows<T>(bf, exact_min, exact_bits, row_locations, count, key_offset, col_idx,        \
+	                                      column_count)
+	switch (type) {
+	case PhysicalType::INT8:
+		EXACT_INSERT(int8_t);
+	case PhysicalType::INT16:
+		EXACT_INSERT(int16_t);
+	case PhysicalType::INT32:
+		EXACT_INSERT(int32_t);
+	case PhysicalType::INT64:
+		EXACT_INSERT(int64_t);
+	case PhysicalType::UINT8:
+		EXACT_INSERT(uint8_t);
+	case PhysicalType::UINT16:
+		EXACT_INSERT(uint16_t);
+	case PhysicalType::UINT32:
+		EXACT_INSERT(uint32_t);
+	case PhysicalType::UINT64:
+		EXACT_INSERT(uint64_t);
+#undef EXACT_INSERT
+	default:
+		throw InternalException("Unsupported type for exact bloom filter");
+	}
+}
