+idx_t BFTableFilter::ExactLookup(Vector &keys_v, const SelectionVector &sel, const idx_t approved_count,
+                                 BFTableFilterState &state) const {
+	UnifiedVectorFormat format;
+	if (sel.IsSet()) {
+		state.keys_sliced_v.Slice(keys_v, sel, approved_count);
+		state.keys_sliced_v.ToUnifiedFormat(approved_count, format);
+	} else {
+		keys_v.ToUnifiedFormat(approved_count, format);
+	}
+	switch (keys_v.GetType().InternalType()) {
+	case PhysicalType::INT8:
+		return TemplatedExactLookup<int8_t>(filter, format, approved_count, state.bf_sel);
+	case PhysicalType::INT16:
+		return TemplatedExactLookup<int16_t>(filter, format, approved_count, state.bf_sel);
+	case PhysicalType::INT32:
+		return TemplatedExactLookup<int32_t>(filter, format, approved_count, state.bf_sel);
+	case PhysicalType::INT64:
+		return TemplatedExactLookup<int64_t>(filter, format, approved_count, state.bf_sel);
+	case PhysicalType::UINT8:
+		return TemplatedExactLookup<uint8_t>(filter, format, approved_count, state.bf_sel);
+	case PhysicalType::UINT16:
+		return TemplatedExactLookup<uint16_t>(filter, format, approved_count, state.bf_sel);
+	case PhysicalType::UINT32:
+		return TemplatedExactLookup<uint32_t>(filter, format, approved_count, state.bf_sel);
+	case PhysicalType::UINT64:
+		return TemplatedExactLookup<uint64_t>(filter, format, approved_count, state.bf_sel);
+	default:
+		throw InternalException("Unsupported type for exact bloom filter");
+	}
+}
