+bool SubqueryToWindowRewriter::TryRewrite(unique_ptr<Expression> &condition, unique_ptr<LogicalOperator> &root) {
+	if (!condition->HasSubquery()) {
+		return false;
+	}
+	// (1) find exactly one conjunct holding exactly one correlated scalar subquery
+	vector<unique_ptr<Expression> *> conjuncts;
+	CollectConjuncts(condition, conjuncts);
+	optional_idx subquery_conjunct;
+	optional_ptr<unique_ptr<Expression>> subquery_ptr;
+	for (idx_t i = 0; i < conjuncts.size(); i++) {
+		auto &conjunct = *conjuncts[i];
+		if (conjunct->IsVolatile()) {
+			return false;
+		}
+		if (!conjunct->HasSubquery()) {
+			continue;
+		}
+		idx_t count = 0;
+		auto found = FindSubquery(conjunct, count);
+		if (subquery_conjunct.IsValid() || count != 1 || !found) {
+			return false;
+		}
+		subquery_conjunct = i;
+		subquery_ptr = found;
