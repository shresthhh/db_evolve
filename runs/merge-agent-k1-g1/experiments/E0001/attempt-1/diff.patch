+//! Rewrites a WHERE conjunct "... (SELECT min/max(x) FROM <subset of the outer FROM> WHERE <subset of the outer
+//! conjuncts> AND <equalities on outer columns>) ..." into a window aggregate over the outer join, partitioned by the
+//! correlated outer columns. This is valid when the tables of the subquery map onto distinct outer tables, every
+//! subquery conjunct is also an outer conjunct, and the remaining ("extra") outer tables and conjuncts only connect
+//! to the subquery tables through the correlated columns: then the rows of a partition are copies of the rows the
+//! subquery aggregates over, and MIN/MAX is insensitive to duplicates.
+class SubqueryToWindowRewriter {
+public:
+	explicit SubqueryToWindowRewriter(Binder &binder) : binder(binder) {
+	}
+
+	bool TryRewrite(unique_ptr<Expression> &condition, unique_ptr<LogicalOperator> &root);
+
+private:
+	static void CollectConjuncts(unique_ptr<Expression> &expr, vector<unique_ptr<Expression> *> &out) {
+		if (expr->GetExpressionType() == ExpressionType::CONJUNCTION_AND) {
+			for (auto &child : expr->Cast<BoundConjunctionExpression>().children) {
+				CollectConjuncts(child, out);
+			}
+			return;
+		}
+		out.push_back(&expr);
+	}
+	static bool CollectJoinTree(LogicalOperator &op, vector<reference<LogicalGet>> &gets,
+	                            vector<reference<Expression>> &conjuncts) {
+		switch (op.type) {
+		case LogicalOperatorType::LOGICAL_GET:
+			gets.push_back(op.Cast<LogicalGet>());
+			return true;
+		case LogicalOperatorType::LOGICAL_CROSS_PRODUCT:
+			return CollectJoinTree(*op.children[0], gets, conjuncts) && CollectJoinTree(*op.children[1], gets, conjuncts);
+		case LogicalOperatorType::LOGICAL_FILTER: {
+			auto &filter = op.Cast<LogicalFilter>();
+			if (!filter.projection_map.empty()) {
+				return false;
+			}
+			for (auto &expr : filter.expressions) {
+				conjuncts.push_back(*expr);
+			}
+			return CollectJoinTree(*op.children[0], gets, conjuncts);
+		}
+		default:
+			return false;
+		}
+	}
+	static bool OnlyReferencesTables(const Expression &expr, const unordered_set<idx_t> &tables) {
+		if (expr.GetExpressionClass() == ExpressionClass::BOUND_SUBQUERY) {
