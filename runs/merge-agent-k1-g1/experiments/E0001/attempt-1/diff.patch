+			auto &colref = expr.Cast<BoundColumnRefExpression>();
+			return colref.depth == 0 && tables.find(colref.binding.table_index) != tables.end();
+		}
+		bool result = true;
+		ExpressionIterator::EnumerateChildren(expr, [&](const Expression &child) {
+			if (!OnlyReferencesTables(child, tables)) {
