+	}
+	static bool ConjunctEquals(const Expression &a, const Expression &b) {
+		if (a.Equals(b)) {
+			return true;
+		}
+		if (a.GetExpressionClass() != ExpressionClass::BOUND_COMPARISON ||
+		    b.GetExpressionClass() != ExpressionClass::BOUND_COMPARISON) {
+			return false;
+		}
+		auto &left = a.Cast<BoundComparisonExpression>();
+		auto &right = b.Cast<BoundComparisonExpression>();
