+void PerfectAggregateHashTable::FusedUpdate(DataChunk &payload, idx_t count) {
+	// FusedUpdateLoop relies on these numeric values
+	static_assert(uint8_t(FusedAggregateKind::COUNT_STAR) == 0 && uint8_t(FusedAggregateKind::SUM_INT32) == 1 &&
+	                  uint8_t(FusedAggregateKind::SUM_INT64) == 2 && uint8_t(FusedAggregateKind::AVG_INT32) == 3 &&
+	                  uint8_t(FusedAggregateKind::AVG_INT64) == 4,
+	              "unexpected fused aggregate kind values");
+	const idx_t aggr_count = fused_aggregates.size();
+	unsafe_vector<UnifiedVectorFormat> formats(aggr_count);
+	unsafe_vector<FusedInput> inputs(aggr_count);
+	unsafe_vector<idx_t> offsets(aggr_count);
+	unsafe_vector<uint8_t> kinds(aggr_count);
+	bool has_nulls = false;
+	for (idx_t k = 0; k < aggr_count; k++) {
+		auto &fused = fused_aggregates[k];
+		offsets[k] = fused.state_offset;
+		kinds[k] = static_cast<uint8_t>(fused.kind);
+		if (fused.kind == FusedAggregateKind::COUNT_STAR) {
+			inputs[k] = {nullptr, nullptr, nullptr};
+			continue;
+		}
+		auto &format = formats[k];
