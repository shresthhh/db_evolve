+//! Detects runs of adjacent rows with identical (fixed-width) group keys
+//! Two rows are considered identical only if, for every column, both are NULL or both are valid with identical bytes
+//! Returns the number of runs (with the first row of every run in "heads" and the run of every row in "run_ids"),
+//! or an invalid index if the keys are not fixed-width or the input is not clustered enough to benefit
+static optional_idx FindGroupRuns(DataChunk &groups, SelectionVector &heads, sel_t run_ids[]) {
+	static constexpr idx_t MAX_GROUP_COLUMNS = 8;
+	const auto count = groups.size();
+	const auto column_count = groups.ColumnCount();
+	if (count < 2 || column_count == 0 || column_count > MAX_GROUP_COLUMNS) {
+		return optional_idx();
+	}
+	UnifiedVectorFormat formats[MAX_GROUP_COLUMNS];
+	idx_t widths[MAX_GROUP_COLUMNS];
+	for (idx_t col_idx = 0; col_idx < column_count; col_idx++) {
+		auto &col = groups.data[col_idx];
+		const auto physical_type = col.GetType().InternalType();
+		if (!TypeIsConstantSize(physical_type)) {
+			return optional_idx();
+		}
+		widths[col_idx] = GetTypeIdSize(physical_type);
+		col.ToUnifiedFormat(count, formats[col_idx]);
+	}
+
+	const idx_t max_heads = count / 2;
+	idx_t head_count = 0;
+	heads.set_index(head_count++, 0);
+	run_ids[0] = 0;
+	for (idx_t i = 1; i < count; i++) {
+		bool equal = true;
+		for (idx_t col_idx = 0; col_idx < column_count && equal; col_idx++) {
+			auto &format = formats[col_idx];
+			const auto prev_idx = format.sel->get_index(i - 1);
+			const auto cur_idx = format.sel->get_index(i);
+			if (prev_idx == cur_idx) {
+				continue;
+			}
+			const auto prev_valid = format.validity.RowIsValid(prev_idx);
+			const auto cur_valid = format.validity.RowIsValid(cur_idx);
+			if (prev_valid != cur_valid) {
+				equal = false;
+			} else if (cur_valid) {
+				const auto width = widths[col_idx];
+				equal = memcmp(format.data + prev_idx * width, format.data + cur_idx * width, width) == 0;
+			}
+		}
+		if (!equal) {
+			if (head_count >= max_heads) {
+				// not clustered enough - use the regular path
+				return optional_idx();
+			}
+			heads.set_index(head_count++, i);
+		}
+		run_ids[i] = UnsafeNumericCast<sel_t>(head_count - 1);
+	}
+	return head_count;
+}
