+	for (idx_t i = 0; i < conjuncts.size(); i++) {
+		if (i == subquery_conjunct.GetIndex()) {
+			subquery_expr = std::move(*conjuncts[i]);
+		} else {
+			filter->expressions.push_back(std::move(*conjuncts[i]));
+		}
+	}
+	if (!filter->expressions.empty()) {
+		filter->AddChild(std::move(root));
+		root = std::move(filter);
+	}
+	auto window = make_uniq<LogicalWindow>(window_index);
+	window->expressions.push_back(std::move(window_expr));
+	window->AddChild(std::move(root));
+	root = std::move(window);
+	condition = std::move(subquery_expr);
+	return true;
+}
